  <sharedSelectionEntries>
    <selectionEntry id="b072e7ca-1bc2-52c0-ace4-11d4fe362b11" name="Shield Host &amp; Army Rules" publicationId="9f7f6f69-93b0-537e-856e-d41494d27fcf" page="2" hidden="false" collective="false" import="true" type="upgrade">
      <constraints>
        <constraint id="3dc1d6b4-6b41-57a2-8217-d2e320693845" field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="min"/>
        <constraint id="3af94fdf-2a0d-5d03-9ad5-be2a99fb650e" field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max"/>
      </constraints>
      <rules>
        <rule id="0d33b4de-4cf4-51a5-850a-b6f01fb16811" name="Agents of the Emperor" hidden="false">
          <description>May purchase 0-1 Advisors per Troop Slot purchased instead of 0-3.</description>
        </rule>
        <rule id="c54a2049-5065-5f5b-9f37-850a0142749e" name="Advanced Tactical Squads" hidden="false">
          <description>May split down to 1 model per unit or merge back during Command Phase; ICs may join 1-on-1.</description>
        </rule>
        <rule id="8a8f5df1-daec-5913-9b34-be5b7cc40077" name="Aegis of the Emperor" hidden="false">
          <description>This model has a 5+ Invulnerability Save.</description>
        </rule>
        <rule id="53cd4663-7a21-52eb-b3aa-ad939e89cbd8" name="Armour of Contempt" hidden="false">
          <description>Sv improves by 1 (to max 2+) against AP- attacks.</description>
        </rule>
        <rule id="5d971a93-d3cb-518e-abdc-a57f4f87097e" name="Binding Oaths" hidden="false">
          <description>This model has a 5+ Feel No Pain.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup id="b560e925-59e8-553d-95d6-5f93962b64e6" name="Select Shield Host" hidden="false" collective="false" import="true" defaultSelectionEntryId="5ee579b7-cd93-58a4-aa93-1fe2e790851b">
          <constraints>
            <constraint id="9522bf14-98f3-5742-b7cf-ff0880491729" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="min"/>
            <constraint id="27e5bd46-fb96-5c7b-916d-c514d7072e15" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
          </constraints>
          <selectionEntries>
            <selectionEntry id="5ee579b7-cd93-58a4-aa93-1fe2e790851b" name="Average Shield Host" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="fe04e4ff-45df-5d6a-a6c9-b3d43ecdd0b9" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="8a86c2a3-2eaf-5bed-a364-ed16f3fd2537" name="Shield Host: Average Shield Host" hidden="false">
                  <description>• For the Emperor!: All Infantry and Monstrous Infantry gain Furious Charge.
• Purge the Heretic: All Infantry and Monstrous Infantry may reroll failed Charge rolls.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="9511107a-8372-5545-bf71-35fed0fdd25d" name="Aquilon Shield" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="5e5cd217-22e1-52d5-967f-b119fe9f1f52" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="c47a69eb-74a9-5c32-a2ff-a61f71474667" name="Shield Host: Aquilon Shield" hidden="false">
                  <description>Defenders of the Emperor: All Infantry and Monstrous Infantry gain Bodyguard.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="84e0cd4d-e830-5857-9310-b8933ec35e9d" name="Dread Host" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="b591e41d-85a9-5239-a9ec-efd13e919212" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="d3af4d30-3dfc-588b-8457-c40e1de03caa" name="Shield Host: Dread Host" hidden="false">
                  <description>From Golden Light: All Infantry and Monstrous Infantry gain Deepstrike (or reroll Scatter Dice if already Deepstrike).</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="7cb77e7b-a15d-5757-931e-0129844358be" name="Emissaries Imperatus" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="d6da34bd-e498-546e-966f-548490025111" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="677f52a7-b762-5d8c-8ecf-8e1cd9bba3d5" name="Shield Host: Emissaries Imperatus" hidden="false">
                  <description>Operatives: All Infantry and Monstrous Infantry gain Stealth.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="079c5378-5676-5c21-9c0f-d532c3ea0110" name="Emperor's Chosen" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="931b7b6b-1fea-5597-bcf8-a7dacde8f1c5" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="1e140929-db21-5b41-98e0-4e077695ae30" name="Shield Host: Emperor's Chosen" hidden="false">
                  <description>Mental Fortitude: All Infantry and Monstrous Infantry models gain Stubborn.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="31a3ca2d-88d2-5367-b7c1-4dc369fcac2d" name="Shadowkeepers" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="7c81f7be-db6a-506f-a4fb-68e5d16b68b6" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="f303d36d-7612-5a6d-b204-6ead1187413f" name="Shield Host: Shadowkeepers" hidden="false">
                  <description>Stalking the Quarry: All Infantry and Monstrous Infantry models gain Infiltrate.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="170d1096-2fc1-582a-bf91-13dc7277101a" name="Solar Watch" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="33227a4d-c0b4-5065-9b7d-10ab86a7f42e" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="97ab658a-b58a-563d-8861-2daf44a32a8e" name="Shield Host: Solar Watch" hidden="false">
                  <description>• Strike and Fade: All Infantry and Monstrous Infantry gain Hit and Run.
• Harrying Tactics: All Infantry and Monstrous Infantry gain Fleet.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
