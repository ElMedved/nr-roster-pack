      <rules>
        <rule id="92f71eb6-210a-51c3-95da-d045f35bb8da" name="Psychic Null" hidden="false">
          <description>12” Aura, target Psyker suffers Perils of the Warp on all Doubles as if they were both 1’s. This does not modify the To Cast value or prevent Casting in any way. This Aura is cast before the Cast Rolls happen.</description>
        </rule>
        <rule id="2e8ec3aa-bea9-562c-985c-b362936f6c27" name="Will of the Emperor" hidden="false">
          <description>This unit may attempt to Deny the Witch at Psychic Mastery level 0.</description>
        </rule>
      </rules>
