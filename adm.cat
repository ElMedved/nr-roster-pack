      <rules>
        <rule id="0ee8297b-4ddc-5ea0-a5cc-718172b668a9" name="Repair" hidden="false">
          <description>Target model in base contact Repairs 1 Wound. Roll a d6, on a 5+ restore service for one Weapon Disabled, Crew Shaken, Immobilized, or Weapon Destroyed.</description>
        </rule>
      </rules>
