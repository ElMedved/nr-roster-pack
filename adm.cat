  <sharedSelectionEntries>
    <selectionEntry id="b26ff1c8-116a-5e84-b89a-b7eb835112c0" name="Forge World &amp; Army Rules" publicationId="fde014fb-0913-5977-834f-2186f01b4da8" page="2" hidden="false" collective="false" import="true" type="upgrade">
      <constraints>
        <constraint id="7156923d-fab5-5665-ba54-b13c9c1778b5" field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="min"/>
        <constraint id="90659fbe-2e1b-5313-b0e8-3f9aedcaacf0" field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max"/>
      </constraints>
      <rules>
        <rule id="c3029acf-b263-5c1b-80b9-3bf614323f47" name="Master of Machines" hidden="false">
          <description>Target model in base contact Repairs d3 Wounds; on 5+ restores one disabled/destroyed weapon or immobilized/shaken result.</description>
        </rule>
        <rule id="a7d39f1b-860f-5a7c-90f5-64a3cf0ab359" name="Servo Arm" hidden="false">
          <description>Adds +1 to Repair die rolls.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup id="3854b0ca-f70f-5554-aeee-daaba98c228f" name="Select Forge World" hidden="false" collective="false" import="true" defaultSelectionEntryId="eb024e2b-f422-5823-a08c-c35a6f7d3373">
          <constraints>
            <constraint id="f3dc2856-d3bd-5e88-aaef-e8207099122e" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="min"/>
            <constraint id="4172e565-78b9-5e56-a470-387f35c391cd" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
          </constraints>
          <selectionEntries>
            <selectionEntry id="eb024e2b-f422-5823-a08c-c35a6f7d3373" name="Forge World (Standard)" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="a57b5aa0-4b44-5335-867d-06939a6a0603" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="ba09ce2b-ddc2-5f0e-b65c-cb1e7fccd9c8" name="Forge World: Forge World (Standard)" hidden="false">
                  <description>All models in your army are fielded exactly as presented in this rulebook.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="a44e516e-66c8-52ad-9f66-e5f419083d96" name="Agripinaa" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="282b3692-06c8-5105-ae82-db9630e592ae" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="29233aba-0291-54ce-a642-6662b933ed7e" name="Forge World: Agripinaa" hidden="false">
                  <description>• On the Defensive: Suffer double Auto Wounds from losing Combat Resolution in enemy Deployment Zone.
• Stalwart Defenders: Suffer no Auto Wounds from Combat Resolution while in your Deployment Zone.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="5afa0986-9536-53fe-ab71-d8641f90fcbf" name="Graia" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="6877e0e8-3a48-56aa-a8e9-508a0a0b9a8c" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="7ed14048-8bd7-578b-a587-893b97083d02" name="Forge World: Graia" hidden="false">
                  <description>• Lost World: Models count as half for Contesting Objective Markers.
• Rapid Deployment: Redeploy 1 unit per 1000 points after Infiltrators and Scouts.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="28d329b1-455b-5004-97e0-cc68e47a3dd7" name="Lucius" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="b88b8904-4404-5006-a65c-3ca7b476d132" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="313e4ffa-8dfd-55cb-8928-484346d42def" name="Forge World: Lucius" hidden="false">
                  <description>• Constant Acquisition: Cannot Claim or Contest Objective Markers within your Deployment Zone.
• Rare Materials: Reroll 1s for Armour Saves.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="f4618f15-7b46-5720-9144-e85cd946a8f1" name="Mars" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="1f5bd710-f31d-5698-bd2b-a672db4e01ec" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="8117098e-81a3-529d-b72f-87bd58e8f5c1" name="Forge World: Mars" hidden="false">
                  <description>• Founding of the Adeptus Mechanicus: All models gain Stubborn.
• Vanity: Characters/ICs must Issue and Accept Challenges and suffer -1 To Hit in Melee outside Challenges.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="99b84698-f1ec-57d0-824e-254fdacb1bf5" name="Metalica" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="5a1d461d-ac9e-590a-9eb9-6957e8a6ad8a" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="7e9ef536-240e-5935-9e1f-172154200a62" name="Forge World: Metalica" hidden="false">
                  <description>• Blaring Weapons: Unmodified 6s To Wound/Penetrate inflict Pinning if fired from within your Deployment Zone.
• Blessed Sterility: May only Claim or Contest Objective Markers in your Deployment Zone.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="08b61843-6f5b-5b96-88c8-f3ac8ce94385" name="Ryza" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="07733b7a-fc4b-5259-b09e-63b8d2864c12" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="549effd8-d9c3-5a2d-9d8b-d4ef70292d32" name="Forge World: Ryza" hidden="false">
                  <description>• Close Quarter Experts: All models gain Furious Charge (or Shock Assault if already Furious Charge).
• Ruined Home World: All models suffer Ld-1.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="59a4f076-120a-57e4-9193-3ebe23b89c2a" name="Stygies VIII" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="59c97ee6-e478-57ce-aeea-66fafcaf89e1" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="7ecb39ed-1113-5b6d-b941-8231097f9a60" name="Forge World: Stygies VIII" hidden="false">
                  <description>• Forbidden Knowledge: Each unit may reroll 1 die per phase; when completing an Objective roll d6, on a 1 score -1 VP.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
    </selectionEntry>
