          <characteristics>
            <characteristic name="Range" typeId="9c7850b8-81dd-53f9-80e1-1a39147745dd">Bomb</characteristic>
            <characteristic name="S" typeId="1ec1daae-c783-53b1-87a9-2dc4176bdfea">9</characteristic>
            <characteristic name="AP" typeId="37819752-fbc6-5464-ad45-17490825eae1">1+</characteristic>
            <characteristic name="Rules" typeId="989bc79d-9e4b-528b-b966-eff3ce994cc7">Heavy 2, 5” Blast, Does Not Hit Self, Monsterbane, Hull, Primary</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="8999df1e-31d3-552a-a16b-12e2bbcc5fa3" name="Create Panic" hidden="false">
          <description>This model displaces all models when it moves, place them up to 1” Away. Immobile units prevent this model from moving there.</description>
        </rule>
        <rule id="c30e9895-9862-51a7-bc7f-c88aa1e11d24" name="Nuclear Meltdown" hidden="false">
          <description>This model explodes on a 4+ with S Destroyer AP1+ in a 3d6” Radius.</description>
        </rule>
        <rule id="a0f43d38-1d6f-5054-b4f8-cf0f1f9fbda4" name="Titanic God Engine" hidden="false">
          <description>This model may ignore all Non- Titanic models and Terrain for the purposes of Moving, Advancing, Falling Back, and Charging.</description>
        </rule>
        <rule id="fc7df5f9-fa51-50cc-8ddb-33a2518e1da9" name="The Hour is Nigh" hidden="false">
          <description>When the weapon is fired, place a marker on field at a valid target. In your next Command Phase, the missile strikes! Scatter like normal, following the 15” Blast radius rules.</description>
        </rule>
        <rule id="c3d5307e-66f5-51d1-ad29-b2a48b8bb2d1" name="T Minus 5" hidden="false">
          <description>The weapon may not be fired Turn 1. The weapon cannot be destroyed or Disabled. If the weapon is marked on the field and the carrier is destroyed, the Deathstrike Missile still hits in your Command Phase.</description>
        </rule>
      </rules>
