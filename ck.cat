  <sharedSelectionEntries>
    <selectionEntry id="9f6e8e69-8bea-5f85-b498-e06b4ca5a94d" name="Lance &amp; Army Rules" publicationId="79983b6a-839b-5dda-abf3-e1c6f2e11f3f" page="2" hidden="false" collective="false" import="true" type="upgrade">
      <constraints>
        <constraint id="665ccdab-6ba5-5907-acf6-ec78a027754f" field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="min"/>
        <constraint id="1032b829-165f-5d1e-b815-ca924b40e8a0" field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max"/>
      </constraints>
      <rules>
        <rule id="f028eeb9-579c-5632-8809-d40ac3c1a735" name="Imperial God Engine" hidden="false">
          <description>Ignores Swarms, Infantry, and Monstrous Infantry for Moving.</description>
        </rule>
        <rule id="d8411481-9e02-56ae-8077-658307274de5" name="Rotate Ion Shields" hidden="false">
          <description>5+ Invulnerability Save against either Ranged OR Melee attacks.</description>
        </rule>
        <rule id="58294a24-4c72-577c-941f-3f6ef99017e6" name="Corrupted Protector / Mercenary" hidden="false">
          <description>May be fielded in any Chaos army as a Lord of War or Heavy Support slot.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup id="c17c648e-240a-5e2f-977a-0f38e1812134" name="Select Lance" hidden="false" collective="false" import="true" defaultSelectionEntryId="f88349f8-8b2d-5214-96ad-c1d0f2f3f5df">
          <constraints>
            <constraint id="613b0adf-e582-570f-b912-c1315537543b" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="min"/>
            <constraint id="cc50ec1b-aa7a-5611-9c03-b6806bf275b4" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
          </constraints>
          <selectionEntries>
            <selectionEntry id="f88349f8-8b2d-5214-96ad-c1d0f2f3f5df" name="Corrupted Lance" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="50082b49-5384-55fb-a875-a8aa8609249e" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="ad00a503-c5fa-5506-865b-44ba5aef5339" name="Lance: Corrupted Lance" hidden="false">
                  <description>Surprising Resilience: All models in your army gain Ld+2.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="b63504fd-c594-5d86-a461-b4152b0ea5ae" name="Harbingers of Dread" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="e98945b7-5ab3-540c-96ef-a32e94ef9841" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="f4a53531-732b-5670-a38d-696556db0c75" name="Lance: Harbingers of Dread" hidden="false">
                  <description>Deathly Terror: All models in your army gain '6" Aura, target unit suffers Ld-1.'</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="097e72b9-57f0-5c84-8e64-da0cfa3309f7" name="Helhunt Lance" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="311df332-ce54-580c-acd4-be116830cf19" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="5c8cca04-da78-50f1-afd8-0182aaf11ed3" name="Lance: Helhunt Lance" hidden="false">
                  <description>Masters of the Pack: War Dogs and Armiger Moiraxes can cast Auras another model cast onto them.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="ff271c69-a9be-53e9-8711-cf8d2fda427d" name="Houndpack Lance" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="c8fdb23c-36ae-5068-9417-5b764b9b2775" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="bc9dfd03-2e48-5b32-98f9-c6eb9a779ec3" name="Lance: Houndpack Lance" hidden="false">
                  <description>Marked Prey: Nominate an enemy unit each Command Phase; roll 1 extra die and drop the lowest when Charging it.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="00e6d2ff-be3d-5d2e-93d6-9397ffefb872" name="Iconoclast Fiefdom" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="311654ee-54aa-59aa-ae13-d90369046202" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="c5178fdb-3592-5dc7-ae9d-d10dab905105" name="Lance: Iconoclast Fiefdom" hidden="false">
                  <description>Dreaded Masters: Chaos Knights gain the Chaos Warband abilities of your other Chaos models.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="4fe57802-ad40-5c24-b168-92fd196bde95" name="Infernal Lance" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="cc237d1a-985a-5f6c-8447-bc623ff2367e" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="04adfca5-9af0-51a2-a14d-9f3987ec2d4c" name="Lance: Infernal Lance" hidden="false">
                  <description>Warp Taint: Once per Round, roll d6; on 5+ restore service from a Penetration Result.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="5610440f-132a-5110-bae0-85c7b0704880" name="Lords of Dread" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="460e10ef-8e04-541c-ac19-99cfce329e02" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="e0581d33-0d24-5a4b-ad58-1728d3da00c1" name="Lance: Lords of Dread" hidden="false">
                  <description>Tyrannical Court: Cannot Charge units in Melee with another friendly model; reroll 1s To Hit when outnumbered in Melee.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="6fa10f4b-d671-536b-84ea-4f100961958a" name="Traitoris Lance" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="e43c75d5-f7b4-5490-b7e0-6f728d6b4291" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="f45d16d8-5d95-57b4-bce0-5e6b56d54a50" name="Lance: Traitoris Lance" hidden="false">
                  <description>Paragons of Terror: Enemy models must pass a Ld Test to Declare Charges against your models.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
    </selectionEntry>
