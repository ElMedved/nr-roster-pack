          <description>6” Aura, this model and target unit with the Mark of Slaanesh may reroll failed Charge rolls and gains Hit and Run.</description>
        </rule>
        <rule id="d8b7f8d9-8fbe-52b9-9d15-781adaa3947e" name="The Eternal Dance" hidden="false">
          <description>6” Aura, this model and target unit with the Mark of Slaanesh may reroll 1s To Hit.</description>
        </rule>
