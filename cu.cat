          <description>Unit keyword / faction rule.</description>
        </rule>
        <rule id="3651d7d1-fe15-5111-b41a-a7565293d03b" name="model was Psychic Mastery" hidden="false">
          <description>Unit keyword / faction rule.</description>
        </rule>
        <rule id="e497e888-bc9b-5293-b5e9-9e622708a770" name="Level 4 instead of 1." hidden="false">
          <description>Unit keyword / faction rule.</description>
        </rule>
        <rule id="8587ff46-22db-5a5f-9baa-5833754e1b36" name="Infectious Rage" hidden="false">
          <description>6” Aura, this model and target unit gain A+1.</description>
        </rule>
        <rule id="f06904cc-8136-543b-ad33-b68b141f5b50" name="Lord of Chaos" hidden="false">
          <description>6” Aura, this model and target unit may reroll 1s To Hit.</description>
        </rule>
        <rule id="7288fa93-8259-59b8-a552-eb32409f812c" name="Righteous Slaughter" hidden="false">
          <description>6” Aura, target unit does not fall back after losing Combat Resolution and failing its modified Ld test.</description>
        </rule>
        <rule id="03ec18f9-35a4-5541-934e-c6bf2eb87066" name="Veil Torn Asunder" hidden="false">
          <description>The first time this model is slain, do not remove it from the battlefield. In your next Command Phase, roll a d6. On a 3+ Angron stands back up with d3 Wounds.</description>
        </rule>
      </rules>
