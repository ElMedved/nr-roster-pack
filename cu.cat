          <selectionEntries>
            <selectionEntry id="7f9b6f4a-c5f3-5f0f-a6d8-75c2d6075951" name="Bloodgorge" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="20a3aecf-2f23-53d0-b1d8-7dc7f41eb4b8" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <profiles>
                <profile id="0e05edff-1c8d-5b86-8a09-e87630e72b88" name="Bloodgorge" hidden="false" typeId="a3471e59-a0ee-5ebc-b029-a86d34fad447" typeName="Psychic Power">
                  <characteristics>
                    <characteristic name="Cast" typeId="97e70b1c-dbfb-5c51-961a-c1ddce655c1f">Sacrifice 3</characteristic>
                    <characteristic name="Range" typeId="bd6bc23e-e24d-5c7e-855c-409059c1eee5">User</characteristic>
                    <characteristic name="S" typeId="b8615668-9262-5080-ae30-cf051dbfb91d">-</characteristic>
                    <characteristic name="AP" typeId="a70a61f0-0f3f-5124-abb1-4b5b604b58cb">-</characteristic>
                    <characteristic name="Rules" typeId="6b2a8df2-cb0b-5493-974f-d27207ce83fd">This model gains A+3, but each roll of a 1 To Hit inflicts 1 Mortal Wound. Lasts until your next Psychic Phase.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="pts" typeId="points" value="5"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="e3d90b53-8778-5cf0-be3f-e3474edaa0b7" name="Warp Gateway" hidden="false" collective="false" import="true" type="upgrade">
