      <rules>
        <rule id="e1a08e2c-55ad-582e-94d1-09a616c91a59" name="Lord of Chaos" hidden="false">
          <description>6’ Aura, this model and target unit may reroll 1s To Hit.</description>
        </rule>
        <rule id="d7844cb9-3e22-5ecc-aa34-2d095ccfb109" name="Herald of Abaddon" hidden="false">
          <description>6” Aura, target unit must take a Fear Test. Units engaged in Melee with this model cannot Fall Back or use Hit and Run.</description>
        </rule>
