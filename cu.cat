      <rules>
        <rule id="1107cfef-9ff5-59b3-8a74-e3a70ae0fa9b" name="Aural Barrage" hidden="false">
          <description>Charges against this model or its unit suffer -2 to the distance.</description>
        </rule>
        <rule id="c5d376ce-0137-5dae-9ad8-dd3efac97003" name="Lord of Chaos" hidden="false">
          <description>6” Aura, this model and target unit may reroll 1s To Hit.</description>
        </rule>
        <rule id="ecb34209-6d83-5bc2-813c-29e0f2583e73" name="Obsessive Annunciation" hidden="false">
          <description>6” Aura, this model and target unit’s weapons of the following (Screamer Pistol, Blast Master, Doom Siren, Sonic Blaster, includes Heavy) gain Pinning.</description>
        </rule>
      </rules>
