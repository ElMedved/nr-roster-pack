      <rules>
        <rule id="74c08049-fda6-5af0-971d-ec9ba1018f40" name="Regeneration" hidden="false">
          <description>This model Heals 1 Wound in each of your Command Phases.</description>
        </rule>
        <rule id="e9fac2d5-2204-5475-ad26-10fb38a316e9" name="Unstable Energies" hidden="false">
          <description>Double the range of Warp Vortex Abilities when this model is at W7 or less.</description>
        </rule>
        <rule id="65198209-576b-562f-ae6f-d0d06ef9cf40" name="Vortex" hidden="false">
          <description>In each of your Shooting Phases, roll a d6 to see which Ability or Weapon activates.</description>
        </rule>
        <rule id="62b81b8b-7c82-57da-8522-318ee321d59f" name="Warp Implosion" hidden="false">
          <description>This models explodes on a 4+ in a d6” radius that inflicts d3 Mortal Wounds to all within range.</description>
        </rule>
      </rules>
