      <rules>
        <rule id="60a3ea4d-32f0-57dc-8752-f92afe991c31" name="Chariot" hidden="false">
          <description>This model inflicts d6 Auto Hits at S5 AP3+ on the phase is counts as Charging before any models fight.</description>
        </rule>
        <rule id="32b407bd-6d8a-512e-bc42-32f4c6dcba67" name="Gorefeast" hidden="false">
          <description>For each model slain by Blade of Blood, this model Heals 1 Wound. This is an exception to the normal Heal rules, but this model cannot exceed its starting Wounds.</description>
        </rule>
        <rule id="a1e1dad7-79cf-5480-9737-5b21952bfa87" name="Locus of Khorne" hidden="false">
          <description>6” Aura, this model and target unit with the Mark of Khorne gain S+1.</description>
        </rule>
      </rules>
