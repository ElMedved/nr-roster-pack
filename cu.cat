      <rules>
        <rule id="8cace032-5260-5688-a744-b8021569caef" name="Gorefeast" hidden="false">
          <description>For each model slain by Blade of Blood, this model Heals 1 Wound. This is an exception to the normal Heal rules, but this model cannot exceed its starting Wounds.</description>
        </rule>
        <rule id="746bbd0b-26e4-5ef1-81db-7d7a736eaac7" name="Locus of Khorne" hidden="false">
          <description>6” Aura, this model and target unit with the Mark of Khorne gain S+1.</description>
        </rule>
      </rules>
