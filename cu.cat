      <rules>
        <rule id="cf92a029-f001-5d65-a6c4-70b0bf4da956" name="Warpflame Strike" hidden="false">
          <description>6” Aura, when this unit arrives from Deepstrike, target unit within 6” suffers BS+1 (1 worse) until your next Command Phase. Cast as a unit.</description>
        </rule>
      </rules>
