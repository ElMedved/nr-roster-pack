      <rules>
        <rule id="78be6eaf-37db-57a9-864e-1957b725ed48" name="Continuous Change" hidden="false">
          <description>This model always fails its Invulnerability Saves.</description>
        </rule>
        <rule id="60d78e34-53fb-5040-8f3c-492b7172fa9d" name="Splitting Change" hidden="false">
          <description>When this model is slain, spawn 2 Blue Horrors and join them to a Blue Horror unit within 6” of this model’s unit. If there is not a Blue Horror unit within 6”, create one instead.</description>
        </rule>
        <rule id="abefad3c-1b9c-5c55-8d0d-1dddc2c4eeee" name="Flickering Change" hidden="false">
          <description>When this model is slain, spawn 2 Brimstone Horror and join them to a Brimstone Horror unit within 6” of this model’s unit. If there is not a Brimstone Horror unit within 6”, create one instead.</description>
        </rule>
        <rule id="aee060f5-0713-5943-ab80-0c4bb47e850b" name="Hateful Spite" hidden="false">
          <description>This model cannot Claim or Contest Objective Markers.</description>
        </rule>
      </rules>
