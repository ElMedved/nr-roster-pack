      <rules>
        <rule id="1e94b6c9-bac0-587e-bb27-722fa76653ed" name="Faultless" hidden="false">
          <description>Unit keyword / faction rule.</description>
        </rule>
        <rule id="f7508c8f-b205-53cc-b145-f10cd331a027" name="Commorite Stimm Rack" hidden="false">
          <description>This model gains I+5, A+2 until the end of the Round. One Use Only.</description>
        </rule>
        <rule id="4e6d51e1-ce85-5569-8e16-04d20a3c40cc" name="Deranged" hidden="false">
          <description>At the end of each Round, if this model did not cause any Wounds during the Round it suffers 1 Mortal Wound.</description>
        </rule>
        <rule id="f090fac3-0853-5dbd-8f2f-215e9670e51a" name="Duelist" hidden="false">
          <description>This model may choose the target of its Challenge. The target may not deny the Challenge.</description>
        </rule>
        <rule id="fa4c5e60-a0b3-5cf5-b20a-266be2875c3c" name="Duelist Pride" hidden="false">
          <description>This model may reroll all failed To Hit and To Wound rolls when in a Challenge.</description>
        </rule>
        <rule id="7594325a-c258-5a1c-8efc-14d50cd7b906" name="Lord of Chaos" hidden="false">
          <description>6” Aura, this model and target unit may reroll 1s To Hit.</description>
        </rule>
        <rule id="cdab9dff-a655-5dc4-8fdd-3b66d6848edc" name="Possession" hidden="false">
          <description>If a model is responsible for slaying Lucius, at the end of the battle it must take a Ld test -3. If it fails it is slain.</description>
        </rule>
      </rules>
