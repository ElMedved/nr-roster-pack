        <rule id="54583f46-a3ed-5a95-8224-731c3fb65571" name="Chariot Slashing Attack" hidden="false">
          <description>In the Movement Phase, if this model Moves over one or more enemy units that are not Engaged in Melee, inflict 2d3</description>
        </rule>
        <rule id="d41b8927-7f0c-5c1a-be13-289da3418b3c" name="S4 AP" hidden="false">
          <description>Auto Hits on one of those units for each Screamer in this unit.</description>
