      <rules>
        <rule id="3ac4059e-ee9c-53af-baee-9c11d257bc85" name="Thousand Sons" hidden="false">
          <description>Unit keyword / faction rule.</description>
        </rule>
        <rule id="dbe6bf0a-a50b-5077-bddc-ea1903f4adb4" name="Arch Sorcerer" hidden="false">
          <description>This model May Deny the Witch twice per Turn and gains +1 To Cast and to Deny the Witch.</description>
        </rule>
        <rule id="d2a34389-5ce9-5b99-a55c-9f687493dc89" name="Crown of the Crimson King" hidden="false">
          <description>This model may reroll failed Psychic Tests and does not suffer from Perils of the Warp.</description>
        </rule>
        <rule id="ecd9eb36-3bd9-53fc-ab66-62996eaaeb6b" name="Lord of the Planet of Sorcerers" hidden="false">
          <description>6” Aura, this model and target unit may reroll failed To Wound rolls.</description>
        </rule>
        <rule id="0de539d0-9a4c-5241-b545-99a547ef7458" name="Primarch" hidden="false">
          <description>6” Aura, this model and target unit may reroll 1s To Hit.</description>
        </rule>
        <rule id="2570f3ac-e6f8-5877-a241-77e49984054a" name="Unearthly Power" hidden="false">
          <description>This model may Cast each spell is knows each of your Psychic Phases despite its Psychic Mastery Level.</description>
        </rule>
      </rules>
