        <rule id="82faf951-7f7a-57ba-9b35-11e83a9e4e8d" name="Master of the Dead" hidden="false">
          <description>Each time Necrosius Casts a Spell successfully, add +d3 Pox Walkers to a Pox Walker unit within 6”.</description>
        </rule>
        <rule id="d84e9fec-478e-5f0d-930b-703f78cc4040" name="Resentful" hidden="false">
          <description>This model may not be in the same unit as another Unique model.</description>
        </rule>
