      <rules>
        <rule id="bb6238a7-8157-5524-8ce5-57ba52a26209" name="Consumes All" hidden="false">
          <description>Each weapon targets the closest unit, friend or foe even if it has to hit itself with Templates. If no unit is in range and the weapon arc it will target the closest terrain feature instead.</description>
        </rule>
        <rule id="9dcb4c45-c1c1-51c7-a130-baf07181e310" name="Doomsday Reactor" hidden="false">
