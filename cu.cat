        <profile id="459417cc-e50b-5c8c-8d39-94f8e84cc3b9" name="Tome of Chaos" hidden="false" typeId="ac5ce483-3b55-59be-afc5-de14cfb350f6" typeName="Wargear">
          <characteristics>
            <characteristic name="Description" typeId="1c2f4080-02ec-5486-826a-4d2299dd0bb1">A friendly spell caster within 6” may use this model’s spells in addition to their own. They still can only cast their normal amount of Casts for their Psychic Mastery Level like normal. Alternatively, a Dark Apostle may use an additional H this model has purchased.</characteristic>
          </characteristics>
        </profile>
        <profile id="e79f22d7-0748-5342-9bb5-b9e9973735df" name="Unit Composition" hidden="false" typeId="35b65644-1892-5b82-90c0-20981913471e" typeName="Ability">
          <characteristics>
