        <rule id="8abd0490-1072-5237-b464-b34df4187083" name="Fortress Breaker" hidden="false">
          <description>12” True Aura, when an affected model destroys a Terrain piece and the enemy within has to Force Disembark, they suffer 1 Autowound each instead of taking Dangerous Terrain Tests like normal.</description>
        </rule>
        <rule id="d3c4da45-5a14-5280-9852-d31f614f2acb" name="Repair" hidden="false">
          <description>Target model in base contact Repairs 1 Wound. Roll a d6, on a 5+ restore service for one Weapon Disabled, Crew Shaken, Immobilized, or Weapon Destroyed.</description>
        </rule>
      </rules>
