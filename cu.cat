      <rules>
        <rule id="17b5b436-0f8e-51ee-982d-33a1a4b812f3" name="Devourer of Souls" hidden="false">
          <description>If this unit slew one or more enemy models last Turn, this unit Repairs 1 Wound.</description>
        </rule>
        <rule id="3709116a-f95b-5b54-915a-2a415cbc342f" name="Soulshredding Explosion" hidden="false">
          <description>This model explodes on a 4+ instead and inflicts d3 Mortal Wounds in a d6” Radius instead.</description>
        </rule>
      </rules>
