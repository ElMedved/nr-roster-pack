        <rule id="e55d16b7-b95d-5b72-afe5-ac4424190e2f" name="Lord of Chaos" hidden="false">
          <description>6” Aura, target unit may reroll 1s To Hit.</description>
        </rule>
        <rule id="6f8ae157-8b77-54b3-8243-72671699e18a" name="Regenerate" hidden="false">
          <description>This unit heals 1 Wound in each of your Command Phases, even if it already Healed this turn. This is an exception to the normal Heal rules.</description>
