                    <characteristic name="Cast" typeId="97e70b1c-dbfb-5c51-961a-c1ddce655c1f">Sacrifice 10</characteristic>
                    <characteristic name="Range" typeId="bd6bc23e-e24d-5c7e-855c-409059c1eee5">6</characteristic>
                    <characteristic name="S" typeId="b8615668-9262-5080-ae30-cf051dbfb91d">-</characteristic>
                    <characteristic name="AP" typeId="a70a61f0-0f3f-5124-abb1-4b5b604b58cb">-</characteristic>
                    <characteristic name="Rules" typeId="6b2a8df2-cb0b-5493-974f-d27207ce83fd">Summon 10 Bloodletters as if they had just arrived from Deepstrike, but they do not Scatter. This cannot be Cast on Turn 1.</characteristic>
