            <characteristic name="Ld" typeId="494a7951-7cd9-524d-bf22-444838fed165">10</characteristic>
            <characteristic name="Sv" typeId="3516322a-033e-5517-b8bd-1c7dfa38d6de">3+</characteristic>
          </characteristics>
        </profile>
        <profile id="16241a9f-7d70-57a9-a3d9-f59a9e204c45" name="Sigil of Corruption" hidden="false" typeId="ac5ce483-3b55-59be-afc5-de14cfb350f6" typeName="Wargear">
          <characteristics>
            <characteristic name="Description" typeId="1c2f4080-02ec-5486-826a-4d2299dd0bb1">This model has a 4+ Invulnerability Save.</characteristic>
          </characteristics>
        </profile>
        <profile id="b9a81048-7624-531e-abe4-0447887b24a6" name="Unit Composition" hidden="false" typeId="35b65644-1892-5b82-90c0-20981913471e" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="83d81002-a330-5968-9552-22dcb2ed8516">1 Abaddon</characteristic>
          </characteristics>
        </profile>
        <profile id="613fb8eb-4746-5632-8001-9996afa2cd33" name="Talon of Horus" hidden="false" typeId="0b840343-a9ff-5f16-b0df-b617cac2c0fa" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="9c7850b8-81dd-53f9-80e1-1a39147745dd">24 Or Melee</characteristic>
            <characteristic name="S" typeId="1ec1daae-c783-53b1-87a9-2dc4176bdfea">4 Or X2</characteristic>
            <characteristic name="AP" typeId="37819752-fbc6-5464-ad45-17490825eae1">5+ Or 1+</characteristic>
            <characteristic name="Rules" typeId="989bc79d-9e4b-528b-b966-eff3ce994cc7">Rapid Fire 2, Bolter Or Slow, Monsterbane</characteristic>
          </characteristics>
        </profile>
        <profile id="ca2547a5-6e8c-58c1-ab5c-877822c82cb2" name="Drach’nyen" hidden="false" typeId="0b840343-a9ff-5f16-b0df-b617cac2c0fa" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="9c7850b8-81dd-53f9-80e1-1a39147745dd">Melee</characteristic>
            <characteristic name="S" typeId="1ec1daae-c783-53b1-87a9-2dc4176bdfea">+2</characteristic>
            <characteristic name="AP" typeId="37819752-fbc6-5464-ad45-17490825eae1">1+</characteristic>
            <characteristic name="Rules" typeId="989bc79d-9e4b-528b-b966-eff3ce994cc7">Extra Attack d6, Daemonic Thirst</characteristic>
          </characteristics>
        </profile>
        <profile id="de3639c0-d588-5a36-a961-80b0a49e88db" name="Orbital Strike" hidden="false" typeId="0b840343-a9ff-5f16-b0df-b617cac2c0fa" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="9c7850b8-81dd-53f9-80e1-1a39147745dd">12-240</characteristic>
            <characteristic name="S" typeId="1ec1daae-c783-53b1-87a9-2dc4176bdfea">D/10 /8</characteristic>
            <characteristic name="AP" typeId="37819752-fbc6-5464-ad45-17490825eae1">1+/1+ /1+</characteristic>
            <characteristic name="Rules" typeId="989bc79d-9e4b-528b-b966-eff3ce994cc7">Heavy 1, 15” Blast, Destroyer, Ordnance, Monsterbane, Indirect Fire, Ignores Cover, The Hour is Nigh, T Minus 5, One Use Only</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="bcb0acaf-d6ba-5318-897c-c635282d564a" name="Black Legion" hidden="false">
          <description>Unit keyword / faction rule.</description>
        </rule>
        <rule id="49d8ec74-5b2d-5219-b77e-6c3ce98acced" name="Champion of Chaos" hidden="false">
          <description>This model does not require a Mark of Undivided to field in your army and is considered to be all Marks of Chaos for the purpose of Pure Blessings of Chaos.</description>
        </rule>
        <rule id="a5e73841-75ba-5737-bacd-253113c3d37a" name="Champion of Undivided" hidden="false">
          <description>12” True Aura, this model and all friendly units may reroll 1s To Hit.</description>
        </rule>
        <rule id="3da66f0f-f3bf-5db8-868b-9c44a0f06373" name="Mark of Chaos Ascended" hidden="false">
          <description>6” Aura, this model and target unit automatically pass Ld tests.</description>
        </rule>
        <rule id="5e605143-18d2-5930-ac27-ed1a3b89a9ef" name="The Hour is Nigh" hidden="false">
          <description>When the weapon is fired, place a marker on field at a valid target. In your next Command Phase, the barrage strikes! Scatter like normal, following the 15” Blast radius rules.</description>
        </rule>
        <rule id="94ed6047-f309-55bd-be3d-247c445bc82c" name="T Minus 5" hidden="false">
          <description>The weapon may not be fired Turn 1. If the weapon is marked on the field and the carrier is destroyed, the Orbital Strike still hits in your Command Phase.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="5b7dec1e-fdbc-5b06-8eb3-4e67d17f4303" name="Independent Character" hidden="false" targetId="daa374d1-a1d8-5baf-b6c0-d3e27bcc4297" type="rule"/>
        <infoLink id="b2c65359-f0f3-54c1-b0c0-74c7ec6fab59" name="Monstrous Infantry" hidden="false" targetId="5b51a336-4539-5dce-8716-887011d65a39" type="rule"/>
