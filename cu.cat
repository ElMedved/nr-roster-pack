        <profile id="5bfcf672-f9ee-5ff7-b7f5-ca97193d39ca" name="Staff of Cataclysm" hidden="false" typeId="0b840343-a9ff-5f16-b0df-b617cac2c0fa" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="9c7850b8-81dd-53f9-80e1-1a39147745dd">72 And Melee</characteristic>
            <characteristic name="S" typeId="1ec1daae-c783-53b1-87a9-2dc4176bdfea">9 And X2</characteristic>
            <characteristic name="AP" typeId="37819752-fbc6-5464-ad45-17490825eae1">3+ And 1+</characteristic>
            <characteristic name="Rules" typeId="989bc79d-9e4b-528b-b966-eff3ce994cc7">Heavy 1, Apocalypse Barrage And Slow, Monsterbane</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="ce2e1e1e-14e9-5a5c-873e-16bee39fd446" name="Dark Jealousy" hidden="false">
          <description>This model must target any Daemonic Lord of War Slots within 18” for Ranged Weapons, Charges, and Melee Attacks, even if it is friendly.</description>
        </rule>
        <rule id="be481530-ea87-5109-b925-0b42d4ae602c" name="Hatred" hidden="false">
          <description>This model may reroll all failed To Hit rolls.</description>
        </rule>
        <rule id="81ac04be-4c77-5bea-bd57-a770fe6b29a3" name="Manifestation of Tzeentch" hidden="false">
          <description>6” Aura, this model and target unit with Pure Blessing of Tzeentch ignores the first 2 Wounds they would suffer each Phase instead of 1.</description>
        </rule>
        <rule id="9aa73e76-beb0-5eb3-a4e8-8b1cf66bbabd" name="Render of the Veil" hidden="false">
          <description>Spawn 2d6 Purple Horrors and add them to a Purple Horror unit within 48” even if it exceeds its maximum number. If there are no Purple Horror units, create a new one instead of the same number.</description>
        </rule>
        <rule id="04ec0b45-85d7-5ec5-b95d-23e38ae3acc6" name="Spiteful Demise" hidden="false">
          <description>This model explodes on a 4+ at S8 AP2+ in a 2d6” Radius.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="7b481054-6087-550e-83a3-e471be5dc0f8" name="Independent Character" hidden="false" targetId="daa374d1-a1d8-5baf-b6c0-d3e27bcc4297" type="rule"/>
        <infoLink id="5c70818c-b44e-5858-9412-de31efa70f66" name="Titanic Monster" hidden="false" targetId="ddb37932-0e7e-58ee-ba30-d139f6f9a4c4" type="rule"/>
