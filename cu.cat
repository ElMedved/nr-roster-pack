                <profile id="e08f33be-832c-5473-abb6-592e75b39b51" name="Treason of Tzeentch" hidden="false" typeId="a3471e59-a0ee-5ebc-b029-a86d34fad447" typeName="Psychic Power">
                  <characteristics>
                    <characteristic name="Cast" typeId="97e70b1c-dbfb-5c51-961a-c1ddce655c1f">Cast Target W+</characteristic>
                    <characteristic name="Range" typeId="bd6bc23e-e24d-5c7e-855c-409059c1eee5">12</characteristic>
                    <characteristic name="S" typeId="b8615668-9262-5080-ae30-cf051dbfb91d">-</characteristic>
                    <characteristic name="AP" typeId="a70a61f0-0f3f-5124-abb1-4b5b604b58cb">-</characteristic>
                    <characteristic name="Rules" typeId="6b2a8df2-cb0b-5493-974f-d27207ce83fd">Target model becomes under your control and performs their Melee or Ranged attack, treating friendly units as enemies. The Cast value for this is the target model’s remaining W, and cannot target a Titanic model. You must declare the target before rolling to Cast.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="pts" typeId="points" value="15"/>
              </costs>
            </selectionEntry>
