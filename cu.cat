              <constraints>
                <constraint id="f948e200-ebbb-52e8-8f0e-b95197a5db1c" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <profiles>
                <profile id="eb447cab-c3f5-53dd-bc81-95714c8e9b6f" name="Hatred of Magick" hidden="false" typeId="a3471e59-a0ee-5ebc-b029-a86d34fad447" typeName="Psychic Power">
                  <characteristics>
                    <characteristic name="Cast" typeId="97e70b1c-dbfb-5c51-961a-c1ddce655c1f">Sacrifice 1/die</characteristic>
                    <characteristic name="Range" typeId="bd6bc23e-e24d-5c7e-855c-409059c1eee5">User</characteristic>
                    <characteristic name="S" typeId="b8615668-9262-5080-ae30-cf051dbfb91d">-</characteristic>
                    <characteristic name="AP" typeId="a70a61f0-0f3f-5124-abb1-4b5b604b58cb">-</characteristic>
                    <characteristic name="Rules" typeId="6b2a8df2-cb0b-5493-974f-d27207ce83fd">This model may roll 1 extra Deny the Witch dice per Sacrifice paid until your next Psychic Phase. These dice may only be used once each, but this model may Deny the Witch unlimited times with the default 2 dice for free.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="pts" typeId="points" value="25"/>
              </costs>
