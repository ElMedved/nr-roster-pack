      <rules>
        <rule id="6223260a-0b46-5a9e-9c9b-9ec801566c3f" name="Create Panic" hidden="false">
          <description>This model displaces all models when it moves, place them up to 1” Away. Immobile units prevent this model from moving there.</description>
        </rule>
        <rule id="b09416f7-f5cc-578e-81a1-79079dc35376" name="Nuclear Meltdown" hidden="false">
          <description>This model explodes on a 4+ with S Destroyer AP1+ in a 4d6” Radius.</description>
        </rule>
        <rule id="cf89b88b-4e13-503f-a3f8-0cd1e1e4395b" name="Titanic God Engine" hidden="false">
          <description>This model may ignore all Non- Titanic models and Terrain for the purposes of Moving, Advancing, Falling Back, and Charging.</description>
        </rule>
        <rule id="f5e6790b-3687-5c41-9445-a83b3655e0e6" name="Earthshock" hidden="false">
          <description>Any unit Hit by this Template only Moves, Advances, Charges, and Falls Back at Half Speed until your next Command Phase.</description>
        </rule>
      </rules>
      <infoLinks>
