      <rules>
        <rule id="a31a00df-113d-5abc-8705-808f43e74734" name="Spiteful Occupants" hidden="false">
          <description>In each of your Command Phases, roll 1d6. On a 1 your Opponent controls them during your turn. They may not directly attack friendly models, but may obstruct them, destroy building they occupy, and so on.</description>
        </rule>
      </rules>
