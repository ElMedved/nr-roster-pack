            <characteristic name="Rules" typeId="989bc79d-9e4b-528b-b966-eff3ce994cc7">Sniper (2+), Independent Characters slain by this weapon spawn a Chaos Spawn within 6” with no upgrades</characteristic>
          </characteristics>
        </profile>
