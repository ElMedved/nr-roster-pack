      <rules>
        <rule id="e72ba48e-3370-5547-8c2d-d68970e16ded" name="Attention Seeker" hidden="false">
          <description>Right After the enemy finishes Declaring their Charges and Resolving the movement for them, this unit must Declare a Charge against the closest enemy unit if it is in range.</description>
        </rule>
        <rule id="9ee09076-42c9-57f9-a70f-98a2ad33803f" name="Regenerate" hidden="false">
          <description>This unit heals 1 Wound in each of your Command Phases, even if it already Healed this turn. This is an exception to the normal Heal rules.</description>
        </rule>
        <rule id="b0d6c5eb-8497-5937-9d6f-5e1dd931d3f0" name="Slime Trail" hidden="false">
          <description>Charges against this model are always Disorganized.</description>
        </rule>
