      <rules>
        <rule id="771ff41a-5eac-5cd5-907d-61bd9bcf56d0" name="Create Panic" hidden="false">
          <description>This model displaces all models when it moves, place them up to 1” Away. Immobile units prevent this model from moving there.</description>
        </rule>
        <rule id="438bc696-d742-54f9-81d0-acf36394d750" name="Nuclear Meltdown" hidden="false">
          <description>This model explodes on a 4+ with S Destroyer AP1+ in a 2d6” Radius.</description>
        </rule>
        <rule id="e489cf02-a8b2-5491-ab55-4d5a69018dcc" name="Titanic God Engine" hidden="false">
          <description>This model may ignore all Non- Titanic models and Terrain for the purposes of Moving, Advancing, Falling Back, and Charging.</description>
        </rule>
      </rules>
