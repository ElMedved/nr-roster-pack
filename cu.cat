          <characteristics>
            <characteristic name="Description" typeId="1c2f4080-02ec-5486-826a-4d2299dd0bb1">If this model is involved in a Challenge, it mirrors the Datasheet of the model it is Challenging but is at full Wounds in this mirrored form. If the Challenge ends and this model is still alive, return to its normal Datasheet with whatever Wounds it had.</characteristic>
          </characteristics>
        </profile>
