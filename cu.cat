      <rules>
        <rule id="904bbd88-7a15-5387-a781-a3acfee2f2fd" name="Impact Hits" hidden="false">
          <description>When this unit’s Melee is nominated to fight, if it is considered to have Charged this phase it inflicts d3 Auto Hits per Hellflayer at S6 AP3+.</description>
        </rule>
        <rule id="1f41aa15-2953-5e59-96c4-d795e6f5df00" name="Locus of Slaanesh" hidden="false">
          <description>6” Aura, this model and target unit with the Mark of Slaanesh gains S+1.</description>
        </rule>
      </rules>
