      <rules>
        <rule id="b36ff7be-3054-5d77-b67b-798b0aa2a992" name="Gift of the Hellforge" hidden="false">
          <description>6” Aura, target Vehicle unit gains A+1.</description>
        </rule>
        <rule id="dc68ab35-59b2-5d66-a833-e17be37b1e81" name="Repair" hidden="false">
          <description>Target model in base contact Repairs 1 Wound. Roll a d6, on a 5+ restore service for one Weapon Disabled, Crew Shaken, Immobilized, or Weapon Destroyed.</description>
        </rule>
      </rules>
