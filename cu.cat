      <rules>
        <rule id="a9de41d3-d06f-5fb5-9e20-5c483d1e1061" name="Executioner" hidden="false">
          <description>This model may choose the target of its Challenge. The target may not deny the Challenge.</description>
        </rule>
        <rule id="818bd82f-31ba-5a68-b885-4429b31ff0de" name="Gorefeast" hidden="false">
          <description>For each model slain by Blade of Blood, this model Heals 1 Wound. This is an exception to the normal Heal rules, but this model cannot exceed its starting Wounds.</description>
        </rule>
        <rule id="bab58a5d-cc64-5af3-8ddc-bfeaeecbe027" name="Locus of Decapitation" hidden="false">
          <description>6” Aura, this model and target unit with the Mark of Khorne may reroll 1s To Wound.</description>
        </rule>
      </rules>
