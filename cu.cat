      <rules>
        <rule id="6228c799-358d-5dff-b420-e6581eef2d83" name="Lord of Chaos" hidden="false">
          <description>6” Aura, target unit may reroll 1s To Hit.</description>
        </rule>
        <rule id="7eb25169-07dd-5fbb-9251-10d69ed9c331" name="Nurgling Infestation" hidden="false">
          <description>6” Aura, in each of your Command Phases, target Nurgling unit gains 1 Nurgling Swarm even if it exceeds its starting size.</description>
        </rule>
        <rule id="14df5d67-0150-500d-9781-791340f4acb4" name="Regenerate" hidden="false">
          <description>This unit heals 1 Wound in each of your Command Phases, even if it already Healed this turn. This is an exception to the normal Heal rules.</description>
        </rule>
        <rule id="d4a8f9ea-2569-5c3d-8a0e-004346b3cba3" name="Slime Trail" hidden="false">
          <description>Charges against this model are always Disorganized.</description>
        </rule>
      </rules>
