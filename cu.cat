      <rules>
        <rule id="322d73ed-5732-51ae-9a90-3c313d748f31" name="P’tarix’s Sorcerous Syphon" hidden="false">
          <description>At the end of the Opponents Psychic Phase, randomly Auto Cast one spell that was cast this phase that originated or ended within 12” of this model.</description>
        </rule>
        <rule id="b0852cb0-1409-5a6f-bba8-606da5859107" name="Xirat’p’s Sorcerous Barrage" hidden="false">
          <description>This model knows all the Tzeentch Spells. Randomly Auto Cast one in each of your Psychic Phases.</description>
        </rule>
      </rules>
