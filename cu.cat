      <rules>
        <rule id="ec229e72-2bb5-541e-8cf6-2448a0f35fff" name="Mad Gibberish" hidden="false">
          <description>6” Aura, target unit suffers Ld-3 but your Opponent gets to pick the target, friend or foe. You do not choose when to cast this Aura.</description>
        </rule>
        <rule id="85d75a7d-4ca5-568f-b99f-f039d3d9e28b" name="Right Hand of Tzeentch" hidden="false">
          <description>This model may reroll 1s To Cast and may Cast each spell it knows each of your Psychic Phases knows despite its Psychic Mastery Level.</description>
        </rule>
      </rules>
