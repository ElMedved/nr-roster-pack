      <rules>
        <rule id="7c100818-8ff1-5bcc-80af-427012aa73b4" name="Chariot Slashing Attack" hidden="false">
          <description>In the Movement Phase, if this model Moves over one or more enemy units that are not Engaged in Melee, inflict 2d3</description>
        </rule>
        <rule id="1c2d9592-f98a-554b-8e93-9157febb030b" name="S4 AP" hidden="false">
          <description>Auto Hits on one of those units for each Screamer in this unit.</description>
        </rule>
        <rule id="e0f55906-cdb9-5464-ab2f-6e04ee967f08" name="Fate Meddler" hidden="false">
          <description>6” Aura, target enemy unit must reroll 6s To Hit.</description>
        </rule>
      </rules>
