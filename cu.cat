    <selectionEntry id="3cb31cda-d769-53ed-8a55-7db6f9a80825" name="Sloppity Bilepiper" publicationId="3f5decae-471b-55fd-8848-580f3d11fa9b" page="16" hidden="false" collective="false" import="true" type="unit">
      <profiles>
        <profile id="e9e1fbd8-3dd9-5839-a7d8-cb11ce01379e" name="Bilepiper" hidden="false" typeId="c4d93c9f-bd1a-5ef8-8b78-4f198aad6964" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="1f4c78ac-1f27-5042-bfb7-0d00f8f695a2">6</characteristic>
            <characteristic name="WS" typeId="d94fa72c-3ead-5b35-ae0e-3fdce3a41cf7">3+</characteristic>
            <characteristic name="BS" typeId="887899fe-1bdf-5a72-a3e1-f87bdd96622a">5+</characteristic>
            <characteristic name="S" typeId="135fb285-c97f-57fb-b178-be4a154ff49f">4</characteristic>
            <characteristic name="T" typeId="755e50b9-0a88-5118-b150-4f991fea0b0b">5</characteristic>
            <characteristic name="W" typeId="ab6f48e2-16a0-59de-9511-89fbff6d4548">4</characteristic>
            <characteristic name="I" typeId="1bf29bae-0689-56f9-b0e3-2a022091b15b">4</characteristic>
            <characteristic name="A" typeId="51d23fe8-6dd4-5bba-b2a9-8ef0f0d132ba">3</characteristic>
            <characteristic name="Ld" typeId="494a7951-7cd9-524d-bf22-444838fed165">8</characteristic>
            <characteristic name="Sv" typeId="3516322a-033e-5517-b8bd-1c7dfa38d6de">-</characteristic>
          </characteristics>
        </profile>
        <profile id="8915488c-02f3-548e-8038-847b67cd63a6" name="Unit Composition" hidden="false" typeId="35b65644-1892-5b82-90c0-20981913471e" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="83d81002-a330-5968-9552-22dcb2ed8516">1 Bilepiper</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="74320ed6-99ee-5577-9e6d-d92bfb9ad332" name="Disease of Mirth" hidden="false">
          <description>6” Aura, this model and target unit rolls 1 extra d6 when rolling Ld Tests and discards the highest d6.</description>
        </rule>
        <rule id="d3d586be-6550-5227-994a-efe1dbda90a1" name="Jolly Gutpipes" hidden="false">
          <description>6” Aura, this model and target unit with the Mark of Nurgle gains A+1.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="c2b47d6b-7bac-51db-a409-66aabbc6ef50" name="Independent Character" hidden="false" targetId="daa374d1-a1d8-5baf-b6c0-d3e27bcc4297" type="rule"/>
        <infoLink id="bf514bd7-a176-55f3-875f-5464c04d95a4" name="Infantry" hidden="false" targetId="1c63b9cc-d5dc-5e00-99f3-357cdc80505b" type="rule"/>
