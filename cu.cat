  <sharedSelectionEntries>
    <selectionEntry id="93df4fa5-5c29-5fc3-b960-05ef32227c5f" name="Chaos Allegiance &amp; Warband &amp; Army Rules" publicationId="3f5decae-471b-55fd-8848-580f3d11fa9b" page="2" hidden="false" collective="false" import="true" type="upgrade">
      <constraints>
        <constraint id="e04a8bc4-8f82-52eb-a3a1-2cc43a88f243" field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="min"/>
        <constraint id="2ddc94f8-0a7b-5355-acdc-8889ed8b5c80" field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max"/>
      </constraints>
      <rules>
        <rule id="3ef389b4-9d04-569f-b05a-27c8f73edcf0" name="Daemonic &amp; Daemonic Engine" hidden="false">
          <description>Daemonic: 5+ Invulnerability Save. Daemonic Engine: 5+ Invulnerability Save and immune to secondary effects of Weapon Disabled and Crew Stun.</description>
        </rule>
        <rule id="22c1ef01-7ccc-5540-b841-6efcc0489263" name="Malicious Volleys" hidden="false">
          <description>Stationary models treat Bolter weapons as in half range.</description>
        </rule>
        <rule id="8f040994-8bc3-5b39-8671-4b889bfb05ea" name="Marks of Chaos" hidden="false">
          <description>Khorne (A+1, Furious Charge), Nurgle (5+ Feel No Pain), Slaanesh (I+1, Counterattack), Tzeentch (5+ Invuln or +1 Invuln to 4+), Undivided (1 unit may take a Pure Blessing).</description>
        </rule>
        <rule id="3f47da12-4b99-57d2-8e86-68e10ca6b00d" name="Pure Blessings" hidden="false">
          <description>Khorne (additional A+1), Nurgle (Living Rot: Heal 1 Wound or 1 slain model per Command Phase), Slaanesh (I+2, Fleet), Tzeentch (Ignore first Wound suffered each Phase).</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup id="7cef8d50-d196-589d-892c-21c856f0781b" name="Select Chaos Allegiance &amp; Warband" hidden="false" collective="false" import="true" defaultSelectionEntryId="91722174-9449-5062-a474-dcb826635049">
          <constraints>
            <constraint id="2463b76a-4818-5aa5-8263-a8d9c9065bfc" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="min"/>
            <constraint id="dc224a90-a317-594c-91df-8872ce5c4206" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
          </constraints>
          <selectionEntries>
            <selectionEntry id="91722174-9449-5062-a474-dcb826635049" name="Undivided: Average Warband" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="d26123e7-03cb-52f9-8b6d-d8ecfb596a72" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="c84727cd-20be-5f60-82a7-e8b7fa7f2fdf" name="Chaos Allegiance &amp; Warband: Undivided: Average Warband" hidden="false">
                  <description>Plays exactly as presented in the Chaos Undivided Codex.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="a5610840-5b5d-57f8-95fa-cf684ea9aaad" name="Undivided: Alpha Legion" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="569adb84-bffb-520d-bc4e-60f6c20b4fb3" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="4a344673-90c1-569c-a6f6-075400322372" name="Chaos Allegiance &amp; Warband: Undivided: Alpha Legion" hidden="false">
                  <description>• Deception Experts: All units gain Infiltrate (or Scout if already Infiltrate).
• No, I am Alpharius: Must reroll successful Ld tests.
• Undivided: Warlord must have Mark of Undivided.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="b93fb2ae-f663-5fd9-af1f-1d057b19e977" name="Undivided: Black Legion" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="71a92229-0be7-5d9b-82df-9f0c43ba41eb" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="4846c51a-0e2e-5925-9f4b-7d1e1174b3b9" name="Chaos Allegiance &amp; Warband: Undivided: Black Legion" hidden="false">
                  <description>• First Traitors: All models gain Stubborn.
• Pride of their Fall: Suffer 1 Auto Wound per point failed on Ld tests.
• Undivided: Warlord must have Mark of Undivided.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="185fef59-21f1-5221-bf09-5721fae18e85" name="Undivided: Crimson Slaughter" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="f7ad3430-7845-56d2-8eb3-1c14872ccf6f" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="27c77ba8-3d4e-5c73-a500-a58d1ba9d424" name="Chaos Allegiance &amp; Warband: Undivided: Crimson Slaughter" hidden="false">
                  <description>• The Haunting: Suffer -1 To Hit / +1 Scatter unless unit Hit an enemy last Turn.
• Furious Insanity: While suffering -1 To Hit, gain A+1 and reroll failed Charges.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="b7e761dd-48ac-5d33-bed2-d7b55bd09ee8" name="Undivided: Iron Warriors" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="17001e58-c96b-5bef-bd42-0ab311edd52e" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="6e3bd312-9851-562f-a263-62b78b8a7c4b" name="Chaos Allegiance &amp; Warband: Undivided: Iron Warriors" hidden="false">
                  <description>• Pride of the Breaker: Must target destructible Terrain/Fortifications when enemy is inside.
• Siege Breakers: Reroll To Wound against Terrain/Fortifications.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="35565c98-c2d8-5efc-9f2a-4542376e14cb" name="Undivided: Night Lords" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="891059a1-5aaf-5d02-9c89-2a695ebc975a" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="d4bdc357-f541-5f27-81a4-727056a30e19" name="Chaos Allegiance &amp; Warband: Undivided: Night Lords" hidden="false">
                  <description>• Raiders: Automatically lose Combat Resolution and always Fall Back.
• Terror Tactics: All models gain Outflank.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="351d430e-2def-5804-8808-3c1a560bb7dd" name="Undivided: Red Corsairs" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="d10e6ef6-03bf-53af-bdea-7b0c39452c26" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="ce8622d6-7ee0-55a2-b27e-b1319246fe6c" name="Chaos Allegiance &amp; Warband: Undivided: Red Corsairs" hidden="false">
                  <description>• Pirates: All models gain Outflank, but must be held in Reserve during Deployment.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="6a57e6d9-131e-54c3-a28b-48532332ba1d" name="Undivided: The Faithless" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="2e49a51e-ffae-5238-9712-85a39fd17fe4" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="516de2a1-a6a4-5e9a-a9c8-88cd5646bb25" name="Chaos Allegiance &amp; Warband: Undivided: The Faithless" hidden="false">
                  <description>• Foolish Rebellion: Only receive Auras from Mark of Undivided or unmarked models.
• Treacherous Designs: All models gain Outflank.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="fb74476c-0a96-58db-8aa3-496ac870932c" name="Undivided: Word Bearers" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="c3d6a0c6-64e4-5890-91ef-419de3bb1180" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="ed253d7b-7ff1-55c5-a72f-3489fc277973" name="Chaos Allegiance &amp; Warband: Undivided: Word Bearers" hidden="false">
                  <description>• Fanaticism: Opponents double Wounds dealt for Combat Resolution.
• Zealotry: Reroll To Hit in Melee when Charging or Charged.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="bb7ae7a8-e877-5551-8088-d7a5e1647cfc" name="Khorne: Average Warband" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="a7980e3d-3656-571e-b4df-64fda3c9b5f5" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="5fe8509d-eb96-549a-9406-61afbbc66628" name="Chaos Allegiance &amp; Warband: Khorne: Average Warband" hidden="false">
                  <description>Unlocks Khorne supplement units. Plays as presented in the Khorne Codex.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="cdd483f1-7e03-5cf9-96e1-2310423e1b13" name="Khorne: World Eaters" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="5439dc0c-11a1-5a22-83cc-28458fcf6d42" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="f15c4447-69a9-5539-ad71-2ce01ce636aa" name="Chaos Allegiance &amp; Warband: Khorne: World Eaters" hidden="false">
                  <description>• Barely Restrained Bloodlust: Failing Command Phase Ld test forces Compulsory Move/Charge toward closest enemy.
• Origin of the Berzerker: Khorne Berzerkers may be taken as Troops.
• Only Seeing Red: +2 to Charge rolls.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="7d81188b-e706-56da-8732-901ab2858ed5" name="Khorne: Brazen Beasts" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="7f2e16c3-dbda-585c-a6c3-fa0d81fe3453" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="938fa35a-a720-5b76-9b15-2e4de905dc28" name="Chaos Allegiance &amp; Warband: Khorne: Brazen Beasts" hidden="false">
                  <description>• Daemonic Engine Stables: Daemonic Engines gain Scout.
• Khorne Consecration: Automatically Restrain and never Pursue.
• Seeking Violence: Infantry count as half for Contesting Objectives.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="655d4168-8bb4-54e3-b2c2-67a897093d75" name="Khorne: Disciples of the Red Angel" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="6ec2b36a-ec3d-55b6-9641-64a610d91032" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="b89cb6f4-a4b4-51de-9841-3dc517798999" name="Chaos Allegiance &amp; Warband: Khorne: Disciples of the Red Angel" hidden="false">
                  <description>• Daemonic Guard: Only Daemonic / Daemonic Engine units (plus World Eaters); gain Bodyguard but cannot Claim/Contest Objectives.
• Fearsome Foes: 6" Aura forcing Fear Test.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="97b1ae43-e9a0-56c2-a16a-fc6444f35541" name="Khorne: Fire Riders" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="7547b648-6422-5359-b2ab-7a1a9feb5429" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="0e74d9a4-878a-51bb-8d1b-5ba3ed69a18d" name="Chaos Allegiance &amp; Warband: Khorne: Fire Riders" hidden="false">
                  <description>• Bridge of Fire: All models gain Outflank and must start in Reserve. May include World Eaters.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="1c9d6298-3c53-5b3b-ba5f-f2ccd08289c7" name="Khorne: The Butcherhorde" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="d332cd39-ea48-5f50-b663-553fb9c4cac0" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="10646eed-22ad-5a47-88ab-4f6579fd6c33" name="Chaos Allegiance &amp; Warband: Khorne: The Butcherhorde" hidden="false">
                  <description>• Blood for the Blood God!: Gain Rending in Melee (or 4+ if already Rending); natural 1s To Hit in Melee strike own unit. May include World Eaters.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="ed3d1c92-8a78-5c88-a006-8f9ca9a9a335" name="Nurgle: Average Warband" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="61794daf-d234-5a56-a22d-4632d6526fea" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="57ed2754-de8f-5105-9431-e5592d0a8f78" name="Chaos Allegiance &amp; Warband: Nurgle: Average Warband" hidden="false">
                  <description>Unlocks Nurgle supplement units. Plays as presented in the Nurgle Codex.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="70089d75-057b-557b-bee6-1f1b7b3199d7" name="Nurgle: Death Guard" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="37ecc4dc-1074-524c-8e87-0782fd0dbffd" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="2643e9ff-e4c7-58c2-962f-c970ba7f784b" name="Chaos Allegiance &amp; Warband: Nurgle: Death Guard" hidden="false">
                  <description>Unlocks Nurgle &amp; Death Guard units. Plague Marines may be taken as Troops.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="dd43e0a5-2fb6-5db1-ac56-a168f6c92943" name="Slaanesh: Average Warband" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="3ebf9fca-8e92-5c11-871a-1647869d7cce" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="b2661271-f828-59ed-8a61-55f43597fe8e" name="Chaos Allegiance &amp; Warband: Slaanesh: Average Warband" hidden="false">
                  <description>Unlocks Slaanesh supplement units. Plays as presented in the Slaanesh Codex.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
