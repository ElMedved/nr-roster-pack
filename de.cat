        </rule>
        <rule id="80792e76-9217-51a2-be59-1b7dad1f03e7" name="No Escape" hidden="false">
          <description>6” Aura, target unit attempting to Fall Back must perform an Initiative Test against this model. If this model wins the test, the unit cannot Fall Back.</description>
        </rule>
        <rule id="2569a299-abb8-57f1-ab35-d8ee1f6201a9" name="Out of their League" hidden="false">
          <description>This model rerolls all failed To Hit and To Wound rolls when in a Challenge.</description>
        </rule>
        <rule id="9ce67ec3-c94b-5604-bbdc-a1b8d5b2c7bb" name="Rampage" hidden="false">
          <description>This model gains A+d3 when outnumbered in Melee.</description>
        </rule>
      </rules>
