      <rules>
        <rule id="7a5c0840-fd7d-5487-9722-2943d3229a0f" name="Faceless Terror" hidden="false">
          <description>6” Aura, target unit must make a Fear Test. This is cast as a unit.</description>
        </rule>
        <rule id="0c94bdf7-a42e-5925-887a-7a98627494ff" name="Shadow Crawl" hidden="false">
          <description>This unit may be held in Reserve. It arrives on table in Combat with one enemy unit, treated as On Going Combat. The Mandrake unit must still be at least 1” away from all other units.</description>
        </rule>
        <rule id="41543bba-2e72-53cc-b5b2-2cd6e073cdaf" name="Terrifying Presence" hidden="false">
          <description>No Independent Characters may join this unit.</description>
        </rule>
      </rules>
