  <sharedSelectionEntries>
    <selectionEntry id="bddcabf5-26df-5ca2-b3de-b6667794f3d2" name="Kabal / Cult / Coven &amp; Army Rules" publicationId="ab8103c7-101a-5e00-8b6a-b810eb0a6dd9" page="2" hidden="false" collective="false" import="true" type="upgrade">
      <constraints>
        <constraint id="ff678760-7b7e-5d2e-bac4-251a658a9ebf" field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="min"/>
        <constraint id="a41ceb64-b2ab-5287-b7fe-096e65a47cde" field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max"/>
      </constraints>
      <rules>
        <rule id="9eae44dd-ee45-576c-a714-f3c6284c7f30" name="Combat Stimulants" hidden="false">
          <description>This model has Furious Charge and a 5+ Feel No Pain.</description>
        </rule>
        <rule id="acf3c152-1c3c-540b-b863-f98e01eff062" name="Exposed Transport" hidden="false">
          <description>On a 4+, unsaved Glances/Penetrations inflict 1 Mortal Wound on an Embarked model instead; embarked models may fight in Melee.</description>
        </rule>
        <rule id="962b1eb9-d486-579c-81d5-bc43c0f9cd3d" name="Sudden Descent" hidden="false">
          <description>When this model Deepstrikes, it gains Stealth until your next Command Phase.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup id="54b98d44-b04b-531e-9aed-118444488949" name="Select Kabal / Cult / Coven" hidden="false" collective="false" import="true" defaultSelectionEntryId="a8f6fac2-5dd2-5d6c-992d-62b0e7753f74">
          <constraints>
            <constraint id="b390453b-dd65-5b0b-a18f-f8bdeda9e028" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="min"/>
            <constraint id="88d03bbb-6f2f-5f79-8d09-9f5c657718ec" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
          </constraints>
          <selectionEntries>
            <selectionEntry id="a8f6fac2-5dd2-5d6c-992d-62b0e7753f74" name="Average Kabal" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="56dbc98a-bf29-5225-bd11-f16ecbbf82ce" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="a8d93d53-ecf5-5211-894a-cb73e2f4d2fa" name="Kabal / Cult / Coven: Average Kabal" hidden="false">
                  <description>The army is fielded exactly as it is presented in this Codex.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="6ac65ebc-6661-5e22-b262-436bc556dff9" name="Kabal of the Black Heart" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="b15e7246-b400-54e1-a4f9-4698ddd7724b" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="bc90e3d9-8f2a-5fd2-a686-18c67967ac8e" name="Kabal / Cult / Coven: Kabal of the Black Heart" hidden="false">
                  <description>• Agents of Vect: All Infantry gain Objective Secured.
• Obsession for Power: Must declare Charges if able and arrive from Reserves within 3" of an Objective.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="ef6a090b-a40c-589d-9e0f-aa0b94d408e9" name="Kabal of the Flayed Skull" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="c095e61d-cda3-584f-b282-9e298bd326e3" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="54bfc672-0af6-5e6b-8cc8-c1920c8a9ba5" name="Kabal / Cult / Coven: Kabal of the Flayed Skull" hidden="false">
                  <description>• Skyborne Kabal: All models must start in Reserve.
• Sudden Strike: All non-building models gain Deepstrike (or reroll Scatter if already Deepstrike).</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="ba1cbf8d-e245-5612-882a-f41fb9b3eee6" name="Kabal of the Obsidian Rose" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="7d136380-301d-57cd-8853-5a5b1fd661de" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="b82a90b0-0d16-54dc-a676-9967f7fafd68" name="Kabal / Cult / Coven: Kabal of the Obsidian Rose" hidden="false">
                  <description>• Flawless Craftsmanship: All weapons gain Rending (or 4+ if already Rending).
• Failure is not Tolerated: Suffer 1 Mortal Wound per point failed on 2d6 Ld tests.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="27e49612-061c-53a2-8ae0-df969f4bdfa5" name="Kabal of the Poisoned Tongue" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="3da6344d-602c-5bc2-bb3c-337e24f36bb8" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="88ed6340-ccdb-5269-bee1-384d60cae40a" name="Kabal / Cult / Coven: Kabal of the Poisoned Tongue" hidden="false">
                  <description>• Insidious Misdirection: Redeploy 1 unit per 1000 points after Deployment.
• Towering Arrogance: All models suffer Ld-1.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="041f1cda-ef4f-54a5-8200-2fdbdae90274" name="Cult of Strife" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="b7788967-bfcf-50d4-89d9-1bf4f86ecf3d" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="d010cf02-e337-5860-b61d-57b817ec54f6" name="Kabal / Cult / Coven: Cult of Strife" hidden="false">
                  <description>• The Spectacle of Murder: Units gain A+1 if there is an ongoing Challenge in their Melee.
• Must Strike First: Must declare a Charge if able.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="2a29d6d1-5f60-5ec1-9365-a6529d6bcd3b" name="Cult of the Cursed Blade" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="9cd8dcec-73b4-542e-a2bb-7cd19fdf3ab5" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="de6e12bb-29ed-5553-af68-882feaaedac1" name="Kabal / Cult / Coven: Cult of the Cursed Blade" hidden="false">
                  <description>• Only the Strong Will Thrive: T3 models gain T+1; enemy Poison weapons suffer -1 To Wound.
• Internal Treachery: Max 1 friendly Aura per unit per Turn; all models suffer Ld-2.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="55c24e18-5e1c-5cde-82b4-d01d593c0fd9" name="Cult of the Red Grief" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="005689d4-fdf0-53e4-ad34-0339a917e0a5" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="61e15649-169f-5e47-a6cf-af37755271d7" name="Kabal / Cult / Coven: Cult of the Red Grief" hidden="false">
                  <description>• The Speed of the Kill: Reroll failed Charge rolls.
• Obsession with Speed: All Infantry suffer Sv+1 (worsens by 1).</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="76b80cb3-f13f-5276-9ad1-6752855404d9" name="Coven of Twelve" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="41983cce-f932-5bdf-a1e3-9db3c0f00639" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="3a10c58c-f150-52eb-8cef-77b0edf341d0" name="Kabal / Cult / Coven: Coven of Twelve" hidden="false">
                  <description>• Butchers of Flesh: All models gain Shock Assault.
• Flesh Samplers: Automatically Restrain when pursuing in Melee.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="817b4efc-5084-5cab-9c1a-6f21fca8bf49" name="The Dark Creed" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="215bd8b0-6bb0-5c3f-bc51-1756706a0fc2" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="34d4a4f6-3061-50d7-b63c-e3440287a2b7" name="Kabal / Cult / Coven: The Dark Creed" hidden="false">
                  <description>• Distillers of Fear: Enemy models in base contact suffer Ld-2.
• Tormentor's Delight: Infantry count as half for Contesting Objectives.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="492f12d1-b5d7-5164-ae81-88537d38fc39" name="The Prophets of Flesh" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="b217d511-df9f-55e3-8270-e923207ada76" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="72b21be5-6059-5cf2-b1e7-d907dbcde761" name="Kabal / Cult / Coven: The Prophets of Flesh" hidden="false">
                  <description>• Connoisseurs of Pain: Inflict -1 penalty on enemy Feel No Pain rolls.
• Fleshcraft Pursuits: Cannot Claim or Contest Objectives in enemy Deployment Zone.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
    </selectionEntry>
    <selectionEntry id="8b57a595-aa12-5b86-ba88-5ff6635adb01" name="Archon" publicationId="ab8103c7-101a-5e00-8b6a-b810eb0a6dd9" page="4" hidden="false" collective="false" import="true" type="unit">
      <profiles>
        <profile id="520da08b-25e9-5370-917e-68311e0a4682" name="Archon" hidden="false" typeId="c4d93c9f-bd1a-5ef8-8b78-4f198aad6964" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="1f4c78ac-1f27-5042-bfb7-0d00f8f695a2">8</characteristic>
            <characteristic name="WS" typeId="d94fa72c-3ead-5b35-ae0e-3fdce3a41cf7">2+</characteristic>
            <characteristic name="BS" typeId="887899fe-1bdf-5a72-a3e1-f87bdd96622a">2+</characteristic>
            <characteristic name="S" typeId="135fb285-c97f-57fb-b178-be4a154ff49f">3</characteristic>
            <characteristic name="T" typeId="755e50b9-0a88-5118-b150-4f991fea0b0b">3</characteristic>
            <characteristic name="W" typeId="ab6f48e2-16a0-59de-9511-89fbff6d4548">5</characteristic>
            <characteristic name="I" typeId="1bf29bae-0689-56f9-b0e3-2a022091b15b">5</characteristic>
            <characteristic name="A" typeId="51d23fe8-6dd4-5bba-b2a9-8ef0f0d132ba">4</characteristic>
            <characteristic name="Ld" typeId="494a7951-7cd9-524d-bf22-444838fed165">10</characteristic>
            <characteristic name="Sv" typeId="3516322a-033e-5517-b8bd-1c7dfa38d6de">3+</characteristic>
          </characteristics>
        </profile>
        <profile id="c2185b33-c0d2-59ba-9552-ccd5a9546c83" name="Unit Composition" hidden="false" typeId="35b65644-1892-5b82-90c0-20981913471e" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="83d81002-a330-5968-9552-22dcb2ed8516">1 Archon</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="54b245c6-3f0a-520a-b323-59eaec87ebec" name="Overlord" hidden="false">
          <description>6” Aura, this model and target unit may reroll 1s To Hit.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="9de8ef7b-578b-5413-ad22-cbae7848b14a" name="Independent Character" hidden="false" targetId="daa374d1-a1d8-5baf-b6c0-d3e27bcc4297" type="rule"/>
