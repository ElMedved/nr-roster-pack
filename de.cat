      <rules>
        <rule id="8b1fdc1b-dcbb-5d4c-b76b-66f694bfb2ae" name="Bride of Death" hidden="false">
          <description>6” Aura, this model and target unit may reroll 1s To Wound.</description>
        </rule>
        <rule id="30898e8e-76af-52ac-9f85-f499be72e620" name="No Escape" hidden="false">
          <description>6” Aura, target unit attempting to Fall Back must perform an Initiative Test against this model. If this model wins the test, the unit cannot Fall Back.</description>
        </rule>
      </rules>
