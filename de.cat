      <rules>
        <rule id="08008fdb-77f2-5ea4-93b1-0697099ac3e2" name="Follower of Ynnead" hidden="false">
          <description>This model is not affected by your Kabal rules.</description>
        </rule>
        <rule id="a8da91b4-bf43-5f09-9b9f-93dd43afea7b" name="Avatar of Ynnead" hidden="false">
          <description>6” True Aura, for each model slain, friend or foe, this model rolls a d6. On a 4+ it gains +1 Wound, even if it exceeds its starting Wound count.</description>
        </rule>
        <rule id="46ed9c5d-a157-5c60-a697-a0fa644a1309" name="Daemonic Avatar" hidden="false">
          <description>This model has a 4+ Invulnerability Save and a 5+ Feel No Pain.</description>
        </rule>
        <rule id="7f127e2e-7727-5f89-89e7-1357d85294c7" name="Death Avatar" hidden="false">
          <description>6” Aura, target unit must take a Fear Test.</description>
        </rule>
      </rules>
