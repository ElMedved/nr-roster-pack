        <infoLink id="04b478b8-8603-5855-8264-351d778c9bb4" name="Combat Stimulants" hidden="false" targetId="55c1b5d0-50dd-5675-bc95-fd253850d510" type="rule"/>
        <infoLink id="a50cad89-6331-5282-a34b-a6457084aa04" name="Fleet" hidden="false" targetId="bab24935-e302-5806-b996-fb882cebc870" type="rule"/>
      </infoLinks>
      <selectionEntryGroups>
        <selectionEntryGroup id="84b8a1d1-2163-5bbf-93a5-661a5371212a" name="Replace Splinter Pistol With (Pistol / Sidearm Option)" hidden="false" collective="false" import="true" defaultSelectionEntryId="49a79c4b-25de-5750-80b6-113eda93907f">
