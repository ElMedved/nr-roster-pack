  <sharedSelectionEntries>
    <selectionEntry id="c6ceebdc-3a45-5e0e-bc2d-8218f4176f1f" name="Craftworld &amp; Army Rules" publicationId="653e5156-be23-51ee-ab3f-8e0b3c203621" page="2" hidden="false" collective="false" import="true" type="upgrade">
      <constraints>
        <constraint id="6a140a67-ca18-5557-93aa-69bbd4d03834" field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="min"/>
        <constraint id="bba5835a-de18-5771-a86d-77779a322a0d" field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max"/>
      </constraints>
      <rules>
        <rule id="3f041b0c-9be2-5a46-93b6-1623b0899d3a" name="Phoenix Lord" hidden="false">
          <description>This model has a 3+ Invulnerability Save.</description>
        </rule>
        <rule id="a095b931-e9ab-50b4-b28f-d675d63e04b5" name="Harlequin" hidden="false">
          <description>Does not use Craftworld rules.</description>
        </rule>
        <rule id="4afa20f2-8f98-5827-911e-97ad407d1ee2" name="Exposed Transport" hidden="false">
          <description>On a 4+, unsaved Glances/Penetrations inflict 1 Mortal Wound on an Embarked model instead.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup id="82b20089-d50d-5938-9b1d-c411635a99d1" name="Select Craftworld" hidden="false" collective="false" import="true" defaultSelectionEntryId="85596259-26bb-51aa-9921-02733adcb6b5">
          <constraints>
            <constraint id="12880b2a-96c3-5de4-b9f0-276c51f282ad" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="min"/>
            <constraint id="fb472c96-7a95-52a4-acd7-0ce8e1d50e98" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
          </constraints>
          <selectionEntries>
            <selectionEntry id="85596259-26bb-51aa-9921-02733adcb6b5" name="Average Craftworld" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="33f411d7-8dad-5f10-846b-81d4e3144e26" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="1f611ce0-8876-5b45-b501-8e21800c4c0d" name="Craftworld: Average Craftworld" hidden="false">
                  <description>This army is fielded exactly as presented in this Codex with no changes.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="9ca9a6fd-38a3-5db4-a6d2-c943c583cef4" name="Alaitoc" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="479d5e42-0bc1-5bde-860b-7da49b58064d" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="0d2b061c-a551-5109-a437-ef950a499c2e" name="Craftworld: Alaitoc" hidden="false">
                  <description>• Ambushers: All Infantry gain Infiltrate (or Outflank if already Infiltrate).
• Indirect Tactics: Infantry cannot Claim or Contest Objective Markers in your Deployment Zone.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="30fff218-5bcf-5835-801c-cf1406487907" name="Biel-Tan" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="f10fd68f-3aff-5ef4-b162-1719a445ffa2" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="7c9d1c43-4581-594f-b58f-1bd0c05f23d9" name="Craftworld: Biel-Tan" hidden="false">
                  <description>• Swordwind: All models reroll 1s To Hit (or reroll 2s if already rerolling 1s).
• Lost Home World: Models count as half for Contesting Objectives and suffer Ld-1.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="1c6d51b8-bd14-5e80-aeb6-640ac5d2e8d5" name="Iyanden" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="889b62c2-7aa3-59ce-a10b-93ccb42bbdcd" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="e1b6c109-ccda-5dcf-b3df-864f6ea70d03" name="Craftworld: Iyanden" hidden="false">
                  <description>• Reliance on the Dead: Wraith models gain Objective Secured.
• Lost Home World: Models count as half for Contesting Objectives and suffer Ld-1.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="40b108a9-ed8f-55f9-b622-8476907ca92f" name="Mymeara" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="e75e440c-22e3-53fb-b21e-063ab02f49d3" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="832f3ed0-bf78-5106-9b55-6d4e8f71a685" name="Craftworld: Mymeara" hidden="false">
                  <description>• Isolationists: All Infantry gain Stealth (or Shroud if already Stealth).
• Lost Home World: Models count as half for Contesting Objectives and suffer Ld-1.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="7e39059e-36da-56e2-a883-d3808e2b59ca" name="Saim-Hann" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="6f75bb63-2546-502f-b665-511ffb69e5e9" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="17b1d9f2-cf5c-522e-9881-55fa8810c455" name="Craftworld: Saim-Hann" hidden="false">
                  <description>• Wild Riders: Models with Steed may be taken as a Troop Choice.
• Reckless Assault: Steed models charging into Cover or consolidating take Dangerous Terrain tests.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="39498888-8e6d-5774-a3ed-787cbbb0db60" name="Ulthwe" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="be15c867-9378-5877-be67-85ed9e17540c" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="5cbd8b50-932a-5906-a129-536505a055a3" name="Craftworld: Ulthwe" hidden="false">
                  <description>• Prescience: Redeploy 1 unit per 1000 points after Deployment.
• Psychic Dependence: If a Psyker is slain, friendly units within 6" take a Pinning Test.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
          </selectionEntries>
