        <rule id="e477004c-9952-5e98-98ea-3c505373dd45" name="Defense Tactics" hidden="false">
          <description>12” True Aura, all Eldar Troop Slots may shoot as if not engaged in Melee so long as they target units within their Melee range.</description>
        </rule>
        <rule id="fbb68a12-179b-5b49-8491-0575d9b09728" name="The Path of the Warrior" hidden="false">
          <description>12” True Aura, this model and all Dire Avenger units Overwatch on 4+, or 3+ if using Pistols.</description>
        </rule>
        <rule id="b16d9b12-cfca-5d40-bfc6-538265a29c89" name="Hand of Asuryan" hidden="false">
          <description>6” Aura, target unit gain 5+ Feel No Pain.</description>
        </rule>
        <rule id="dec0b3ab-0c03-5f9b-a3bc-6b4b0b34001b" name="The Path of Command" hidden="false">
          <description>6” Aura, this model and target unit may reroll 1s To Hit.</description>
        </rule>
      </rules>
