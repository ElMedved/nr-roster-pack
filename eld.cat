      <rules>
        <rule id="8ee72c2d-6ee8-5674-b39c-181333537899" name="Create Panic" hidden="false">
          <description>This model displaces all models when it moves, place them up to 1” Away. Immobile units prevent this model from moving there.</description>
        </rule>
        <rule id="a39e6c61-dcf8-56eb-a689-30300cab6f66" name="Titanic God Engine" hidden="false">
          <description>This model may ignore all Non- Titanic models and Terrain for the purposes of Moving, Advancing, Falling Back, and Charging.</description>
        </rule>
        <rule id="f2dfa8ce-9fdd-5689-a62f-f5499cd8766f" name="Spatial Rift" hidden="false">
          <description>Each time after resolving where the Template lands, place a 10” Crater that is Dangerous Terrain for the remainder of the game. Snap Shots and Overwatch do not place Craters.</description>
        </rule>
      </rules>
