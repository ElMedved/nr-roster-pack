      <rules>
        <rule id="52d18f1b-632d-5f31-8750-1a37b6914e40" name="Cursed" hidden="false">
          <description>Saves of natural 6s this model makes against Melee attacks must be rerolled.</description>
        </rule>
        <rule id="7d4e3115-d1a8-56dc-a58a-4d46795941d1" name="Reckless Tactics" hidden="false">
          <description>6” Aura, this model and target unit gain Counterattack.</description>
        </rule>
        <rule id="7956555c-cfbd-51ee-8845-a21eaeba832f" name="The Path of Command" hidden="false">
          <description>6” Aura, this model and target unit may reroll 1s To Hit.</description>
        </rule>
        <rule id="e1e65459-fcbd-507b-82a5-3f2efff1720a" name="Daemonic Thirst" hidden="false">
          <description>A weapon with this rule inflicts a Mortal Wound on its bearer in each of your Command Phases if you did not cause a Wound with the weapon during the last Turn. This does not trigger on Turn 1. If you roll a 1 for Extra Attack you may make no attacks this Melee phase and suffer 1 Mortal Wound.</description>
        </rule>
      </rules>
