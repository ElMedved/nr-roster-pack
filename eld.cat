      <rules>
        <rule id="6b6228c4-b2c0-5e34-ab61-8bbacce13ba9" name="Bonesing" hidden="false">
          <description>12” Aura, target Vehicle or Wraith model Repairs or Heals 1 Wound. Roll a d6, on a 5+ restore secondary service from a Vehicle Penetration Result, but not the additional lost Wounds.</description>
        </rule>
