                <profile id="56d2c3ba-a6f9-5cb4-ac21-6efa4bdb9166" name="Impair Senses" hidden="false" typeId="a3471e59-a0ee-5ebc-b029-a86d34fad447" typeName="Psychic Power">
                  <characteristics>
                    <characteristic name="Cast" typeId="97e70b1c-dbfb-5c51-961a-c1ddce655c1f">Cast 7+</characteristic>
                    <characteristic name="Range" typeId="bd6bc23e-e24d-5c7e-855c-409059c1eee5">18</characteristic>
                    <characteristic name="S" typeId="b8615668-9262-5080-ae30-cf051dbfb91d">-</characteristic>
                    <characteristic name="AP" typeId="a70a61f0-0f3f-5124-abb1-4b5b604b58cb">-</characteristic>
                    <characteristic name="Rules" typeId="6b2a8df2-cb0b-5493-974f-d27207ce83fd">Place a 10” Blast Template to represent an Impairing Cloud. Any non Eldar (Dark Eldar are still affected) shooting in to, out of, or through this cloud suffers -1 To Hit and +1 to the distance Scattered for Blast Templates. Remove at the start of your next Psychic Phase.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="pts" typeId="points" value="30"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="15d7d3d5-bdfc-5d10-a027-87a73021dde9" name="Enhance and Drain" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="de580161-20b2-5ae5-ae35-eab19d09603c" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
