      <rules>
        <rule id="2ee20554-4f19-5d92-814e-5607f6c69b2d" name="Battle Drills" hidden="false">
          <description>6” Aura, this model and target unit may Reroll 1s To Hit.</description>
        </rule>
        <rule id="cbf820b9-1f48-51fc-894a-6631fc2df721" name="Fate Entwined" hidden="false">
          <description>Each phase, Stern or Stern’s unit may reroll a single d6. If you do so, the opponent can also do so for one of their units during the same phase.</description>
        </rule>
        <rule id="d28d6362-7178-5994-b62a-2cbaa34a2d5b" name="Psychic Locus" hidden="false">
          <description>6” Aura, this model and target unit double the Range of their Spells.</description>
        </rule>
      </rules>
