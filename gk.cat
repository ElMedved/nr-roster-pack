      <rules>
        <rule id="5a44230a-ac45-5b00-a240-edf54d8c13ab" name="Awaken the Machine" hidden="false">
          <description>6” Aura, target Vehicle unit gains BS-1 (Improves by 1).</description>
        </rule>
        <rule id="19641e2e-e5f0-5d3b-8629-b22b794ea584" name="Repair" hidden="false">
          <description>Repair 1 Wound on Target Vehicle. Roll a d6, on a 5+, restore a Weapon Disabled, Destroyed, Crew Stun, or Immobilize secondary result.</description>
        </rule>
      </rules>
