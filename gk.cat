        <profile id="b4cbf6d8-45dd-5207-a631-02b06b841ee8" name="Malleus Argyrum" hidden="false" typeId="0b840343-a9ff-5f16-b0df-b617cac2c0fa" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="9c7850b8-81dd-53f9-80e1-1a39147745dd">Melee</characteristic>
            <characteristic name="S" typeId="1ec1daae-c783-53b1-87a9-2dc4176bdfea">X2</characteristic>
            <characteristic name="AP" typeId="37819752-fbc6-5464-ad45-17490825eae1">1+</characteristic>
            <characteristic name="Rules" typeId="989bc79d-9e4b-528b-b966-eff3ce994cc7">Slow, Armourbane, Psychicbane</characteristic>
          </characteristics>
        </profile>
        <profile id="a9174bc2-eaa3-553e-bd70-234a05be01fb" name="Orbital Strike" hidden="false" typeId="0b840343-a9ff-5f16-b0df-b617cac2c0fa" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="9c7850b8-81dd-53f9-80e1-1a39147745dd">12-240</characteristic>
            <characteristic name="S" typeId="1ec1daae-c783-53b1-87a9-2dc4176bdfea">D/10 /8</characteristic>
            <characteristic name="AP" typeId="37819752-fbc6-5464-ad45-17490825eae1">1+/1+ /1+</characteristic>
            <characteristic name="Rules" typeId="989bc79d-9e4b-528b-b966-eff3ce994cc7">Heavy 1, 15” Blast, Destroyer, Ordnance, Monsterbane, Indirect Fire, Ignores Cover, The Hour is Nigh, T Minus 5, One Use Only</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="fb0858f1-95b3-5125-b92a-114dce55dc82" name="Battle Drills" hidden="false">
          <description>6” Aura, this model and target unit may Reroll 1s To Hit.</description>
        </rule>
        <rule id="a36edbad-3b22-594a-9b06-a9e09fd4a000" name="Purity of Spirit" hidden="false">
          <description>6” Aura, this model and target unit may reroll 1s To Cast Spells.</description>
        </rule>
        <rule id="3d7ad96d-aa48-57c7-a699-62339f8b0ce3" name="The Hour is Nigh" hidden="false">
          <description>When the weapon is fired, place a marker on field at a valid target. In your next Command Phase, the barrage strikes! Scatter like normal, following the 15” Blast radius rules.</description>
        </rule>
        <rule id="39169445-cd68-5b9c-b169-9f813533d4ec" name="T Minus 5" hidden="false">
          <description>The weapon may not be fired Turn 1. If the weapon is marked on the field and the carrier is destroyed, the Orbital Strike still hits in your Command phase.</description>
        </rule>
      </rules>
