          <characteristics>
            <characteristic name="Range" typeId="9c7850b8-81dd-53f9-80e1-1a39147745dd">Melee</characteristic>
            <characteristic name="S" typeId="1ec1daae-c783-53b1-87a9-2dc4176bdfea">+1</characteristic>
            <characteristic name="AP" typeId="37819752-fbc6-5464-ad45-17490825eae1">2+</characteristic>
            <characteristic name="Rules" typeId="989bc79d-9e4b-528b-b966-eff3ce994cc7">Helps or Hinders</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="6001ade4-d5d4-5145-9ced-48225cee261f" name="Battle Drills" hidden="false">
          <description>6” Aura, this model and target unit may Reroll 1s To Hit.</description>
        </rule>
        <rule id="7ea590f2-d94c-5f7a-a018-4b1fef69e743" name="Psychic Locus" hidden="false">
          <description>6” Aura, this model and target unit double the Range of their Spells.</description>
        </rule>
        <rule id="a4d7b05e-d89b-51f2-9a31-dbea869a009e" name="Sword Master" hidden="false">
          <description>This model may reroll 1s To Wound and 1s for Armour Saves when it is in Melee.</description>
        </rule>
        <rule id="08da8f18-b4e4-5346-8fa1-3c3c7539b50b" name="Helps or Hinders" hidden="false">
          <description>In each Melee Phase, roll a d6. On a 1- 3, this weapon gives A+1. On 4- 6 It gives A+d6.</description>
        </rule>
      </rules>
