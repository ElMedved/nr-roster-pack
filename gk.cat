  <sharedSelectionEntries>
    <selectionEntry id="5b6ee3b0-eaab-5de9-8358-0669dc2abb7c" name="Brotherhood &amp; Army Rules" publicationId="2e6f0342-a8ae-50db-95c3-13ebc3dd5a28" page="2" hidden="false" collective="false" import="true" type="upgrade">
      <constraints>
        <constraint id="9879d9b1-2b65-51ac-b0b7-825c30404449" field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="min"/>
        <constraint id="904fa159-f97d-5393-9fb7-d6e6a5ad3de0" field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max"/>
      </constraints>
      <rules>
        <rule id="922f0ab2-3532-5b4f-878d-c4e1aacfb651" name="Adjusted Tactics" hidden="false">
          <description>During Deployment, models may swap weapons for legal options of equal or lesser point cost.</description>
        </rule>
        <rule id="5043fdfc-c231-5a71-bf9c-3d38e0178e3b" name="Bolter Discipline" hidden="false">
          <description>Stationary models always count as in half range with Rapid Fire Bolter weapons.</description>
        </rule>
        <rule id="6bf9e254-cfad-555b-9542-6bb41ade791d" name="Know No Fear" hidden="false">
          <description>Automatically passes Pinning, Rally, and Fear Tests.</description>
        </rule>
        <rule id="9c380f8d-3247-50e6-ae11-68aaa8e2b9b6" name="Wrist Mount" hidden="false">
          <description>May fire in Melee as if Monstrous Infantry and may still Declare Charges after firing.</description>
        </rule>
        <rule id="866ee878-df55-5712-a5b6-56c75c05b13d" name="Tactical Squads" hidden="false">
          <description>May split (min 2 models) or merge during your Command Phase.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup id="9a3fa9fb-dea9-5ae9-b353-30184a3048f3" name="Select Brotherhood" hidden="false" collective="false" import="true" defaultSelectionEntryId="af65c24c-388e-57b6-aff4-e6c46f154956">
          <constraints>
            <constraint id="3dfa060c-4cf4-534c-9629-a6c8089caf73" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="min"/>
            <constraint id="8296c57f-af92-5241-9ec6-d59cd4bc5169" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
          </constraints>
          <selectionEntries>
            <selectionEntry id="af65c24c-388e-57b6-aff4-e6c46f154956" name="Average Brotherhood" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="6ea26746-84fc-5eb0-926d-abee4e057792" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="f1574f21-f669-5339-b50c-a0e9ee970034" name="Brotherhood: Average Brotherhood" hidden="false">
                  <description>Well Disciplined: Models may reroll 1s To Hit. Auras that allow rerolling 1s To Hit allow failed To Hit rolls of 1 or 2 to be rerolled instead.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="3ac74fa2-30f1-5fd5-ac90-ddc74416ec74" name="Blades of Victory" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="8594d508-d300-54ae-a721-7f47f992d629" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="adff26c9-204f-541c-acd9-d0b43019f041" name="Brotherhood: Blades of Victory" hidden="false">
                  <description>Swift Strike: All models in your army gain Fleet and Hit and Run.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="fc51e395-89bb-57ef-9f9b-12b1a9df0243" name="Exactors" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="b1464386-87c7-5321-af75-b31a59befa32" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="75f023cb-f071-5484-87b7-829ae1adc9f6" name="Brotherhood: Exactors" hidden="false">
                  <description>Oath of Witness: All models in your army gain Ld+2.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="4c6b4b55-0682-51ad-8efa-7bfe38526329" name="Prescient Brethren" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="31b0a23f-c581-53bb-99cd-08119e6e6a98" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="2066d125-3f77-54e1-95d9-adb810586fa4" name="Brotherhood: Prescient Brethren" hidden="false">
                  <description>Foresight: All models gain I+1 and can Redeploy 1 unit per 1000 points after Deployment.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="574785e6-a588-557c-9382-022a3f1fc541" name="Preservers" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="6d41c506-6b58-5a5f-8e0c-c25f509b07cc" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="9a6aff23-0d81-5f22-9dd8-18aa6d544c43" name="Brotherhood: Preservers" hidden="false">
                  <description>Charge of the Ancients: Dreadnoughts can be taken as Troop Slots. All Dreadnoughts and Ironclad Dreadnoughts gain Objective Secured.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="18d754c9-218f-5b73-a23e-7bcecd45adf0" name="Rapiers" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="55db7c0d-e4d3-52e9-b370-ad37ad1798e1" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
