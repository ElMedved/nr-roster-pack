        <rule id="0ba431eb-85d8-51a1-a8a1-0bd5ad3b1110" name="Remote Explosive" hidden="false">
          <description>This weapon cannot make Snap Shots of any kind including Overwatch. When this weapon is used, select one piece of Terrain and place a marker in it. During your next Command Phase, resolve the attack on the marker without Scattering the template.</description>
        </rule>
      </rules>
