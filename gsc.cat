  <sharedSelectionEntries>
    <selectionEntry id="846dfb97-7f6d-5408-bbef-92aafea82dff" name="Cult &amp; Army Rules" publicationId="8f0416a2-9eed-58e5-a364-e131695396ba" page="2" hidden="false" collective="false" import="true" type="upgrade">
      <constraints>
        <constraint id="364b7420-3ee5-5608-9ca0-e52905b5b243" field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="min"/>
        <constraint id="31265d78-e81f-5f50-987f-c689fe5e1275" field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max"/>
      </constraints>
      <rules>
        <rule id="e60122df-a0fb-54a2-9c98-e0ea6c3fbf06" name="Emergence Hole #" hidden="false">
          <description>Place up to # Emergence Holes on Terrain pieces during Deployment; hold 1 Infantry/Monstrous Infantry unit in Reserve per Hole to disembark from any Hole.</description>
        </rule>
        <rule id="4dd35813-ab75-5a29-ab9b-94833a264d26" name="Unquestioning Loyalty" hidden="false">
          <description>6" Aura: Friendly unit gains Bodyguard triggering on a 4+.</description>
        </rule>
        <rule id="bcb3e722-0a14-55a2-9169-fd137a97343c" name="Blasphemous Preaching" hidden="false">
          <description>6" Aura: Target unit counts as half as many models for Contesting Objectives.</description>
        </rule>
        <rule id="a3ecf3de-77b6-51ec-81f7-38f864fb49ec" name="Poor Maintenance &amp; Limited Ammo" hidden="false">
          <description>Looted vehicles roll d6 in Command Phase (on 1 Move OR Shoot) and cannot fire Overwatch/Snap Shots.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup id="efc7c3a1-eaaf-5f42-8354-70fc25cd7cd1" name="Select Cult" hidden="false" collective="false" import="true" defaultSelectionEntryId="09dd8e8f-18e6-5ba9-af08-6078ca13ed92">
          <constraints>
            <constraint id="97b9f032-e542-5b70-b0bd-acba6980edfd" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="min"/>
            <constraint id="33af653e-2bbb-5ff9-90a4-3262a4d91201" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
          </constraints>
          <selectionEntries>
            <selectionEntry id="09dd8e8f-18e6-5ba9-af08-6078ca13ed92" name="Cult (Standard)" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="b4cb32bd-7788-5acc-ae39-8f8c3f67fbf9" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="04a4b136-897a-5f90-93bd-d62a417cc2ff" name="Cult: Cult (Standard)" hidden="false">
                  <description>Just your average army; use models exactly as presented on their datasheets.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="02bf05bf-816e-5be0-906f-a823b2692b5b" name="Bladed Cog" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="0952f8b2-9adf-5120-9acb-fbc05fcbc5e3" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="f3ca610f-7aed-51c6-89cc-fd91aee5edd0" name="Cult: Bladed Cog" hidden="false">
                  <description>Cyber Augmetics: T3 models gain T+1, M-2. T4 models gain T+1, M-2, Ld-1, and must reroll successful Charge rolls.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="931cdf3c-d80a-5b8b-aa28-3b650bb1af98" name="Four-Armed Emperor" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="50acfd58-4ba7-5d3b-82e1-f30bbbb2db2a" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="5d6b20cd-3043-5532-a0bf-1869725cf911" name="Cult: Four-Armed Emperor" hidden="false">
                  <description>• Subterranean Ambushers: Infantry and Monstrous Infantry gain Stealth (or Shroud if already Stealth).
• Masterful Strike: All Infantry and Monstrous Infantry must be held in Reserve during Deployment.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="45d74642-8fc0-5ea2-a204-9a0f1a2ea0be" name="Hive Cult" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="82b20850-52c2-5e82-9b80-86fef4c73c60" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="963ef00a-409f-5883-9426-45bdd99e2440" name="Cult: Hive Cult" hidden="false">
                  <description>• Disciplined Militants: All models gain Stubborn.
• Hellbent on Conquest: Cannot Contest or Claim Objective Markers within your Deployment Zone.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="5664e577-ff5c-5578-8226-56f598b2a2f0" name="Pauper Princes" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="d23440a1-2243-5ff9-9a8b-aaa2a624b920" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="82adbc70-6956-53c5-acfb-a09ef48b7703" name="Cult: Pauper Princes" hidden="false">
                  <description>• Devoted Zealots: Models count as twice as many for Contesting Objective Markers.
• Fanaticism: Must Declare Charges if within Charge Range and legal.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="644c0529-c309-53de-8b09-4f1cfdd0de78" name="Rusted Claw" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="7442ca46-ad91-5a02-afe0-12f44b4b2d0f" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
