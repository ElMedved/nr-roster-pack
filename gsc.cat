    <selectionEntry id="c3da4f13-b37c-5bab-8886-320ec2d60cfe" name="Hive Tunnel Complex" publicationId="8f0416a2-9eed-58e5-a364-e131695396ba" page="82" hidden="false" collective="false" import="true" type="unit">
      <profiles>
        <profile id="a00d5d16-ddaf-516a-8d42-91951f8eba20" name="Unit Composition" hidden="false" typeId="35b65644-1892-5b82-90c0-20981913471e" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="83d81002-a330-5968-9552-22dcb2ed8516">Points: * Composition: 16+ Emergence Holes</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="f262780f-134f-5c9f-bbb8-9554963b0edb" name="Hive Tunnel Complex" hidden="false">
          <description>Place one Emergence Hole on each Terrain piece on the Table. This costs the Length of the Battlefield x the Width the of the Battlefield in feet x 15 points. A Typical 4x6 will cost 360 points for example.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry id="4d9e1f46-f78e-5e2b-91c4-e8818f211c92" name="Battlefield Area (15 pts per sq ft, e.g. 24 for 4x6 = 360 pts)" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint id="c8ffe942-6b9a-52d1-9bbe-d4f3fed4804d" field="selections" scope="parent" value="0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="min"/>
            <constraint id="f2bf8f68-23bf-5514-bfde-87884fbe4ab4" field="selections" scope="parent" value="64" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
          </constraints>
          <profiles>
            <profile id="b7f43887-38c2-5cb5-b566-b5d47202c47c" name="Battlefield Area (15 pts per sq ft, e.g. 24 for 4x6 = 360 pts)" hidden="false" typeId="ac5ce483-3b55-59be-afc5-de14cfb350f6" typeName="Wargear">
              <characteristics>
                <characteristic name="Description" typeId="1c2f4080-02ec-5486-826a-4d2299dd0bb1">Costs Length x Width of Battlefield in feet x 15 points.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="15"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
