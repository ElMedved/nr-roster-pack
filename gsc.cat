                <profile id="57f08971-06c1-5c4d-8767-3e0ad70237b5" name="Smoke Launchers" hidden="false" typeId="ac5ce483-3b55-59be-afc5-de14cfb350f6" typeName="Wargear">
                  <characteristics>
                    <characteristic name="Description" typeId="1c2f4080-02ec-5486-826a-4d2299dd0bb1">6" range, put 5" Smoke Cloud that causes -1 to Hit and scatters to move an extra +1" until your Command Phase. One Use Only. Use in your Shooting Phase Only.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="pts" typeId="points" value="10"/>
              </costs>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
