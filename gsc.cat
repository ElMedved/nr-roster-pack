                  <description>• Mechanized Specialists: Vehicles gain M+2.
• Nomads: Models count as half for Contesting Objective Markers.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="4b3ae011-3882-594b-a19c-cea16be18fbb" name="Twisted Helix" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="376fc5da-7ddd-5f22-a139-ffeb4eb9f520" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="7fdee763-b24a-597b-ba39-6eb20d798676" name="Cult: Twisted Helix" hidden="false">
                  <description>Deranged Bioengineering: Infantry and Monstrous Infantry gain 5+ Feel No Pain (or reroll 1s if already FNP), suffer Ld-3, and must Declare Charges against closest enemy if in range.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
