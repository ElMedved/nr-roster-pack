          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="1ef1d769-5208-5a80-b42e-c9e7e63b8d51" name="Ferocious Strategist" hidden="false">
          <description>During Deployment, nominate one friendly Slot (not category) holding in Reserves. Units in this Slot cannot be Pinned when arriving by Deepstrike, event if they normally would be.</description>
        </rule>
        <rule id="534347c0-c54c-59b8-a2f0-ca9448d60aff" name="Lord Solar" hidden="false">
          <description>6” Aura, this model and target unit may reroll 1s To Hit and To Wound.</description>
        </rule>
      </rules>
