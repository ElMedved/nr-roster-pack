      <selectionEntries>
        <selectionEntry id="fd029aa9-1e6f-565d-8e41-fb6cbf82a5cb" name="Additional Gate &amp; 2 Gate Towers" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint id="518a25fd-30d5-584f-a311-0ac8f79beb58" field="selections" scope="parent" value="0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="min"/>
            <constraint id="7fb0ac49-4533-5613-9b52-e1560a04bc66" field="selections" scope="parent" value="10" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
