      <rules>
        <rule id="09f7db31-ef02-511d-8c4f-0452f888b236" name="Behemoth Shells" hidden="false">
          <description>When the Heavy Colossus Siege Mortar fires, it must forgo Shooting in its next Shooting Phase. The Heavy Colossus Siege Mortar may not fire on Turn 1. It may fire its other weapons normally on each Turn. This model suffers M-8.</description>
        </rule>
