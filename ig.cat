        <profile id="63235415-2a8a-528b-8abd-8f014335647a" name="Armour of the Warmasters" hidden="false" typeId="ac5ce483-3b55-59be-afc5-de14cfb350f6" typeName="Wargear">
          <characteristics>
            <characteristic name="Description" typeId="1c2f4080-02ec-5486-826a-4d2299dd0bb1">This model has a 4+ Invulnerability Save and cannot be targeted with Spells. If this model’s unit is affected by a Spell, this model is immune.</characteristic>
          </characteristics>
        </profile>
        <profile id="0816a437-e178-5300-8cf8-ba3411f2f65b" name="Command Stave" hidden="false" typeId="ac5ce483-3b55-59be-afc5-de14cfb350f6" typeName="Wargear">
          <characteristics>
            <characteristic name="Description" typeId="1c2f4080-02ec-5486-826a-4d2299dd0bb1">This model is always considered to be equipped with a Vox Caster and has the range of its Orders extended up to 18” instead of the usual 12”.</characteristic>
          </characteristics>
        </profile>
        <profile id="229d10d4-6232-575f-9c9b-310d17c7b767" name="Crimson Cloak" hidden="false" typeId="ac5ce483-3b55-59be-afc5-de14cfb350f6" typeName="Wargear">
          <characteristics>
            <characteristic name="Description" typeId="1c2f4080-02ec-5486-826a-4d2299dd0bb1">12” True Aura, this model and all friendly units gain A+1 and may reroll failed Ld Tests.</characteristic>
          </characteristics>
        </profile>
        <profile id="a2b49237-e141-5623-aecf-609dfcb4b869" name="Helm of Macharius" hidden="false" typeId="ac5ce483-3b55-59be-afc5-de14cfb350f6" typeName="Wargear">
          <characteristics>
            <characteristic name="Description" typeId="1c2f4080-02ec-5486-826a-4d2299dd0bb1">12” True Aura, all friendly units may use this model’s Ld and Stubborn rules.</characteristic>
          </characteristics>
        </profile>
