      <rules>
        <rule id="638f534f-ab54-573e-b863-4462e9051fee" name="Repair" hidden="false">
          <description>Target model in base contact Repairs 1 Wound. Roll a d6, on a 5+ restore service for one Weapon Disabled, Crew Shaken, Immobilized, or Weapon Destroyed.</description>
        </rule>
        <rule id="8587a6b5-2b20-58cd-b380-d7b42d8f9d56" name="Lobotomized" hidden="false">
          <description>This model has a 5+ Feel No Pain.</description>
        </rule>
      </rules>
