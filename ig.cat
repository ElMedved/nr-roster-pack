      <rules>
        <rule id="8bfb1d81-8b29-5640-bbed-5d9aac4708c6" name="Imperial Navigator" hidden="false">
          <description>This model and his unit gain Outflank and may reroll the Outflank Result.</description>
        </rule>
        <rule id="89802882-3e91-5299-88e3-8494fe2b8b1e" name="Navigator House Contracts" hidden="false">
          <description>6” Aura, target unit loses Objective Secured. If no models had Objective Secured, the unit counts as only half the total models for Contesting Objective Markers.</description>
        </rule>
