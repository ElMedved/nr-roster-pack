      <rules>
        <rule id="9af24f01-8835-5668-8d0c-42c63e28cba8" name="Cadian Shock" hidden="false">
          <description>Unit keyword / faction rule.</description>
        </rule>
        <rule id="d45ce4c4-7cfa-595a-ba65-913c724c1f5e" name="Mechanized Regiment" hidden="false">
          <description>6” Aura, this model and target unit may charge as if the Transport they disembarked from this turn had Assault Ramps.</description>
        </rule>
        <rule id="8304b2d7-0b9a-59ad-bd14-01fe9ad39a3f" name="Guns Blazing" hidden="false">
          <description>Colonel Snake Stranski may reroll To Hit rolls with his 2 Plasma Pistols. He may also fire from his Chimera Turret Hatch without using Fire Ports.</description>
        </rule>
        <rule id="1bcac964-8831-57e0-a563-48a64a825028" name="Transport 12" hidden="false">
          <description>Access Sides and Rear. 2 360 Fire Ports.</description>
        </rule>
        <rule id="8490bb14-af7c-5e91-a949-732cc90ff01f" name="Command Tank" hidden="false">
          <description>Colonel Snake Stranski and his Command Squad cannot leave the Chimera unless it is destroyed.</description>
        </rule>
      </rules>
