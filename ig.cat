      <rules>
        <rule id="29ba62c9-b125-5dec-9792-f4cf11654526" name="Inspiring Presence" hidden="false">
          <description>Orders from this model have a 24” radius. All units testing on Orders cast from this model may use this model’s Ld in place of their own.</description>
        </rule>
        <rule id="78917b35-7679-5d63-86c0-693f765f7ca4" name="Transport 100" hidden="false">
          <description>Access Rear. 20 Firing Ports each Side, 10 Firing Ports Rear.</description>
        </rule>
        <rule id="0f830382-1846-5540-a921-8cadbdddb697" name="Create Panic" hidden="false">
          <description>This model displaces all models when it moves, place them up to 1” Away. Immobile units prevent this model from moving there.</description>
        </rule>
        <rule id="30853ff4-218d-50ce-aa20-4362feda4b08" name="Immense Bulk" hidden="false">
          <description>This model may only Pivot up to its current M value. It may still move as normal.</description>
        </rule>
      </rules>
