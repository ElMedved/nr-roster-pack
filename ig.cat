  <sharedSelectionEntries>
    <selectionEntry id="bf459476-684e-5a7e-9471-77b4fe396434" name="Regiment &amp; Orders" publicationId="50376eb2-bc9d-5b8c-8a0e-dbd1061bc659" page="4" hidden="false" collective="false" import="true" type="upgrade">
      <constraints>
        <constraint id="d5f185cf-b552-55dd-8ce3-dbf00d95b30f" field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="min"/>
        <constraint id="3cd2530d-c086-50d3-8723-d8d0f18a7c68" field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max"/>
      </constraints>
      <rules>
        <rule id="34745082-2eba-54e3-b43b-e78e3f6e58c0" name="Imperial Guard Orders &amp; Vox Casters" hidden="false">
          <description>Orders are issued as True Auras (12" radius unless specified) at the start of the Shooting Phase. Nominate one eligible unit type (e.g. Veterans) and roll 2d6 against the highest Ld in each unit of that type in range. If equal or under, the unit receives the order. No unit may benefit from the same order more than once per phase.

Vox Casters: Reroll failed Order tests if both the officer's unit and the receiving unit have a Vox Caster (all Vehicles and Monsters count as having a Vox Caster).</description>
        </rule>
        <rule id="45e83f4b-e2c9-5fcd-8cce-271865b5981a" name="Infantry Orders" hidden="false">
          <description>May affect Command Squads (all variants), Veterans, Guardsman Squads, Special Weapon Squads, Heavy Weapon Squads, Conscripts, or Stormtroopers:
1) First Rank Fire! Second Rank Fire!: +1 extra shot with Lasgun, Hellgun/Hotshot Lasgun, or Regimental Lasgun.
2) Bring it Down!: Reroll 1s To Wound or Penetrate this Shooting Phase.
3) Get Back in the Fight!: Rally if fleeing OR remove Fear effect.
4) Move! Move! Move!: Gain Fleet for the Shooting Phase.
5) Incoming!: Become Pinned at the end of the Shooting Phase with an extra +1 Cover Save.
6) Repel the Line!: May fire as if not engaged in melee (must target engaged enemy unit; cannot overlap friendly models with templates).</description>
        </rule>
        <rule id="32ec97e6-60a7-5890-998f-919ea53ae5fe" name="Tank Orders" hidden="false">
          <description>May be issued to any Vehicle datasheet with the Tank keyword:
1) Bring it Down!: Reroll 1s To Wound or Penetrate this Shooting Phase.
2) Get Back in the Fight!: Rally if fleeing OR remove Fear effect.
3) Shoot and Scoot!: Move d6" at the end of the Shooting Phase.
4) Incoming!: Become Pinned at the end of the Shooting Phase with an extra +1 Cover Save.
5) Grind them to Dust!: Reroll 1s To Hit in your upcoming Assault Phase this Round.
6) Scratch my Back!: Fire S5 or lower weapons into a melee involving a friendly Tank (no friendly Infantry/Monstrous Infantry); natural 1s To Hit strike your own unit.</description>
        </rule>
        <rule id="ee9aa60c-5ea5-5d5a-9138-1220d83b826f" name="Wing Orders" hidden="false">
          <description>May be issued to any Vehicle datasheet with the High Altitude rule:
1) Bring it Down!: Reroll 1s To Wound or Penetrate this Shooting Phase.
2) Strafing Run!: Ignore AA rule on weapons/datasheet this Shooting Phase.
3) Scramble!: Gain AA on all weapons this Shooting Phase.
4) Barrel Roll!: Gain 5+ Invulnerability Save OR reroll 1s on Invulnerability Saves until next Command Phase.
5) Immelmann!: Turn 180 degrees; must reroll 6s on Invulnerability Saves until next Command Phase.
6) High Side Guns Pass!: Fire from position BEFORE moving this turn.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup id="4b11aa66-d799-54ac-8159-63295ea74dd4" name="Select Regiment" hidden="false" collective="false" import="true" defaultSelectionEntryId="ef7aec57-0269-58a8-85ef-59e2032cf862">
          <constraints>
            <constraint id="8b39febf-2723-5ca6-9510-4ffbe10efaa7" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="min"/>
            <constraint id="3a85c3ba-a72b-57bc-a9b2-5bfb5d066b9f" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
          </constraints>
          <selectionEntries>
            <selectionEntry id="ef7aec57-0269-58a8-85ef-59e2032cf862" name="PDF (Planetary Defense Force)" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="c0af47e1-9f87-5f08-9e15-eac9ae13af45" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="9a4a9f90-b146-59a0-bd10-16a0150aea7a" name="Regiment: PDF (Planetary Defense Force)" hidden="false">
                  <description>This regiment uses the rules for models stated exactly as they are in the Imperial Guard Codex.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="81104321-bd50-5e51-a592-da8e73215a5f" name="Armageddon Steel Legion" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="1bd6650d-b036-5c3e-b932-f56cd4ffba62" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="360bb422-5412-576a-91f8-680422ed595e" name="Regiment: Armageddon Steel Legion" hidden="false">
                  <description>• Mechanized Infantry: Infantry units gain a 5+ Cover Save the Turn they Disembark from a Transport (Forced Disembark does not provide this Save).
• Hive City Inhabitants: All Infantry suffer -1 Cover Save if it is not provided by a building, fortified terrain piece, or Mechanized Infantry.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="5d7ef939-92db-5e6a-82c9-d21cf1401c9e" name="Cadian Shock" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="e4576eb7-7b5f-58f7-8bc7-914c78038201" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="23fa0225-87de-520b-9e0f-39a4ba6a9a52" name="Regiment: Cadian Shock" hidden="false">
                  <description>• Imperial Guard's Finest: All models may reroll 1's To Hit with ranged weapons.
• No Place to Call Home: Each model only counts as half a model for the purpose of Contesting Objectives.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="63eb182a-0930-54ff-84a7-64e725e857f4" name="Catachan Jungle Troops" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="415aec8e-85ac-53f4-a7b6-8f7cf6a216c9" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="e87885b4-bf9d-5dc0-b974-efc28e3f7aca" name="Regiment: Catachan Jungle Troops" hidden="false">
                  <description>• Carbines: All Lasguns and Hotshot Lasguns are Range -6".
• Catachan Fangs: All Infantry and Monstrous Infantry gain: Catachan Fang (Range: Melee, S: +1, AP: -, Rules: None).
• Flak Vests: All Infantry and Monstrous Infantry Datasheets are Sv+1 (1 worse Armour Save) except Unique characters.
• Jungle Grit: All T3 Infantry gain T+1 (models with Bold already have this baked into their profile).</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="db05a7eb-02e7-5362-8806-0e65a88567f6" name="Death Korp of Krieg" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="b2c31729-5113-5dbc-a0a4-fe250ae5c07d" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="691ac371-8f1c-5735-aaa4-780bd9933b16" name="Regiment: Death Korp of Krieg" hidden="false">
                  <description>• Trenching Tools: All Infantry and Monstrous Infantry gain Trenching Tool (Range: Melee, S: User, AP: -, Rules: Extra Attack 1).
• Command Dependent: All models gain Stubborn, but may only Move, Advance, or Charge when a friendly HQ or Advisor Slot is within 12".
• Lucius Pattern: All Lasguns use the following profile instead of standard Lasgun: Range 24", S4, AP-, Assault 1.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="e1276dec-901b-53de-b1ab-04a7825b4e40" name="Elysian Drop Troops" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="d7c39a3d-3a4e-5f1e-a0d0-e74fbbd60c0e" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="97f84931-85c4-5b39-a35d-a52360045dba" name="Regiment: Elysian Drop Troops" hidden="false">
                  <description>• Airborne Specialists: All non-Vehicle models gain Deepstrike (if they already have Deepstrike, they may reroll Deepstrike scatter dice).
• Paratrooper Loadout: Each model only counts as half a model for contesting objectives.
• Skyborne Division: Every model with Deepstrike or Outflank must be held in reserve during army deployment.
• Air Superiority: Lose all Heavy Support Slots and gain +1 Flyer Slot. May not take any Lord of War that does not have High Altitude.
• Accatran Pattern Lasgun: All Lasguns are replaced with: Range 12", S3, AP-, Assault 2.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink id="ad9a7e51-6008-52c0-8691-5201d18c8337" name="Elysian Air Superiority" hidden="false" targetId="e4d29378-aeab-548d-a1cf-6032ae02ab92" primary="false"/>
              </categoryLinks>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="2654f38e-5c37-5839-a52a-95598995d94d" name="Mordian Iron Guard" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="a7381471-0e3e-518f-9ed1-7143e33038bf" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="add5ac3f-730d-56af-8c22-ef300a701da3" name="Regiment: Mordian Iron Guard" hidden="false">
                  <description>• Hive City Inhabitants: All models suffer -1 Cover Save unless provided by a Building or Fortified Terrain Piece.
• Command Dependent: All models gain Stubborn, but may only Move, Advance, or Charge when a friendly HQ or Advisor Slot is within 12".
• Crowd Control: All models Overwatch on a 5+ (Pistols Overwatch on a 4+; other Snap Shots remain 6+).
• Triplex Pattern Lasgun: All Lasguns gain an optional profile in addition to standard Lasgun: Range 12", S5, AP-, Heavy 1, Gets Hot!</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="37147545-17c9-56d6-9733-3c7ed4bb44a1" name="Praetorian Guard" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="d9df9a52-be5e-5e3d-8b09-6770fe2e1772" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="c18804b2-272d-5b33-b8af-316af735b206" name="Regiment: Praetorian Guard" hidden="false">
                  <description>• Tally Ho!: All models may reroll failed Charge rolls.
• Command Dependent: All models gain Stubborn, but may only Move, Advance, or Charge when a friendly HQ or Advisor Slot is within 12".</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="842c2080-4187-5800-a61d-c459b1b290d9" name="Tallarn Desert Raiders" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="a1cb2dc7-0fd8-5507-9a0b-25067bcaa9ea" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="356c1a36-7736-5551-92bb-e59f6f4752a1" name="Regiment: Tallarn Desert Raiders" hidden="false">
                  <description>• Like the Wind: All non-Vehicle models gain Stealth (models already with Stealth gain Shroud).
• Desert Specialists: All non-Vehicle Sv stats become Sv -.
• Strike and Fade: All models automatically lose Combat Resolution.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="6ee84e93-1d13-5851-8a01-98665e8fd8ec" name="Tanith First and Only" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="069b2ca0-645d-5e09-af7b-de5188a8ae0f" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="1c42f40e-5006-5d8d-88ae-39ee9cbc5f80" name="Regiment: Tanith First and Only" hidden="false">
                  <description>• Camo Cloaks: All Infantry models gain Stealth (does not affect Monstrous Infantry).
• Stealth Armour: All Infantry Datasheets are Sv+1 (1 worse Armour Save; does not affect Monstrous Infantry or Unique characters).
• No Place to Call Home: Each model only counts as half a model for contesting objectives.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="58e2ae47-d4d6-5e73-880d-569651521a65" name="Valhallan Ice Warriors" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="a96dc81f-935d-5d88-8290-1c825ffa75fb" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="eb57c610-e8ef-5816-a9ea-34ea9c927f3f" name="Regiment: Valhallan Ice Warriors" hidden="false">
                  <description>• Command Dependent: All models gain Stubborn, but may only Move, Advance, or Charge when a friendly HQ or Advisor Slot is within 12".
• Poorly Equipped: All Infantry and Monstrous Infantry models' Sv stats become Sv - (does not affect Unique characters).
• Acceptable Losses: Any unit may test Ld to shoot into close combat with friendly models involved. If passed, they may place Flame and Blast templates over friendly models this turn; natural 1s To Hit strike a random friendly unit in that melee.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="087c6b6f-b256-518b-8635-1371802a9922" name="Vostroyan First Born" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="43253b84-4fc5-5887-8fac-4f8f783320ca" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="e684b660-fca6-54ff-9cdf-2353cae77a57" name="Regiment: Vostroyan First Born" hidden="false">
                  <description>• Family Heirlooms: All Infantry Sv stats become Sv 4+.
• Sins of the Forefathers: All models suffer -1 Ld.
• Kantrael Pattern Lasguns: Replace all Lasgun profiles with: Range 30", S3, AP-, Heavy 2.
• A Life of Servitude: Each model only counts as half a model for contesting objectives.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
    </selectionEntry>
    <selectionEntry id="d6c3d48e-1d02-5818-b677-03b4f6720334" name="Lord Commissar Yarrick" publicationId="50376eb2-bc9d-5b8c-8a0e-dbd1061bc659" page="4" hidden="false" collective="false" import="true" type="unit">
      <constraints>
        <constraint id="f74b96f9-e364-5687-b300-9090bd232b74" field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" type="max"/>
