      <rules>
        <rule id="01aff64d-b61f-5945-b26e-512e78ca387b" name="Cadian Shock" hidden="false">
          <description>Unit keyword / faction rule.</description>
        </rule>
        <rule id="15e31f7b-1a38-5e38-bcd6-26f18ba5e88d" name="Command Staff" hidden="false">
          <description>Any Unique model taken as part of Arminka’s squad may join units with her, ignoring the model count requirement for joining units.</description>
        </rule>
        <rule id="ba73ab62-4ddf-5cc7-9337-5305e152bcc6" name="Defiant" hidden="false">
          <description>Sergeant Arminka Lesk and her unit may never be affected by Auras or True Auras unless it is Orders issued by her.</description>
        </rule>
        <rule id="6907fc7e-7e24-5602-affc-8ccce44a020e" name="Devoted Follower" hidden="false">
          <description>Shand will never Execute Arminka and will Execute the next model in line.</description>
        </rule>
        <rule id="3857f709-c84b-58b4-8dc3-2d243929bdc3" name="Summary Execution" hidden="false">
          <description>once per Round when a friendly Infantry unit fails a Ld test within 6”, you MUST remove the highest Ld model from that unit from the game. Ignore Commissars and Lord Commissars for highest Ld purposes. The unit automatically passes the Ld test. Order Tests do not count for this rule.</description>
        </rule>
        <rule id="3f388aca-8b15-5f49-ac2a-fdcb5a74d936" name="The Emperor Protects" hidden="false">
          <description>6” Aura, this model and target unit gain 5+ Invulnerability Save</description>
        </rule>
        <rule id="d0166518-c134-5e53-b513-f878f0ccce26" name="Mixed Regiments" hidden="false">
          <description>During army creation, you may choose two Regiment rules, but can still only take specific Cadian Units.</description>
        </rule>
        <rule id="d7e718c2-0266-508f-956d-c7b8ddc0b7f2" name="Duty to the End" hidden="false">
          <description>This model has a 5+ Feel No Pain.</description>
        </rule>
      </rules>
