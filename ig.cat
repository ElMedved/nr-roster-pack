        <infoLink id="61d383d3-e976-5d74-83d4-13176a0f1909" name="Independent Character" hidden="false" targetId="daa374d1-a1d8-5baf-b6c0-d3e27bcc4297" type="rule"/>
        <infoLink id="66b96083-d1aa-5abf-af46-b110254bf88e" name="Infantry" hidden="false" targetId="1c63b9cc-d5dc-5e00-99f3-357cdc80505b" type="rule"/>
