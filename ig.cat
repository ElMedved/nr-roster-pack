      <rules>
        <rule id="f34c0f8b-6925-578b-a1c6-747c8da13b20" name="Dead Nerves" hidden="false">
          <description>5+ Feel No Pain</description>
        </rule>
        <rule id="2540c799-cf68-5223-ac0f-53f493b0f19d" name="Loyal to the End" hidden="false">
          <description>If a model uses Execution or Summary Execution to remove an Independent Character from Nord Deddog’s Squad, Nork removes the executioner from the game.</description>
        </rule>
        <rule id="7cd243e0-4ae0-5ef9-90d5-f844971bac54" name="Heroic Sacrifice" hidden="false">
          <description>If Nork Deddog is slain in Melee, inflict d6 S6 AP- Auto Hits on the unit that killed him</description>
        </rule>
      </rules>
