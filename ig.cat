      <rules>
        <rule id="c04774b7-af22-51e7-a212-200fd0f8c51c" name="Catachan Jungle Troops" hidden="false">
          <description>Unit keyword / faction rule.</description>
        </rule>
        <rule id="c79176e6-d0ae-5b01-929a-e1303d2d3b6d" name="Lone Operative" hidden="false">
          <description>This model may not be directly targeted unless the attack is originating from within 12”. Templates may still happen to overlap him.</description>
        </rule>
        <rule id="a835458e-af5f-527b-9b34-dc62612d5f7b" name="Loner" hidden="false">
          <description>Guardsman Marbo may not join units or receive Auras of any kind, including Orders or enemy Auras.</description>
        </rule>
        <rule id="e0c04a9d-ec77-5177-99c5-16a2e9b24b90" name="He’s Behind You!" hidden="false">
          <description>Guardsman Marbo does not scatter when Deepstriking. Marbo may also Deepstrike into base contact. In the Assault Phase, treat this as On-Going Melee.</description>
        </rule>
        <rule id="c1ad567b-dbbf-56aa-9158-f74c18b2c69f" name="Lightning Reflexes" hidden="false">
          <description>3+ Invulnerability Save</description>
        </rule>
        <rule id="b493a4e6-ec4d-5f5a-a451-51b6837c0235" name="Into the Shadows" hidden="false">
          <description>At the end of your Movement Phase, if Marbo is in cover he may be placed back in Reserve. Marbo may not Deepstrike the turn he goes into Reserves.</description>
        </rule>
      </rules>
