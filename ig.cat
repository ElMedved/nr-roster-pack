          <characteristics>
            <characteristic name="Description" typeId="1c2f4080-02ec-5486-826a-4d2299dd0bb1">This model and its unit inflict a -1 to Cover Saves from this unit’s ranged attacks.</characteristic>
          </characteristics>
        </profile>
        <profile id="8ba01010-8b5a-5433-b1f3-97b878dfb234" name="Modified Vox Caster" hidden="false" typeId="ac5ce483-3b55-59be-afc5-de14cfb350f6" typeName="Wargear">
          <characteristics>
            <characteristic name="Description" typeId="1c2f4080-02ec-5486-826a-4d2299dd0bb1">12” Aura, cancel one Aura or True Aura in effect.</characteristic>
          </characteristics>
        </profile>
        <profile id="e4319530-9bc1-516b-a88f-89f4c08d9274" name="Unit Composition" hidden="false" typeId="35b65644-1892-5b82-90c0-20981913471e" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="83d81002-a330-5968-9552-22dcb2ed8516">1 Colonel Schaeffer 1 Animal 1 Brains 1 Demolition Man 1 Fingers 1 Grease Monkey 1 Hero 1 Ox 1 Rocket Girl 1 Scope 1 Shiv 1 Warrior Woman</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="f6c1f722-7ced-5d71-9e2d-dd42f657e2ec" name="13th Penal Legion" hidden="false">
          <description>These models cannot grant or receive Auras or Orders to or from any other unit. They are not affected by any Regiment Rules.</description>
        </rule>
        <rule id="1e99c703-67d9-5c7b-b60d-3f22df07fa63" name="Execution" hidden="false">
          <description>once per Round when a friendly Infantry unit fails a Ld test within 6”, you MUST remove the highest Ld model from that unit from the game. Ignore Commissars and Lord Commissars for highest Ld purposes. The unit may reroll the Ld test. Order Tests do not count for this rule.</description>
        </rule>
        <rule id="0e77a186-ab35-5526-b841-907c955bce40" name="Savage" hidden="false">
          <description>This model and his unit may declare Charges after Advancing or Disembarking.</description>
        </rule>
        <rule id="0df69d98-45ab-5e6c-aab1-94a48e2b3026" name="Jerry Rigger" hidden="false">
          <description>Repair d3 Wounds, on a 4+, restore a Weapon Disabled, Crew Stun, Immobilize, or Weapon Destroyed Result.</description>
        </rule>
        <rule id="37c5bb36-0d18-512e-a1c9-33f3b60e5aff" name="Demolition Expert" hidden="false">
          <description>This model and his unit’s Blast Templates never Scatter and may reroll 1s To Wound.</description>
        </rule>
        <rule id="7bec45d0-0c1e-512a-9b81-1811796a7edc" name="Rocket Loader" hidden="false">
          <description>Rocket Girl may fire 1 additional time each time she is nominated to shoot.</description>
        </rule>
        <rule id="ea9e9ce8-4de1-5081-89b9-d654323028f8" name="Hijacker" hidden="false">
          <description>When Assaulting a Vehicle, roll a d6 before attacking. On a 5+ take control of the target Vehicle so long as it has Transport 10+ and immediately Embark regardless of Transport size. Use BS3+ for this Vehicle. If there are any Embarked units onboard, they must perform a Forced Disembark after Schaeffer’s Last Chancers Embark.</description>
        </rule>
        <rule id="6350e5c9-09e2-540c-8141-6d82d61e7cf9" name="Last Chance" hidden="false">
          <description>This model gains a 3+ Feel No Pain when taking Wounds on behalf of the Squad willingly.</description>
        </rule>
        <rule id="8f1494ca-f62a-570e-9efc-3258141a5b8f" name="Suppressive Fire" hidden="false">
          <description>Ranged attacks by Ox gain Grav.</description>
        </rule>
        <rule id="65c722fa-6919-578c-90a8-e143db2ebf4b" name="Tank Buster" hidden="false">
          <description>This model gains Armourbane when using a Missile Launcher.</description>
        </rule>
        <rule id="5c2a209f-0c13-5c5f-bb78-a4fb0bb32049" name="Deadeye" hidden="false">
          <description>models taking Pinning Tests inflicted by this model take the test at Ld-3.</description>
        </rule>
        <rule id="b2824d0a-687b-5967-ad68-f20b3cdb6401" name="Stealth Attack" hidden="false">
          <description>This model and his unit gain Furious Charge and Shock Assault.</description>
        </rule>
        <rule id="e991e298-0230-5a62-b70a-8393e3bde42a" name="Way of the Warrior" hidden="false">
          <description>This model’s and her unit may change their Weapon # to Pistol # and Overwatch at their BS#+ instead of the usual Overwatch #+. No model may fire more than 2 weapons as Pistols each (and removes the normal Grenade restrictions).</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="310f8b0d-89ec-50e0-8eba-c06686fc4a13" name="Character" hidden="false" targetId="7b8f8d5b-7400-5ecf-aa3b-85454ff25e7d" type="rule"/>
