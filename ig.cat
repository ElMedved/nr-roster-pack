      <rules>
        <rule id="445ae056-c8b8-5776-abd5-53baa9e9a6ba" name="Aura of Discipline" hidden="false">
          <description>6” Aura, unit may use Commissar’s Ld and gains Stubborn</description>
        </rule>
        <rule id="d3fe05ee-02bc-5ca1-b084-fbc153350725" name="Execution" hidden="false">
          <description>once per Round when a friendly Infantry unit fails a Ld test within 6”, you MUST remove the highest Ld model from that unit from the game. Ignore Commissars and Lord Commissars for highest Ld purposes. The unit may reroll the Ld test. Order Tests do not count for this rule.</description>
        </rule>
      </rules>
