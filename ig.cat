      <rules>
        <rule id="47a7e37a-ca94-53e5-a751-14802150f5e5" name="Transport 12" hidden="false">
          <description>Access Rear Konig 9th Heavy Tank Company – This model ignores the Regimental rules for your army.</description>
        </rule>
        <rule id="62090c3f-99b5-5aac-8488-eb34ef5ae0a4" name="Hardened Crew" hidden="false">
          <description>This model ignores Immobilize and Weapon Disabled results on a 4+. Roll for each instance.</description>
        </rule>
        <rule id="1f1afbe1-6e49-5174-9b09-4484f0dbc7fc" name="Ill Fated" hidden="false">
          <description>Arethusa still destroys non-Titanic Terrain when moving through Terrain like normal, but must roll a d6 each time it does so. On a 1 it is stuck for the rest of the game.</description>
        </rule>
      </rules>
