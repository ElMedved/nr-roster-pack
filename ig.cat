      <rules>
        <rule id="23bb76dd-116b-5cb0-bdf8-fa854eb60e71" name="Hacking Advance" hidden="false">
          <description>Each natural 6 Grotfret rolls To Hit in Melee generates one Auto Hit.</description>
        </rule>
        <rule id="3f41d927-b96d-5ccd-85be-ad6f46a84b47" name="Shield of Faith" hidden="false">
          <description>Grotfret may attempt to Deny the Witch once per Round at Psychic Mastery 0.</description>
        </rule>
