        <profile id="46eb7b0f-a972-5015-b2f2-15c302ea1f93" name="Unit Composition" hidden="false" typeId="35b65644-1892-5b82-90c0-20981913471e" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="83d81002-a330-5968-9552-22dcb2ed8516">1 Platoon Command Squad (1 Platoon Commander, 4 Veterans each) 2-5 Guardsman Squads (1 Sergeant and 9 Guardsmen each) 0-2 Special Weapon Squads (6 Guardsmen each) 0-5 Heavy Weapon Squads (3 Heavy Weapon Teams each) 0-1 Conscript Squads (20-50 Conscripts each)</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="8b7b00dd-96a0-58ee-b041-abfc2945954a" name="Infantry Tactics" hidden="false">
          <description>During Deployment, you may combine any number of Guardsman Squads together from the same Platoon to form a larger Guardsman Squad. The effect lasts until the end of the game. Combined Squads may only benefit from the following Friendly Auras and abilities: Infantry Orders, Execution, Summary Execution.</description>
        </rule>
      </rules>
