      <rules>
        <rule id="86a0c451-4f36-5ce5-ba07-14e728deb851" name="Aura of Discipline" hidden="false">
          <description>6” Aura, unit may use Lord Commissar’s Ld and gains Stubborn.</description>
        </rule>
        <rule id="dd8e5c92-9dd5-5c14-8f09-0328956cfac9" name="Summary Execution" hidden="false">
          <description>once per Round when a friendly Infantry unit fails a Ld test within 6”, you MUST remove the highest Ld model from that unit from the game. Ignore Commissars and Lord Commissars for highest Ld purposes. The unit automatically passes the Ld test. Order Tests do not count for this rule.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="0d87747e-f8b0-5dc6-8008-17ab63e56dd7" name="Independent Character" hidden="false" targetId="daa374d1-a1d8-5baf-b6c0-d3e27bcc4297" type="rule"/>
        <infoLink id="3a76e3f2-fe32-572b-a03a-01eee5827805" name="Infantry" hidden="false" targetId="1c63b9cc-d5dc-5e00-99f3-357cdc80505b" type="rule"/>
        <infoLink id="ac2e18d1-13b7-5a89-aa6d-cf8ef240cea6" name="Stubborn" hidden="false" targetId="39b9e921-bbee-560e-b4b3-27a92ef9eab0" type="rule"/>
      </infoLinks>
