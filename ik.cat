  <sharedSelectionEntries>
    <selectionEntry id="19c86715-0582-59e0-a612-e35c00da75c2" name="Knight Household &amp; Army Rules" publicationId="3d2c2ae9-cf4f-5638-87a2-247cd9f4ed4d" page="2" hidden="false" collective="false" import="true" type="upgrade">
      <constraints>
        <constraint id="270b8d9c-45da-5b6d-871b-2abc3a4e22eb" field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="min"/>
        <constraint id="690aa3ff-8980-57c0-88e5-1a82a28a581b" field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max"/>
      </constraints>
      <rules>
        <rule id="51b2bdc4-bb5b-5d1f-988d-08249997cd86" name="Imperial God Engine" hidden="false">
          <description>Ignores Swarms, Infantry, and Monstrous Infantry when Moving.</description>
        </rule>
        <rule id="5aa8c42a-8eb2-53a6-9033-d7d22659b7e2" name="Rotate Ion Shields" hidden="false">
          <description>5+ Invulnerability Save against either Ranged OR Melee attacks (declare in Command Phase).</description>
        </rule>
        <rule id="bb428173-a822-518d-9f8c-58e7a444e1e5" name="Honour Bound Protector / Knight Protector" hidden="false">
          <description>May be fielded in Imperial armies as a Heavy Support or Lord of War slot.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup id="c7fb76be-e178-5ad6-9663-4c35fce6b5fb" name="Select Knight Household" hidden="false" collective="false" import="true" defaultSelectionEntryId="cfedf5cb-9efa-5337-a4d4-fcb8e68e699d">
          <constraints>
            <constraint id="97457885-dd4a-5c1d-86d9-fbb50ea51e1d" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="min"/>
            <constraint id="8e82dece-cd85-5771-a563-93ccd129f877" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
          </constraints>
          <selectionEntries>
            <selectionEntry id="cfedf5cb-9efa-5337-a4d4-fcb8e68e699d" name="Free Lancers" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="9b40c909-3a8c-5cab-ab6c-3a08a2eb55ba" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="db8fd2f0-89b6-5e4b-a770-958e0b481e60" name="Knight Household: Free Lancers" hidden="false">
                  <description>Unyielding Fealty: All models in your army gain Counterattack.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="d36a92db-cfee-5dc8-86c0-7b483790f0e4" name="House Cadmus" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="82834085-8fdc-5e00-941f-d105605a62fc" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="5e15c3e6-96e1-5044-8b4e-eb4393b4f75a" name="Knight Household: House Cadmus" hidden="false">
                  <description>The Hunter's Eye: All ranged attacks made from models in your army inflict a -1 to Cover Saves.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="8802288f-7949-5e7f-8990-951e757ab55a" name="House Griffith" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="3d403d24-b04d-5618-abc7-afe9d6dffc94" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="c0298d07-1f50-56ad-ab58-de1740be9a1c" name="Knight Household: House Griffith" hidden="false">
                  <description>Glory of the Charge: All models in your army may reroll failed Charge rolls.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="d23078c2-1033-5648-beb9-1dd8cbb77fa5" name="House Hawkshroud" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="9f8a2a99-a428-503a-b41f-27f9954913e6" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="38373e2f-42ee-5ab1-b100-3197add98202" name="Knight Household: House Hawkshroud" hidden="false">
                  <description>Oathkeepers: Ignore secondary effects from the Vehicle Penetration Chart on a 3+.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="2f4d655e-a914-5948-ab6c-d17758c86112" name="House Krast" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="461417c2-6167-51be-a1b2-0f233a12a877" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="9e7964bb-bc8e-5690-8661-1ec70eec4b42" name="Knight Household: House Krast" hidden="false">
                  <description>Controlled Aggression: All models in your army gain I+3.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="933b41e1-dd43-56d6-b598-53eb57233fe9" name="House Mortan" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="a16e6504-2f51-53a9-a488-bfac8f0b9245" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="46d85a7d-d508-53cf-84c2-8c84e3762927" name="Knight Household: House Mortan" hidden="false">
                  <description>Close Quarter Experts: Reroll all To Hit rolls in Melee on the turn they Charged or were Charged.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="6c4d47e3-a0e3-5219-8843-cf9c9f25d60e" name="House Raven" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="9875f392-377b-54e4-ac7f-270b56b7c2a8" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="a2b7db0a-0e38-5d53-b674-fb0c3847b45b" name="Knight Household: House Raven" hidden="false">
                  <description>• Lost Home World: All models lose Objective Secured.
• Quest of Vengeance: Gain d3+3 VP if you slay the enemy Warlord.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="8a6d884e-1f09-5ee2-b568-e9e9bf03f5c0" name="House Taranis" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="d7acf017-4a3b-59cc-9fca-f75a2956ecb8" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="378c6128-b258-52c2-9998-05c5e6b91dd2" name="Knight Household: House Taranis" hidden="false">
                  <description>Omnissiah's Grace: Repair 1 Wound in each Command Phase, and on a 5+ restore secondary services from Penetration results.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="2901d2e5-4c31-5e77-8ee5-d122e3ac29c9" name="House Terryn" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="ac326505-f9b8-54fb-9b66-9ce13347ef0e" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
