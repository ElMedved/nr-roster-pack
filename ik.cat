      <rules>
        <rule id="668fe253-195b-5410-8597-1705e4271dd3" name="Free Lancer" hidden="false">
          <description>Unit keyword / faction rule.</description>
        </rule>
        <rule id="8721ee19-ff32-517e-9e33-eb988254b90d" name="Chainbreaker" hidden="false">
          <description>6” Aura, target unit may move as if they were not engaged in Melee.</description>
        </rule>
        <rule id="1e96b68e-756c-5471-a6ba-876152bf3033" name="Solemn Duty" hidden="false">
          <description>6” Aura, This model and target unit may reroll 1s To Hit and To Wound.</description>
        </rule>
        <rule id="edfa3abf-a564-5ad0-a2f5-19c8ebd339cc" name="Toss" hidden="false">
          <description>non-Titanic Monsters and Vehicles slain by Thunderstrike Gauntlet are placed by the slayer up to 12” away. Roll Scatter dice subtracting BS modifiers like normal. Any model underneath suffers an Auto Hit at the slain model’s S value, AP -. Non- Titanic models and non- Immobile models are Displaced. Roll to see if the model Exlpodes after resolving the Auto Hits.</description>
        </rule>
        <rule id="33602497-90d8-53e0-955e-aa2220b5f7e1" name="Ejector Seat" hidden="false">
          <description>This model starts Embarked on Canis Rex and cannot Disembark unless Canis Rex is destroyed. If it is, this model Disembarks up to 12” without the usual Forced Disembark penalty.</description>
        </rule>
      </rules>
