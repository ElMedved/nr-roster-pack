                    <characteristic name="Rules" typeId="6b2a8df2-cb0b-5493-974f-d27207ce83fd">The Cast Value is the target non-Titanic model’s remaining Wounds. This model immediately performs its Melee or Ranged attacks against one of its friendly units, but not itself.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
