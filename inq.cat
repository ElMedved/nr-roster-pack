  <sharedSelectionEntries>
    <selectionEntry id="6ee96499-4a19-5c2e-a39c-1eefe33136b2" name="Ordo &amp; Army Rules" publicationId="89ec871d-e354-595b-b3b5-2083b999a7e1" page="2" hidden="false" collective="false" import="true" type="upgrade">
      <constraints>
        <constraint id="273796d8-bfe6-5954-b181-567b3fa09148" field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="min"/>
        <constraint id="812f0ca8-a1eb-5717-b344-506553e89dde" field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max"/>
      </constraints>
      <rules>
        <rule id="3557490a-b3cd-5725-bc03-3dc17a0edd0b" name="Authority of the Inquisition" hidden="false">
          <description>6" Aura, this model and target unit automatically pass Ld Tests.</description>
        </rule>
        <rule id="c7a049f1-ba1b-5d1f-84ef-6d96bb37dcfd" name="Requisition Approved / By Order of the Inquisition" hidden="false">
          <description>Allows Inquisitors (HQ) and Assassins/Inquisitorial units (Lord of War) to be requisitioned by Imperial armies.</description>
        </rule>
        <rule id="7bad2638-42f2-55d0-85ee-6267fca85518" name="Lone Operative" hidden="false">
          <description>Cannot be targeted further than 12" away, cannot be targeted by Auras, cannot join units, has 3+ Invulnerable Save.</description>
        </rule>
        <rule id="bcefb363-641e-5b78-b816-27a1a6b4b271" name="Quarry" hidden="false">
          <description>During Deployment choose one enemy model; reroll all failed To Hit and To Wound rolls against it.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup id="bf864f02-0d15-553b-82d2-cd235f573e9c" name="Select Ordo" hidden="false" collective="false" import="true" defaultSelectionEntryId="a59185a2-b108-5961-a0bc-b6dba6bbafea">
          <constraints>
            <constraint id="690b1505-f0ed-5b12-8c32-bfcf44dde6b5" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="min"/>
            <constraint id="4f8d8c84-5d53-54f3-9c8c-d8d7d907d266" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
          </constraints>
          <selectionEntries>
            <selectionEntry id="a59185a2-b108-5961-a0bc-b6dba6bbafea" name="Minor Ordo" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="baa15a7d-68b2-5b01-881b-351340ecdb21" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="e36c87ba-4679-59f5-aac1-c583c83f79eb" name="Ordo: Minor Ordo" hidden="false">
                  <description>Well Disciplined: All models in your army may reroll 1s To Hit. Auras that allow rerolling 1s To Hit allow failed To Hit rolls of 1 or 2 to be rerolled instead.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="4f6e29e6-fe0c-5608-ac37-1007425800f5" name="Ordo Hereticus" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="4011c23e-d3e2-500e-acc6-59da9736ce98" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="d74828cb-c113-520b-a6ef-359ca4ab709b" name="Ordo: Ordo Hereticus" hidden="false">
                  <description>Witch Hunters: All models' weapons in your army gain Sniper (4+) against Psychic Mastery Level # models.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="4a53165d-e728-553c-8d41-67a6e07786a7" name="Ordo Malleus" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="896d7917-0cb6-52e0-90c4-61dcff9ffcca" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="3b09d058-0e70-5902-a934-0a1c9d82c81c" name="Ordo: Ordo Malleus" hidden="false">
                  <description>Daemonic Hunters: All successful Invulnerability Saves of a 6+ made against attacks your models made must be rerolled.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="16379146-5a16-5a29-bb9d-f502ac50dd6a" name="Ordo Xenos" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="dad810b4-6187-5858-93d7-a7e5fc82647d" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="f04625a8-13e0-5b98-b6dd-5c951c085009" name="Ordo: Ordo Xenos" hidden="false">
