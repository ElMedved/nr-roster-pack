            <characteristic name="AP" typeId="37819752-fbc6-5464-ad45-17490825eae1">1+ Or 4+</characteristic>
            <characteristic name="Rules" typeId="989bc79d-9e4b-528b-b966-eff3ce994cc7">Assault 2, Melta, (Monsterbane), Or Assault 1</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="5b04cefc-8cd8-5efd-a054-6be1e9768b2a" name="Jokaero Ingenuity" hidden="false">
          <description>6” Aura, This model and target unit benefit from one of the following until the end of the game. One Use Only. Roll a d6.</description>
        </rule>
        <rule id="b4b97dcd-6a6b-5506-b899-cc36e0e9f71f" name="1" hidden="false">
          <description>No Effect.</description>
        </rule>
        <rule id="4e6a2741-bbb3-548e-9003-6ba732d766b0" name="2" hidden="false">
          <description>All ranged weapons gain +12” Range.</description>
        </rule>
        <rule id="2f9b2cf4-73f8-5685-b601-a78f24da011d" name="3" hidden="false">
          <description>Gain Sv-1 (Improves by 1) to a maximum of 2+.</description>
        </rule>
        <rule id="513578c0-3150-5c06-99dd-9698ccfea9e1" name="4" hidden="false">
          <description>All Weapons gain Rending.</description>
        </rule>
        <rule id="42da8c2d-ede9-556e-ad4f-8decaf282e40" name="5" hidden="false">
          <description>Models gain a 5+ Feel No Pain.</description>
        </rule>
        <rule id="d354cbf7-0bf2-55d0-bbad-7acf4748623e" name="6" hidden="false">
          <description>Pick two from the chart.</description>
        </rule>
      </rules>
