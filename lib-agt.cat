      <rules>
        <rule id="e61aba3a-5630-5962-88ae-1486d3b0ace5" name="Ordo Hereticus" hidden="false">
          <description>Unit keyword / faction rule.</description>
        </rule>
        <rule id="5d82a6f1-600f-50ec-9831-77e60e667125" name="By Any Means Necessary" hidden="false">
          <description>This model may place its Orbital Strike Token on friendly units. The Orbital Strike will never Scatter if you do so. If the model is slain, it hits the place it was standing when it was removed from the game.</description>
        </rule>
        <rule id="df469be3-296d-59ec-9dc4-703400f687c6" name="Dread Reputation" hidden="false">
          <description>6” Aura, target unit suffers Ld-2.</description>
        </rule>
        <rule id="c12df181-306a-543e-947f-f2e4860a154a" name="Throne of Judgement" hidden="false">
          <description>This model is immune to the secondary effects of 1-4 on the Vehicle Damage Chart, but still suffers the extra Wounds.</description>
        </rule>
        <rule id="df8feebe-ea2a-5fab-b5b3-b5a13598c8d5" name="The Hour is Nigh" hidden="false">
          <description>When the weapon is fired, place a marker on field at a valid target. In your next Command Phase, the barrage strikes! Scatter like normal, following the 15” Blast radius rules.</description>
        </rule>
        <rule id="e47dd914-bc01-5578-9e64-f229b3cccbe6" name="T Minus 5" hidden="false">
          <description>The weapon may not be fired Turn 1. If the weapon is marked on the field and the carrier is destroyed, the Orbital Strike still hits in your Command Phase.</description>
        </rule>
      </rules>
