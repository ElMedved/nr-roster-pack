      <rules>
        <rule id="94f8e56a-611e-5719-8ba3-fb1efed92b50" name="Etherium" hidden="false">
          <description>All enemy models suffer -1 To Hit this model. This model has a 5+ Feel No Pain.</description>
        </rule>
        <rule id="fc1de071-91c1-5744-8e30-1c7e53ea81d5" name="Life Drain" hidden="false">
          <description>This model Heals 1 Wound for each Wound it causes in Melee. This is an exception to the normal Heal rules.</description>
        </rule>
        <rule id="8dd98c14-c070-542e-8247-74d50d783093" name="Psychic Abomination" hidden="false">
          <description>12” True Aura, any To Cast roll of a double inflicts 2 Mortal Wounds on the Caster.</description>
        </rule>
      </rules>
