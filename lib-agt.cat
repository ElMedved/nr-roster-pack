      <rules>
        <rule id="bafbfccd-1cf0-5de6-b2ea-f86d9b25988c" name="Ordo Xenos" hidden="false">
          <description>Unit keyword / faction rule.</description>
        </rule>
        <rule id="43836e8b-b68f-5aea-863a-88303ef0de99" name="Autosavant Wassily" hidden="false">
          <description>Token. This model may reroll one Objective this turn, even if it has already been rerolled.</description>
        </rule>
        <rule id="85f5308b-0f4b-54e4-9a38-1d0f14076b2a" name="Servo Scribe Skull" hidden="false">
          <description>6” Aura, this model and target unit gains Objective Secured.</description>
        </rule>
        <rule id="25b87be3-03f2-5ad3-89ba-860134f26173" name="The Hour is Nigh" hidden="false">
          <description>When the weapon is fired, place a marker on field at a valid target. In your next Command Phase, the barrage strikes! Scatter like normal, following the 15” Blast radius rules.</description>
        </rule>
        <rule id="91518616-f4f4-5a59-bbf3-887cd93b3c89" name="T Minus 5" hidden="false">
          <description>The weapon may not be fired Turn 1. If the weapon is marked on the field and the carrier is destroyed, the Orbital Strike still hits in your Command Phase.</description>
        </rule>
      </rules>
