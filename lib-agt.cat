      <rules>
        <rule id="08825c8c-d4b6-518c-858c-e98c15b1e76b" name="Exitus Rounds" hidden="false">
          <description>Attacks from this weapon Ignore all Saves and Feel No Pains. Models cannot use Bodyguard or any other rule that allows models to intervene for Wounds on their behalf. Each time a model is Wounded by an Exitus Round, it suffers an additional d3 Mortal Wounds.</description>
        </rule>
      </rules>
