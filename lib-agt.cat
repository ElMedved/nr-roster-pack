        <profile id="53b77262-e30c-5705-81d5-51b2813de513" name="Orbital Strike" hidden="false" typeId="0b840343-a9ff-5f16-b0df-b617cac2c0fa" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="9c7850b8-81dd-53f9-80e1-1a39147745dd">12-240</characteristic>
            <characteristic name="S" typeId="1ec1daae-c783-53b1-87a9-2dc4176bdfea">D/10 /8</characteristic>
            <characteristic name="AP" typeId="37819752-fbc6-5464-ad45-17490825eae1">1+/1+ /1+</characteristic>
            <characteristic name="Rules" typeId="989bc79d-9e4b-528b-b966-eff3ce994cc7">Heavy 1, 15” Blast, Destroyer, Ordnance, Monsterbane, Indirect Fire, Ignores Cover, The Hour is Nigh, T Minus 5, One Use Only</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="30da545e-3fc5-57fe-930f-431936d089fd" name="Ordo Hereticus" hidden="false">
          <description>Unit keyword / faction rule.</description>
        </rule>
        <rule id="f19d6ce7-5824-5ada-bba1-a707c4fee87a" name="Seek Out Corruption" hidden="false">
          <description>once per Round when a friendly Infantry unit fails a Ld test within 6”, you MUST remove the highest Ld model from that unit from the game. Ignore Commissars and Lord Commissars for highest Ld purposes. The unit automatically passes the Ld test. Order Tests do not count for this rule.</description>
        </rule>
        <rule id="9a3b46f8-4cf0-56c5-8cae-458977cc10b1" name="Telepath" hidden="false">
          <description>Models must reroll successful To Hit rolls against this model in a Challenge.</description>
        </rule>
        <rule id="8aa2570b-13d7-567c-8666-0f9cb858caef" name="The Hour is Nigh" hidden="false">
          <description>When the weapon is fired, place a marker on field at a valid target. In your next Command Phase, the barrage strikes! Scatter like normal, following the 15” Blast radius rules.</description>
        </rule>
        <rule id="20f088cc-54e2-5549-9d05-dea9541c6280" name="T Minus 5" hidden="false">
          <description>The weapon may not be fired Turn 1. If the weapon is marked on the field and the carrier is destroyed, the Orbital Strike still hits in your Command Phase.</description>
        </rule>
      </rules>
