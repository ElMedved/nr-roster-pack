            <characteristic name="Rules" typeId="989bc79d-9e4b-528b-b966-eff3ce994cc7">Psychicbane, -1 to Invulnerability Save (Improves by 1)</characteristic>
          </characteristics>
        </profile>
        <profile id="88f3b4df-3c79-58a0-9a0b-d2559a1abcd7" name="Orbital Strike" hidden="false" typeId="0b840343-a9ff-5f16-b0df-b617cac2c0fa" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="9c7850b8-81dd-53f9-80e1-1a39147745dd">12-240</characteristic>
            <characteristic name="S" typeId="1ec1daae-c783-53b1-87a9-2dc4176bdfea">D/10 /8</characteristic>
            <characteristic name="AP" typeId="37819752-fbc6-5464-ad45-17490825eae1">1+/1+ /1+</characteristic>
            <characteristic name="Rules" typeId="989bc79d-9e4b-528b-b966-eff3ce994cc7">Heavy 1, 15” Blast, Destroyer, Ordnance, Monsterbane, Indirect Fire, Ignores Cover, The Hour is Nigh, T Minus 5, One Use Only</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="9f41bbfb-64d6-5426-ac94-2a5559fd2177" name="Ordo Xenos" hidden="false">
          <description>Unit keyword / faction rule.</description>
        </rule>
        <rule id="7e28dc54-0491-5f95-968d-7630be7228c5" name="Malus Codicium" hidden="false">
          <description>Summon one Daemonhost and Deepstrike it within 12” in your Command Phase. One Use Only.</description>
        </rule>
        <rule id="6fef6c7f-5ab8-538e-8ed2-1eecaa4c20e6" name="No Stranger to Pain" hidden="false">
          <description>This model has a 5+ Feel No Pain.</description>
        </rule>
        <rule id="c07f30c5-518c-5257-b6a1-b6cb174380c7" name="Radical Bond" hidden="false">
          <description>6” Aura, target Daemonhost gains S+2, T+2, A+2 and may reroll 1s To Hit.</description>
        </rule>
        <rule id="31bd6bb6-6e6e-51ae-b152-90d36a95274c" name="The Hour is Nigh" hidden="false">
          <description>When the weapon is fired, place a marker on field at a valid target. In your next Command Phase, the barrage strikes! Scatter like normal, following the 15” Blast radius rules.</description>
        </rule>
        <rule id="2c444538-e9f8-550e-b811-37a02c22ddb6" name="T Minus 5" hidden="false">
          <description>The weapon may not be fired Turn 1. If the weapon is marked on the field and the carrier is destroyed, the Orbital Strike still hits in your Command Phase.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="7196eb9c-c084-5afa-a01a-cb7df436dabd" name="Independent Character" hidden="false" targetId="daa374d1-a1d8-5baf-b6c0-d3e27bcc4297" type="rule"/>
        <infoLink id="c84b7e0e-703f-565b-80ad-a7a6185c5e8e" name="Infantry" hidden="false" targetId="1c63b9cc-d5dc-5e00-99f3-357cdc80505b" type="rule"/>
