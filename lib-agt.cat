            <characteristic name="S" typeId="1ec1daae-c783-53b1-87a9-2dc4176bdfea">6</characteristic>
            <characteristic name="AP" typeId="37819752-fbc6-5464-ad45-17490825eae1">4+</characteristic>
            <characteristic name="Rules" typeId="989bc79d-9e4b-528b-b966-eff3ce994cc7">Grenade 1, Nonblast</characteristic>
          </characteristics>
        </profile>
        <profile id="7646e5a6-7a17-5986-925b-d4e591905c67" name="Orbital Strike" hidden="false" typeId="0b840343-a9ff-5f16-b0df-b617cac2c0fa" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="9c7850b8-81dd-53f9-80e1-1a39147745dd">12-240</characteristic>
            <characteristic name="S" typeId="1ec1daae-c783-53b1-87a9-2dc4176bdfea">D/10 /8</characteristic>
            <characteristic name="AP" typeId="37819752-fbc6-5464-ad45-17490825eae1">1+/1+ /1+</characteristic>
            <characteristic name="Rules" typeId="989bc79d-9e4b-528b-b966-eff3ce994cc7">Heavy 1, 15” Blast, Destroyer, Ordnance, Monsterbane, Indirect Fire, Ignores Cover, The Hour is Nigh, T Minus 5, One Use Only</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="2e6f18f5-ebc3-546f-b32f-719b2047a42e" name="Ordo Xenos" hidden="false">
          <description>Unit keyword / faction rule.</description>
        </rule>
        <rule id="4c2dd77f-7903-51d9-adaa-83dfadd9ab78" name="The Hour is Nigh" hidden="false">
          <description>When the weapon is fired, place a marker on field at a valid target. In your next Command Phase, the barrage strikes! Scatter like normal, following the 15” Blast radius rules.</description>
        </rule>
        <rule id="03685d4e-cd0b-50e9-944c-10baed235e46" name="T Minus 5" hidden="false">
          <description>The weapon may not be fired Turn 1. If the weapon is marked on the field and the carrier is destroyed, the Orbital Strike still hits in your Command Phase.</description>
        </rule>
        <rule id="7071bbc1-b197-5723-89ae-20e55d10c651" name="Xenos Prime Hunter" hidden="false">
          <description>When attacking an Independent Character, this model may make 1 additional attack with its Ranged or Melee weapons as appropriate.</description>
        </rule>
      </rules>
