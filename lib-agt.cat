          </characteristics>
        </profile>
        <profile id="f15bc5f4-2048-5592-9661-57aec78d2f75" name="Orbital Strike" hidden="false" typeId="0b840343-a9ff-5f16-b0df-b617cac2c0fa" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="9c7850b8-81dd-53f9-80e1-1a39147745dd">12-240</characteristic>
            <characteristic name="S" typeId="1ec1daae-c783-53b1-87a9-2dc4176bdfea">D/10 /8</characteristic>
            <characteristic name="AP" typeId="37819752-fbc6-5464-ad45-17490825eae1">1+/1+ /1+</characteristic>
            <characteristic name="Rules" typeId="989bc79d-9e4b-528b-b966-eff3ce994cc7">Heavy 1, 15” Blast, Destroyer, Ordnance, Monsterbane, Indirect Fire, Ignores Cover, The Hour is Nigh, T Minus 5, One Use Only</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="511d7608-ce24-57b6-800c-104bf12b19f8" name="Ordo Malleus" hidden="false">
          <description>Unit keyword / faction rule.</description>
        </rule>
        <rule id="14969236-0475-59f6-9ea0-8dda805ce553" name="Astropath" hidden="false">
          <description>Token. Hector may reroll 1 Die to Cast or To Deny the Witch once per Phase.</description>
        </rule>
        <rule id="3925745f-a793-5322-8c59-912089e86f94" name="Exorcist" hidden="false">
          <description>Token. This model deals +1 Wound to each Wound it causes to models with Psychic Mastery Level #.</description>
        </rule>
        <rule id="b9a6dbf6-137d-5509-b9b7-9a4a78352882" name="Sword Bearer" hidden="false">
          <description>Token. This model may reroll 1 failed Save roll per Turn.</description>
        </rule>
        <rule id="2db5b184-bd9f-5a68-88b1-c2f637bdc716" name="The Hour is Nigh" hidden="false">
          <description>When the weapon is fired, place a marker on field at a valid target. In your next Command Phase, the barrage strikes! Scatter like normal, following the 15” Blast radius rules.</description>
        </rule>
        <rule id="16dbbb75-5c05-5b52-9997-c0f4e385660a" name="T Minus 5" hidden="false">
          <description>The weapon may not be fired Turn 1. If the weapon is marked on the field and the carrier is destroyed, the Orbital Strike still hits in your Command Phase.</description>
        </rule>
      </rules>
