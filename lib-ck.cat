        <profile id="970417b0-4f5a-5475-950b-ad4d07b252b6" name="Thunderstrike Gauntlet" hidden="false" typeId="0b840343-a9ff-5f16-b0df-b617cac2c0fa" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="9c7850b8-81dd-53f9-80e1-1a39147745dd">Melee</characteristic>
            <characteristic name="S" typeId="1ec1daae-c783-53b1-87a9-2dc4176bdfea">D</characteristic>
            <characteristic name="AP" typeId="37819752-fbc6-5464-ad45-17490825eae1">1+</characteristic>
            <characteristic name="Rules" typeId="989bc79d-9e4b-528b-b966-eff3ce994cc7">Slow, Destroyer, Monsterbane, Toss, Primary</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="db6f9576-a2d9-5f20-be1e-c8a0fd13fbeb" name="Close Quarter Expert" hidden="false">
          <description>This model grants Extra Attack 2 to the Melee weapon nominated as an Auxiliary when selecting the main Melee weapon for the Melee Phase.</description>
        </rule>
        <rule id="dacc1e63-2bc0-5e6a-a3ec-45cd589e9807" name="Toss" hidden="false">
          <description>non-Titanic Monsters and Vehicles slain by Thunderstrike Gauntlet are placed by the slayer up to 12” away. Roll Scatter dice subtracting BS modifiers like normal. Any model underneath suffers an Auto Hit at the slain model’s S value, AP -. Non- Titanic models and non- Immobile models are Displaced. Roll to see if the model Explodes after resolving the Auto Hits.</description>
        </rule>
      </rules>
