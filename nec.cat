      <rules>
        <rule id="2e80d4bc-9c7a-5f13-8a8b-f2b6c15c4f23" name="Ziggurat Dock" hidden="false">
          <description>a Monolith may Dock to the top of the Tomb Ziggurat. Particle Whips that are docked gain S+1, but the Monolith may no longer use its Eternity Gate.</description>
        </rule>
        <rule id="f105d18e-5b7e-556f-b2ba-d64c9484b3d0" name="Resurrection Amplifier" hidden="false">
          <description>6” Aura, target unit gains +1 to Reanimation Rolls. This can never be improved by more then +1.</description>
        </rule>
        <rule id="9d6551dd-fe16-548a-aba3-908195c05979" name="Eternity Portal" hidden="false">
          <description>Teleporter. This model has a Transport Capacity of 20, but instead of carrying the models it keeps them in Reserve. Any model with a Teleporter rule may bring up to is Transport capacity to the field each Turn. Access Front.</description>
        </rule>
      </rules>
      <infoLinks>
