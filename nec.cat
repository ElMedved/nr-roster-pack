      <rules>
        <rule id="8df4c0d2-1261-5706-997e-5a7e8547f3b8" name="Matter Absorption" hidden="false">
          <description>Each time a Vehicle or Titanic Vehicle is destroyed within 18” of this unit roll a d6. On a 2+, heal 1 Wound. This is an exception to the normal Heal rules.</description>
        </rule>
        <rule id="5b79f774-3508-5952-93e6-a87d19ee977d" name="Immune to Natural Law" hidden="false">
          <description>Ignores models and Terrain for moving. May not fire Overwatch with C’Tan Powers. This model ignores the extra Wound it suffers from Monsterbane.</description>
        </rule>
      </rules>
