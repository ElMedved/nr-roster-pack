        <infoLink id="aac0c828-b723-5c53-83ae-c413000a122b" name="Living Metal" hidden="false" targetId="bf18d15d-a707-5a52-98b4-52da443850af" type="rule"/>
        <infoLink id="1a94e740-2c25-5e56-ad8f-8678c2be8e51" name="Immobile" hidden="false" targetId="9b79f201-ded1-5d99-a578-5343a625dc24" type="rule"/>
      </infoLinks>
