        <profile id="61c6f984-3875-5769-8123-5cb928012ccf" name="Gauss Eradicator" hidden="false" typeId="0b840343-a9ff-5f16-b0df-b617cac2c0fa" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="9c7850b8-81dd-53f9-80e1-1a39147745dd">72</characteristic>
            <characteristic name="S" typeId="1ec1daae-c783-53b1-87a9-2dc4176bdfea">D</characteristic>
