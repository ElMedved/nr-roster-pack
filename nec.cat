      <rules>
        <rule id="9dfdd862-e349-5075-b51d-f7853e7095e4" name="Clog the Barrels" hidden="false">
          <description>Any enemy non-Titanic Monster, Vehicle, or Monstrous Infantry may not fire weapons at any other target except this one while they are engaged in Melee to it. Flame weapons ignore this.</description>
        </rule>
      </rules>
