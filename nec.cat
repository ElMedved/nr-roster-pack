        </profile>
      </profiles>
      <rules>
        <rule id="d8d02b3d-b51b-5c6f-8bea-5a3c663212d4" name="Relentless March" hidden="false">
          <description>6” Aura, this model and target unit gain M+2.</description>
        </rule>
        <rule id="3a6fb7b4-2d6a-57b0-aeb2-28c8968ae058" name="My Will Be Done" hidden="false">
          <description>6” Aura, this model and target unit may reroll 1’s To Hit.</description>
        </rule>
        <rule id="b177d6c0-019e-55e1-a457-db27dbb7d51e" name="Surrogate Hosts" hidden="false">
          <description>when this model is destroyed, on a 2+ swap it with a friendly Infantry model within 6” Instead with d3 Wounds restored. This replaced Reanimation</description>
        </rule>
      </rules>
