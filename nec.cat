  <sharedSelectionEntries>
    <selectionEntry id="ad39a78f-cf19-53c8-8bc4-385a5776557c" name="Dynasty &amp; Army Rules" publicationId="cba60ef5-8bdf-5540-9539-634aa936e1e5" page="2" hidden="false" collective="false" import="true" type="upgrade">
      <constraints>
        <constraint id="6b6933f8-cccc-5c53-b5f9-e63aa73141a2" field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="min"/>
        <constraint id="ae86733f-5f34-54ad-bb25-0724470b0452" field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max"/>
      </constraints>
      <rules>
        <rule id="f9e67b9e-069f-558a-a151-428d8fd9bdfa" name="Reanimation" hidden="false">
          <description>At the end of each Phase, roll d6 for each slain Infantry/Monstrous Infantry model (or d3 Wounds for multi-Wound models); on a 5+ the model reanimates!</description>
        </rule>
        <rule id="e255dc89-1b37-51cb-b121-d121d3ab9386" name="Living Metal" hidden="false">
          <description>Heals 1 Wound during each of your Command Phases.</description>
        </rule>
        <rule id="c4f09496-7346-56fa-ba81-0c00a619ba56" name="Quantum Shield" hidden="false">
          <description>Treats all Armour Facings as 13 until the first Penetration is suffered.</description>
        </rule>
        <rule id="cc975cbf-05ce-5349-aeca-1410e7593324" name="Hardwired for Destruction" hidden="false">
          <description>This model may reroll 1s To Hit.</description>
        </rule>
        <rule id="131b9746-d18f-59bc-a0fb-645f6b594cc9" name="Canoptek &amp; Soulless Machines" hidden="false">
          <description>Canoptek ignores Fearless Combat Resolution Autowounds. Soulless Machines cannot willingly Go To Ground.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup id="5296978e-ad13-5aca-958a-5b6adce527ae" name="Select Dynasty" hidden="false" collective="false" import="true" defaultSelectionEntryId="15eff4b4-3036-5b93-9257-129409ee3ed7">
          <constraints>
            <constraint id="cd21585d-dd66-5c01-839c-dd3eb6695380" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="min"/>
            <constraint id="d255f7d8-bb19-5834-8efe-a1490239171a" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
          </constraints>
          <selectionEntries>
            <selectionEntry id="15eff4b4-3036-5b93-9257-129409ee3ed7" name="Average Dynasty" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="bd5d476b-56d6-5ac4-b4dd-fb7d42788784" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="1d8dbccb-402f-523f-9d0c-3eb43836bf76" name="Dynasty: Average Dynasty" hidden="false">
                  <description>This Dynasty uses the rules for models stated exactly as they are in this Codex.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="dc05d1eb-98eb-5e6d-b223-f4ae4492228c" name="Maynarkh" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="ac500cc6-fac8-59c7-ab40-241e533a8b4a" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="4c01c9ef-67c4-5b1d-9ec3-efce4c34bf48" name="Dynasty: Maynarkh" hidden="false">
                  <description>• Conquerors: All Infantry models gain Objective Secured.
• Flayer Virus: All models suffer Ld-2.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="591f0eb7-13ad-580e-9e20-f907b09f4839" name="Mephrit" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="24186e33-74e6-5ef8-ae4d-6e500aece2d5" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="798ee9e2-08ae-5c03-b6c7-a8f478bcb900" name="Dynasty: Mephrit" hidden="false">
                  <description>• The Power of the Stars: Non-Tesla weapons gain Rending (or 4+ if already Rending); Vehicles explode on 4+.
• Leaderless &amp; Infighting: Models count as half for Objectives; max 1 Character/Aura per unit.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="2e726b46-ea9d-597e-94c5-62af8b235500" name="Nephrekh" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="c6282a89-7280-5d46-ac3c-d98d9f3e7598" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="abd057ba-70c5-5364-8a90-f6ffe19d52be" name="Dynasty: Nephrekh" hidden="false">
                  <description>• Abundant Precious Metals: Reroll 1s on Armour Saves.
• Yearn for Pure Light Forms: All models gain Fleet but cannot Claim or Contest Objectives.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="be6074df-590f-5157-acdc-8a93e99e0426" name="Nihilakh" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="63a57ae3-f67e-5f0c-87af-c8b042199a40" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="8bf4c2c3-108a-57f8-9ba2-0da81c50f0b7" name="Dynasty: Nihilakh" hidden="false">
                  <description>• Treasure Horde: All models have Objective Secured within your Deployment Zone.
• Isolationists: Cannot Claim or Contest Objectives inside Enemy Deployment Zone.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="8d242c3e-952e-5581-972f-228611ed2562" name="Novokh" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="1b2f1e09-3883-504f-8551-06beea0f5da5" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="28869e40-9bce-5e24-b97f-a089795268f2" name="Dynasty: Novokh" hidden="false">
                  <description>• Blood Crazed: All non-Unique models gain Shock Assault and Furious Charge.
• Ferric's Blight: All non-Unique models suffer Sv+1 (1 worse Armour Save).</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="2402648a-f5b2-50bf-9ec2-d2cb903e0c74" name="Szarekhan" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="841adf17-6559-59fc-ba64-952d7c249997" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="f386018b-4874-5a5d-812f-dc5dc445266a" name="Dynasty: Szarekhan" hidden="false">
                  <description>• Blackstone Experts &amp; King's Chosen: Each Infantry unit may Deny the Witch once per Round; Infantry/Monstrous Infantry gain Bodyguard.
• Dark Origins: All non-Unique models have I1.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="8825ea68-f235-5e21-a1e2-add32ea937e6" name="Sautekh" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="de89f07b-659b-5165-8193-37a3ef03b17a" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="a310e8a3-7c21-53f6-97e8-11ecfd8cec05" name="Dynasty: Sautekh" hidden="false">
                  <description>• Aggressive Territory Grab: Models count as 2 for Objectives outside enemy Deployment Zone; eligible units must declare Charges.
• Slavers: Characters/ICs must accept all Challenges.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
    </selectionEntry>
    <selectionEntry id="49dabc34-5edb-5dcc-909f-6f61de932371" name="Command Barge" publicationId="cba60ef5-8bdf-5540-9539-634aa936e1e5" page="5" hidden="false" collective="false" import="true" type="unit">
      <profiles>
        <profile id="440771e6-d3a5-56d0-9362-fca6e1ccdd87" name="Command Barge" hidden="false" typeId="79b0327d-7474-50d2-b020-59c7ee76ca34" typeName="Vehicle">
          <characteristics>
            <characteristic name="M" typeId="2a5f131c-10d8-5154-a846-ab9be756b546">12</characteristic>
            <characteristic name="WS" typeId="f01efc06-98eb-5e18-b8e0-a250d9c12c08">2+</characteristic>
            <characteristic name="BS" typeId="9668fefb-fa68-5d6a-8889-1c276f51eb2f">2+</characteristic>
            <characteristic name="S" typeId="ce68c1a5-e41a-58df-8f92-7dd4330d1c37">5</characteristic>
            <characteristic name="FA" typeId="d2924870-473f-5655-b0cb-140eca07e261">11</characteristic>
            <characteristic name="SA" typeId="08d9ada2-c8a3-522f-9533-102b116894fb">11</characteristic>
            <characteristic name="RA" typeId="b4ddabf1-d0b7-55f8-9548-dafa9477db70">11</characteristic>
            <characteristic name="W" typeId="40dfbefa-11ba-5864-aa77-c3701d34379d">8</characteristic>
