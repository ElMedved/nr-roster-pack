                  <characteristics>
                    <characteristic name="Cast" typeId="97e70b1c-dbfb-5c51-961a-c1ddce655c1f">Cast 6+</characteristic>
                    <characteristic name="Range" typeId="bd6bc23e-e24d-5c7e-855c-409059c1eee5">6</characteristic>
                    <characteristic name="S" typeId="b8615668-9262-5080-ae30-cf051dbfb91d">-</characteristic>
