    <selectionEntry id="d0b1f4e6-03df-59dc-b91c-153fdda64392" name="Pulsa Rokkit Launchaz" publicationId="98ce6e26-686c-5bf7-9173-157fcd11830e" page="41" hidden="false" collective="false" import="true" type="unit">
      <profiles>
        <profile id="0333403d-5259-5316-bdc4-e926c2398210" name="Launcha" hidden="false" typeId="c4d93c9f-bd1a-5ef8-8b78-4f198aad6964" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="1f4c78ac-1f27-5042-bfb7-0d00f8f695a2">-</characteristic>
            <characteristic name="WS" typeId="d94fa72c-3ead-5b35-ae0e-3fdce3a41cf7">5+</characteristic>
            <characteristic name="BS" typeId="887899fe-1bdf-5a72-a3e1-f87bdd96622a">4+</characteristic>
            <characteristic name="S" typeId="135fb285-c97f-57fb-b178-be4a154ff49f">2</characteristic>
            <characteristic name="T" typeId="755e50b9-0a88-5118-b150-4f991fea0b0b">7</characteristic>
            <characteristic name="W" typeId="ab6f48e2-16a0-59de-9511-89fbff6d4548">6</characteristic>
            <characteristic name="I" typeId="1bf29bae-0689-56f9-b0e3-2a022091b15b">4</characteristic>
            <characteristic name="A" typeId="51d23fe8-6dd4-5bba-b2a9-8ef0f0d132ba">3</characteristic>
            <characteristic name="Ld" typeId="494a7951-7cd9-524d-bf22-444838fed165">5</characteristic>
            <characteristic name="Sv" typeId="3516322a-033e-5517-b8bd-1c7dfa38d6de">4+</characteristic>
          </characteristics>
        </profile>
        <profile id="7237ec29-e0d8-5ac3-9787-5ce07dcc5e78" name="Unit Composition" hidden="false" typeId="35b65644-1892-5b82-90c0-20981913471e" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="83d81002-a330-5968-9552-22dcb2ed8516">1-3 Launchaz</characteristic>
          </characteristics>
        </profile>
        <profile id="2715f858-392f-5331-a4ee-868e9a4a001a" name="Pulsa Rokkit" hidden="false" typeId="0b840343-a9ff-5f16-b0df-b617cac2c0fa" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="9c7850b8-81dd-53f9-80e1-1a39147745dd">12-120</characteristic>
            <characteristic name="S" typeId="1ec1daae-c783-53b1-87a9-2dc4176bdfea">*</characteristic>
            <characteristic name="AP" typeId="37819752-fbc6-5464-ad45-17490825eae1">-</characteristic>
            <characteristic name="Rules" typeId="989bc79d-9e4b-528b-b966-eff3ce994cc7">Heavy 1, Indirect Fire, 10” Blast, Grav, Pulsa, The Hour is Nigh, T Minus 5, One Use Only</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="d71e4dcd-73cd-5fa0-99a0-e7547dc635b6" name="Pulsa" hidden="false">
          <description>After resolving the final striking place of this weapon, roll a 1d6. On a 5+, double the Hits inflicted and roll another 1d6. If the next die is a 6+ triple the Hits instead!</description>
        </rule>
        <rule id="084191ca-8652-518a-a8c4-244d54b689b6" name="The Hour is Nigh" hidden="false">
          <description>When the weapon is fired, place a marker on field at a valid target. In your next Command Phase, the missile strikes! Scatter like normal, following the 15” Blast radius rules.</description>
        </rule>
        <rule id="1384fdfd-53f9-5a92-a16d-e78352df22bb" name="T Minus 5" hidden="false">
          <description>The weapon may not be fired Turn 1. The weapon cannot be destroyed or Disabled. If the weapon is marked on the field and the carrier is destroyed, the Deathstrike Missile still hits in your Command Phase.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="e8f681c3-1843-5d67-ab12-e007d50ad428" name="Monster" hidden="false" targetId="56d92dc0-4aaf-5a4c-8087-f35dd8cf9863" type="rule"/>
        <infoLink id="07d6d7d8-97b2-5676-b3ea-e195a00f864b" name="Immobile" hidden="false" targetId="9b79f201-ded1-5d99-a578-5343a625dc24" type="rule"/>
