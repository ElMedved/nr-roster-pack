        </rule>
        <rule id="2e10660e-b42b-5605-a15e-dab678690c79" name="Da Big Boss" hidden="false">
          <description>Unit keyword / faction rule.</description>
        </rule>
        <rule id="ee5c4a33-6cc8-5b3c-b25f-0ad678e55f4d" name="Breakin’ ‘Eads!" hidden="false">
          <description>6” Aura, the first time each phase a friendly Ork unit fails a Ld test, this model inflicts d3 Mortal Wounds to that unit and it automatically passes that test.</description>
        </rule>
        <rule id="11090213-0481-5f5f-acde-385c503ce186" name="Fixit da Grot" hidden="false">
          <description>This model Heals 1 Wound in each of its Command Phases.</description>
        </rule>
        <rule id="271fe4c5-da32-564d-9039-94d0f840768b" name="Waaagh!" hidden="false">
          <description>6” Aura, this model and target unit score one Auto Hit on a unmodified roll of a 6 To Hit in Melee.</description>
        </rule>
        <rule id="ed9a9273-71d0-5da2-a44f-a74186b33288" name="Warlord Titan Crew Skulls" hidden="false">
          <description>6” Aura, target unit must take a Fear Test at Ld-1.</description>
        </rule>
      </rules>
