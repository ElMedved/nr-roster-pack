      <rules>
        <rule id="dcec91d4-6322-54ae-8eb1-d0aa2d1d90be" name="Jam!" hidden="false">
          <description>Any double for the number of shots made by the Rattler Kannon causes the weapon to be removed from the game. The shots rolled are made before the weapon is removed.</description>
        </rule>
        <rule id="50d3aac2-0027-5474-bc16-6c0d4ecdd5d9" name="Repair" hidden="false">
          <description>Target model in base contact Repairs 1 Wound. Roll a d6, on a 5+ restore service for one Weapon Disabled, Crew Shaken, Immobilized, or Weapon Destroyed.</description>
        </rule>
      </rules>
