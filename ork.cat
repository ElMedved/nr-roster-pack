  <sharedSelectionEntries>
    <selectionEntry id="ffd962b6-4baf-5e9b-b7a4-24b8f8cceee9" name="Ork Clan &amp; Army Rules" publicationId="98ce6e26-686c-5bf7-9173-157fcd11830e" page="2" hidden="false" collective="false" import="true" type="upgrade">
      <constraints>
        <constraint id="263159ce-be82-5f1f-97c5-838300d9d596" field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="min"/>
        <constraint id="29c62067-bead-585e-a2f9-cf045e9b2234" field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max"/>
      </constraints>
      <rules>
        <rule id="af823f17-0af7-51e0-9d60-6c4f0c47e0f2" name="Dakka" hidden="false">
          <description>Each unmodified roll of a 6 To Hit causes one additional Auto Hit.</description>
        </rule>
        <rule id="ae377f44-d8d8-5bf7-87cd-367aa42b32a2" name="'Ere We Go!" hidden="false">
          <description>This model may reroll failed Charge rolls.</description>
        </rule>
        <rule id="f0117ef5-2306-534b-9c93-75f8cfa11d00" name="Mob Rule" hidden="false">
          <description>12" True Aura, friendly units may treat their Ld equal to the number of models in this unit.</description>
        </rule>
        <rule id="e0c4ea3f-fc46-5a97-8a2a-a3f6ba18858b" name="Poor Maintenance" hidden="false">
          <description>Roll d6 in Command Phase; on a 1, unit must choose to either Move OR Shoot this turn.</description>
        </rule>
      </rules>
