      <rules>
        <rule id="608a2272-6c5a-54c2-8bfe-2932cf6ad3a0" name="Fearless Charge" hidden="false">
          <description>6” Aura, this model and target unit may automatically succeed a failed Charge, but you must remove one friendly model with the word Boss or Warboss in its name or Keyword from the game.</description>
        </rule>
        <rule id="20f90fc7-d424-5f11-b6b5-8ba9fdd0fb98" name="Breakin’ ‘Eads!" hidden="false">
          <description>6” Aura, the first time each phase a friendly Ork unit fails a Ld test, this model inflicts d3 Mortal Wounds to that unit and it automatically passes that test.</description>
        </rule>
        <rule id="04eb1e9f-f0b0-5b0b-a664-0a18b387a955" name="Waaagh!" hidden="false">
          <description>6” Aura, this model and target unit score one Auto Hit on a unmodified roll of a 6 To Hit in Melee.</description>
        </rule>
      </rules>
