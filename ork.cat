            <characteristic name="Rules" typeId="989bc79d-9e4b-528b-b966-eff3ce994cc7">Heavy 1, 3” Blast, Chained Rokkitz</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="6de0de6e-516d-5c24-99bf-4b9849512f49" name="Chained Rokkitz" hidden="false">
          <description>Once the number of Hits this weapon caused has been determined, roll the Scatter Dice again, using the weapon’s strike point as the point of origin. Do not reduce the Scatter Distance with the user’s BS value. If you roll a Direct Hit the effect is cancelled. This effect can happen up to a total of 3 times maximum.</description>
        </rule>
      </rules>
