      <rules>
        <rule id="a172d45e-37e3-5316-8f3f-28a85f6fb3d5" name="Create Panic" hidden="false">
          <description>This model displaces non-Titanic models 1” away from underneath it when it finishes moving. If the models cannot be displaced, this model cannot be placed there.</description>
        </rule>
        <rule id="35527b2a-de8f-5fa9-93fc-ac7400d2d451" name="Reactor Meltdown" hidden="false">
          <description>This model Explodes on a 4+ in a 4d6” Radius with S Destroyer and AP 1+ when it is destroyed.</description>
        </rule>
        <rule id="79ccd207-2a23-5838-9189-bb7fb084703f" name="Towering God Engine" hidden="false">
          <description>This model may only be Hit in Melee on a natural 5+ or worse, regardless of modifiers or abilities.</description>
        </rule>
        <rule id="2728a594-89a5-5e47-8726-f62c02d8bd3f" name="Transport 20" hidden="false">
          <description>Access Rear. 10 Front Firing Ports.</description>
        </rule>
      </rules>
