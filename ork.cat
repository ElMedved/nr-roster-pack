      <rules>
        <rule id="bef7e17c-cef7-5efc-9581-4f353d7f7f00" name="Goff" hidden="false">
          <description>Unit keyword / faction rule.</description>
        </rule>
        <rule id="d9108fed-3c94-5f52-bfc3-918fad40e7d9" name="Breakin’ ‘Eads!" hidden="false">
          <description>6” Aura, the first time each phase a friendly Ork unit fails a Ld test, this model inflicts d3 Mortal Wounds to that unit and it automatically passes that test.</description>
        </rule>
        <rule id="5bcee62c-2b37-5d19-b77e-818c780f939b" name="Buzzgob’s Dredheadz" hidden="false">
          <description>6” Aura, this model and target unit may reroll 1s To Hit. If they can already reroll 1s To Hit, reroll 2s To Hit.</description>
        </rule>
        <rule id="fbf446d4-9726-5a79-b452-f855e9290804" name="Repair" hidden="false">
          <description>Target model in base contact Repairs 1 Wound. Roll a d6, on a 5+ restore service for one Weapon Disabled, Crew Shaken, Immobilized, or Weapon Destroyed.</description>
        </rule>
        <rule id="c4b8db80-0246-5859-9a07-f32da848bdcb" name="Waaagh!" hidden="false">
          <description>6” Aura, this model and target unit score one Auto Hit on a unmodified roll of a 6 To Hit in Melee.</description>
        </rule>
        <rule id="f9c04be7-19b1-531a-8345-fcd82ece9b8c" name="Grot" hidden="false">
          <description>Unit keyword / faction rule.</description>
        </rule>
        <rule id="7b3ffe12-acd1-5593-8038-d2e925e76fda" name="Propa Grot Oiler" hidden="false">
          <description>add +1 to repair dice rolls to restore secondary services.</description>
        </rule>
        <rule id="aea9b660-c950-5f03-b632-0cf27aaa442d" name="Transport 20" hidden="false">
          <description>Access Rear. 3 Fire Points Front, 1 Fire Point Rear.</description>
        </rule>
      </rules>
