      <rules>
        <rule id="d4c47d16-9a22-548f-9c09-254e9862d77a" name="Breakin’ ‘Ittle ‘ Eads!" hidden="false">
          <description>6” Aura, the first time each round a friendly Grot unit fails a Ld Test, inflict d3 Mortal Wounds and it automatically passes this Ld test and all other Ld tests for the rest of the Turn.</description>
        </rule>
      </rules>
