      <rules>
        <rule id="853fcd43-071d-56fb-babd-5f5ad6740923" name="Breakin’ ‘Eads!" hidden="false">
          <description>6” Aura, the first time each phase a friendly Ork unit fails a Ld test, this model inflicts d3 Mortal Wounds to that unit and it automatically passes that test.</description>
        </rule>
        <rule id="33b736d4-9ece-5761-9c73-e027879ac699" name="Waaagh!" hidden="false">
          <description>6” Aura, this model and target unit score one Auto Hit on a unmodified roll of a 6 To Hit in Melee.</description>
        </rule>
        <rule id="7dc50565-7aa5-56a6-9845-7020b4816f83" name="Grot" hidden="false">
          <description>Unit keyword / faction rule.</description>
        </rule>
        <rule id="3b33e9f5-129a-50ee-bfc6-9a27e20c36ac" name="Munition Bearer" hidden="false">
          <description>This model and target model may reroll 1s to Wound with ranged weapons.</description>
        </rule>
      </rules>
