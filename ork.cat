      <rules>
        <rule id="bc16b69f-1349-5de3-91c9-f98734e37bee" name="Goff" hidden="false">
          <description>Unit keyword / faction rule.</description>
        </rule>
        <rule id="36b8287c-37d2-5bb1-afcf-87eefaf15460" name="Breakin’ ‘Eads!" hidden="false">
          <description>6” Aura, the first time each phase a friendly Ork unit fails a Ld test, this model inflicts d3 Mortal Wounds to that unit and it automatically passes that test.</description>
        </rule>
        <rule id="f37f5333-674e-5448-8c72-572dc8d6d7d8" name="Scourge of the Sanctus Reach" hidden="false">
          <description>This model has a 5+ Feel No Pain.</description>
        </rule>
        <rule id="34af7410-5441-52c6-ac41-f7c6b8487cd8" name="Waaagh!" hidden="false">
          <description>6” Aura, this model and target unit score one Auto Hit on a unmodified roll of a 6 To Hit in Melee.</description>
        </rule>
      </rules>
