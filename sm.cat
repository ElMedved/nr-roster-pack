  <sharedSelectionEntries>
    <selectionEntry id="585e5434-8258-5e59-9877-a9d582eee091" name="Chapter &amp; Army Rules" publicationId="f58a93f8-a275-5dc0-9c65-876b1de3b547" page="2" hidden="false" collective="false" import="true" type="upgrade">
      <constraints>
        <constraint id="27be5c8b-b2c7-5621-ae46-926362770098" field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="min"/>
        <constraint id="d7c8bd37-03f6-51b4-9de6-00191fe4aaf8" field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max"/>
      </constraints>
      <rules>
        <rule id="fa0c8718-cf93-5fb1-885a-77ebff5e0952" name="Adjusted Tactics" hidden="false">
          <description>During Deployment, after seeing your opponent's Army Roster, models may swap current weapons for legal weapon options equal to or less than current point costs.</description>
        </rule>
        <rule id="9392b758-5da9-558e-9e7b-2d393f80cb57" name="Bolter Discipline" hidden="false">
          <description>Always counts as being in half range when firing Rapid Fire Bolter weapons if stationary.</description>
        </rule>
        <rule id="38c455b6-19fb-5035-9ed9-b9c34f31ca9a" name="Know No Fear" hidden="false">
          <description>Automatically passes Pinning Tests, Rally Tests, and Fear Tests.</description>
        </rule>
        <rule id="6b4a1730-bd22-5c57-be45-1a5107a09c6a" name="Tactical Squads" hidden="false">
          <description>Units with this rule may split into smaller units (min 2 models) or merge back together during your Command Phase.</description>
        </rule>
        <rule id="bb296bba-7982-5ec6-aae2-ef089a0e2db1" name="Transhuman Physiology" hidden="false">
          <description>This model has a 5+ Feel No Pain.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup id="bd11884f-0c6c-5303-b097-77c1e7a8f476" name="Select Chapter" hidden="false" collective="false" import="true" defaultSelectionEntryId="5a13a7ad-23e8-58c2-8d0b-5f6b9d780ace">
          <constraints>
            <constraint id="106d6074-eb96-50eb-b773-9012d64fd672" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="min"/>
            <constraint id="ea3b6ad3-2430-53dc-9a1d-477255d6dd85" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
          </constraints>
          <selectionEntries>
            <selectionEntry id="5a13a7ad-23e8-58c2-8d0b-5f6b9d780ace" name="Average Chapter" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="b3a3da71-c618-5b13-85a1-c8e7a584fcf2" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="5698e5f1-6251-569c-b641-8821fa3f6b75" name="Chapter: Average Chapter" hidden="false">
                  <description>Well Disciplined: Models may reroll 1s To Hit. Auras that allow rerolling 1s To Hit allow failed To Hit rolls of 1 or 2 to be rerolled instead.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="3df5a11b-97b0-5baa-ab3a-50cc03a64328" name="Black Templar" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="a1119580-b07e-58ed-a966-f7d9f667ade1" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="4ac546fd-739e-5bdc-9034-cc47760f38f6" name="Chapter: Black Templar" hidden="false">
                  <description>• Justified: All models gain Ld+1.
• Righteous Zeal: Reroll 1s To Wound in Melee on the phase they successfully Charged.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="25eb7ab1-7a1b-5193-88e0-8ad2728b9518" name="Blood Angels" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="de92f76a-b5a8-5d49-b9b4-e248ebb7b5b4" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="b990d199-7031-550b-94a0-4ae1e17b64aa" name="Chapter: Blood Angels" hidden="false">
                  <description>• Black Rage: Failing a Ld test causes WS+1, BS+1 (worse), A+1, and mandatory Charges.
• Quicksilver Blood: All models gain I+1.
• Unnatural Speed: All models gain Counterattack.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="692f9bc0-49c7-59ce-b7fd-79ae0a4640a2" name="Blood Ravens" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="ea5219db-8420-5d26-aec5-c6c9a2bc3b93" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="4813c76e-c886-59ae-8f6d-f2fb3608eb79" name="Chapter: Blood Ravens" hidden="false">
                  <description>• Relic Seekers: Enemy scoring Objective Markers within 3" of your scoreable unit also award you 0.5 VP.
• Unknown Origins: All models suffer Ld-1.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="acbe3179-199d-548e-bda3-ab02fa6e929d" name="Crimson Fists" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="15fa2317-5c9e-596b-9672-36a8bde61c90" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="ed3fe9bd-1ee7-594b-beb4-e6e17da21be4" name="Chapter: Crimson Fists" hidden="false">
                  <description>• Hold the Line: Reroll failed Sv rolls of 1.
• Unwavering: Reroll failed Ld Tests.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="80a14a8a-ad3b-5766-b940-630e3340a9f0" name="Dark Angels" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="3eacbed4-b2b9-56a4-9744-85e02d335075" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="5317f851-671d-51ec-9c7c-d69085c4dbb3" name="Chapter: Dark Angels" hidden="false">
                  <description>• Foreboding Knowledge: All Characters and Independent Characters suffer Ld-1.
• Watchers: Any Character/Independent Character may take a Watcher Token (reroll any 1 die per Phase).</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="875faa29-6b3f-5920-a2ec-3fbe1b028a06" name="Death Watch" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="d2f9b720-2d5b-5d29-95bd-cce5a585f79a" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="a5bbd08f-34fa-51f1-81ca-f00e912ad105" name="Chapter: Death Watch" hidden="false">
                  <description>• Extreme Trials: May treat Scouts, Bladeguard Veterans, Company Veterans, Sternguard Veterans, and Vanguard Veterans as Troop Slots.
• Long Suffering: All models gain Ld+1.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="35e35933-2de9-507f-a100-db97ec7b10e9" name="Drake Slayers" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="914d48b7-70ba-531a-92b4-ea1f317453de" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="cf5e8d36-535a-5f2b-8775-a406515fd863" name="Chapter: Drake Slayers" hidden="false">
                  <description>• Monster Hunters: +1 To Wound Monstrous Infantry, Monsters, or Titanic Monsters in Melee.
• Trophy Hunters: Cannot claim Objective Markers.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="28706926-d454-5a78-85fb-5018d8edb73e" name="Emperor's Spears" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="2fffc341-e2f3-56da-ba9f-f3617a12aa74" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="ffe5f173-be5b-5969-bc54-be1f92d47d4a" name="Chapter: Emperor's Spears" hidden="false">
                  <description>• Savages: All models have Furious Charge.
• Aggressive Tactics: +2" to Charges.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="384be48e-13b0-58d7-812d-f4974a05f5cf" name="Exorcists" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="b1582d7f-82ec-5510-82ad-19a5af87c9d2" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="98734fd6-e5cf-5fb9-811b-64beee770d5d" name="Chapter: Exorcists" hidden="false">
                  <description>• Extensive Rituals: Always lose Initiative Rolls for choosing Attacker/Defender.
• Spiritual Resolve: All units may Deny the Witch at Psychic Mastery Level 1 (+1 if already Psychic).</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="cca4f0ae-b3e7-5299-822a-1d5de9fb8948" name="Flesh Tearers" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="fcee021a-7b9d-5787-8a29-a04b02fe04f8" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="0603fef2-faa3-5d05-85b3-5f9472e8c309" name="Chapter: Flesh Tearers" hidden="false">
                  <description>• Rip and Tear: All Melee attacks gain Rending (or 4+ Rending if already Rending).
• Eager Warmongers: Reroll failed Charges.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="7fb4b6d9-1dba-5bab-909a-f4e0bdbb58be" name="Imperial Fists" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="e9c7dbcf-5486-5eef-9d17-1f5d5fc5216f" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="48257860-5f72-5fa2-87d7-69321523762f" name="Chapter: Imperial Fists" hidden="false">
                  <description>• Imperial Fist Bolter Drill: Always count as stationary for Bolter Discipline.
• Shore up the Defenses: Buildings embarked by Imperial Fists gain T+1.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="eef87efa-204e-53b1-af08-0e36ed7c8602" name="Iron Hands" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="c43557f7-268e-5ba2-9dfd-1797b5a7d2ab" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="d1ef1f2b-a7e4-5f18-8794-a998da6580e2" name="Chapter: Iron Hands" hidden="false">
                  <description>• Deadly Efficiency: May treat Devastator Squads and Dreadnoughts as Troop Slots.
• Heavy Fire Doctrines: Snapshot (including Overwatch) on 5+ with Heavy weapons.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="f40456f0-a846-5e8d-8738-86f6840204fb" name="Raven Guard" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="60e98884-872a-5763-95c0-8204aa7ac9bd" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="ccc5dae8-13ba-512c-a0ba-009e657ffa0b" name="Chapter: Raven Guard" hidden="false">
                  <description>• Strike from the Shadows: All models gain Stealth (or Shroud if they already have Stealth).</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="cea4180f-e215-5d71-86a1-a45efd578ac8" name="Salamanders" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="f5a4c841-33eb-5f07-b243-96bf75c67cd7" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="6e4d1e29-09cf-500a-806e-396443016605" name="Chapter: Salamanders" hidden="false">
                  <description>• Protect Civilians: Only score VP based on Objectives requiring Objective Markers to be held.
• Protect What is Already Possessed: +1 VP per completed Objective for Objectives 11-36 once per Turn.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="becb5350-761e-5aea-a2a0-4690170f128b" name="Silver Templars" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="696be2cf-ae6f-592b-ae80-45f549bdb2f8" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="6263ca10-81a9-536b-b3b3-1c463962b881" name="Chapter: Silver Templars" hidden="false">
                  <description>• The Martial Bond: All Ranged and Melee Attacks gain the Gauss Rule.
• Ultima Founding: May only include models with the Stubborn rule.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="6ea5064a-2306-5273-a07b-a241b7160f86" name="Space Wolves" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="207d214d-c271-50a4-8a9c-de4833c8efe1" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="e7bdcd92-afb6-54cf-baad-78bdbc0f56d5" name="Chapter: Space Wolves" hidden="false">
                  <description>• Aggressive Nature: All models gain Furious Charge.
• Wolfen Fury: All models gain A+1 on the turn they Charge.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="d0395ab4-f17a-5adc-a3d8-4034b65b54aa" name="Tome Keepers" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="d7efc82e-9d25-52b2-9f6d-3440e06e5d89" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="104732b7-ae50-5b99-bf81-7e73cdf9a3bd" name="Chapter: Tome Keepers" hidden="false">
                  <description>• The Pursuit of Knowledge: All models gain Ld+4 when within 3" of an Objective.
• Knowledge Absolute: Gain 2 VP for Kingslayer instead of D3.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="824fbe9c-ab73-53f1-a48e-30380de605ab" name="Ultramarines" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="9e958d80-e0aa-5ae2-bd50-25521a4dd426" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="35606756-52c5-54d6-85d7-13c4743dc465" name="Chapter: Ultramarines" hidden="false">
                  <description>• Emperor's Finest: May reroll one Objective during your Command Phase, even if already rerolled.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="34f9a844-cf6b-5c2b-a546-c4ba512e15c8" name="White Consuls" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="921be4be-2983-52c3-a8ea-aa9666c42ae6" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="272038dd-ba79-5cae-9317-bd150005f721" name="Chapter: White Consuls" hidden="false">
                  <description>• Guardians of the Cadian Gate: All Infantry models gain Objective Secured and Stubborn when within 3" of an Objective Marker.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="62c40528-0d2b-521b-8ce4-81be3080e14c" name="White Scars" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="2e2743fe-a0c1-5c97-96a4-741e639c5901" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="366b4ba3-461a-5bbc-be17-ea80dfcd4664" name="Chapter: White Scars" hidden="false">
                  <description>• Speed Tactics: All models gain Hit and Run.
• Rapid Deployment: All models gain Scout.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="81f0d61f-f41b-5531-9b3f-d00c531e4fa6" name="Wolfspears" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="262ad683-db31-5e69-b8aa-671828e8d991" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="5524ba8c-c39c-5362-bdef-77a366377ba9" name="Chapter: Wolfspears" hidden="false">
                  <description>• Bleeding the Prey: Charges against targets at half or less starting Wounds automatically succeed if within 12".
• Ultima Founding: May only include models with the Stubborn rule.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
