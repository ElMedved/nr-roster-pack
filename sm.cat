      <rules>
        <rule id="ea44b130-6465-5c4e-a2c0-2d93b3f9239e" name="Canticle of Hate" hidden="false">
          <description>6” Aura, this model and target unit treat Rapid Fire # weapons as Assault # weapons.</description>
        </rule>
        <rule id="628b1d86-fddd-504e-b139-294ac3775454" name="Zealot" hidden="false">
          <description>This model may reroll all failed To Hit rolls on the Phase it Charged or was Charged.</description>
