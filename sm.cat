      <rules>
        <rule id="0de8d697-3924-54e9-9359-3710f7fcafec" name="Awaken the Machine" hidden="false">
          <description>6” Aura, target Vehicle unit gains BS-1 (Improves by 1).</description>
        </rule>
        <rule id="18fa1605-5fba-5d2a-b1b4-12877fd6fa89" name="Repair" hidden="false">
          <description>Repair 1 Wound on Target Vehicle. Roll a d6, on a 5+, restore a Weapon Disabled, Destroyed, Crew Stun, or Immobilize secondary result.</description>
        </rule>
        <rule id="b7378b29-c930-5394-97cb-f841d25f8ac1" name="Lobotomized" hidden="false">
          <description>5+ Feel No Pain</description>
        </rule>
      </rules>
