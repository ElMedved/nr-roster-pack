          <characteristics>
            <characteristic name="Description" typeId="83d81002-a330-5968-9552-22dcb2ed8516">1 Rhino</characteristic>
          </characteristics>
        </profile>
        <profile id="bcf21440-ba24-59d8-a44f-2c83525ed16f" name="2 Linked Plasma Guns" hidden="false" typeId="0b840343-a9ff-5f16-b0df-b617cac2c0fa" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="9c7850b8-81dd-53f9-80e1-1a39147745dd">24</characteristic>
            <characteristic name="S" typeId="1ec1daae-c783-53b1-87a9-2dc4176bdfea">7</characteristic>
            <characteristic name="AP" typeId="37819752-fbc6-5464-ad45-17490825eae1">2+</characteristic>
            <characteristic name="Rules" typeId="989bc79d-9e4b-528b-b966-eff3ce994cc7">Rapid Fire 1 x2, Gets Hot!, Turret, Primary</characteristic>
          </characteristics>
        </profile>
        <profile id="b05abddb-f823-5984-a73f-1014ba9ab04e" name="Orbital Strike" hidden="false" typeId="0b840343-a9ff-5f16-b0df-b617cac2c0fa" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="9c7850b8-81dd-53f9-80e1-1a39147745dd">12-240</characteristic>
            <characteristic name="S" typeId="1ec1daae-c783-53b1-87a9-2dc4176bdfea">D/10 /8</characteristic>
            <characteristic name="AP" typeId="37819752-fbc6-5464-ad45-17490825eae1">1+/1+ /1+</characteristic>
            <characteristic name="Rules" typeId="989bc79d-9e4b-528b-b966-eff3ce994cc7">Heavy 1, 15” Blast, Destroyer, Ordnance, Monsterbane, Indirect Fire, Ignores Cover, The Hour is Nigh, T Minus 5, One Use Only, Turret</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="91f18c85-e54e-589d-977b-cce73b7d9834" name="Repair Servo Skulls" hidden="false">
          <description>Repair 1 Wound on Target Vehicle within 12”. Roll a d6, on a 5+, restore a Weapon Disabled, Destroyed, Crew Stun, or Immobilize secondary result.</description>
        </rule>
        <rule id="669da4e6-471a-5eec-b3d8-5e09170ffa3b" name="Targeting Skulls" hidden="false">
          <description>12” Aura, this model and target Unit may Overwatch at full BS instead of the usual Snapshots. Templates still perform Snapshots for number of dice but use BS To Hit.</description>
        </rule>
        <rule id="9badc03a-661c-51f1-91f2-0065900654ee" name="Transport 6" hidden="false">
          <description>Access Sides and Rear.</description>
        </rule>
        <rule id="6e8376b8-a240-5ccf-80ed-e24aff8426cb" name="The Hour is Nigh" hidden="false">
          <description>When the weapon is fired, place a marker on field at a valid target. In your next Command Phase, the barrage strikes! Scatter like normal, following the 15” Blast radius rules.</description>
        </rule>
        <rule id="c791b384-63ed-5e17-91a9-3e0d86ddeef8" name="T Minus 5" hidden="false">
          <description>The weapon may not be fired Turn 1. The weapon cannot be destroyed or Disabled. If the weapon is marked on the field and the carrier is destroyed, the Orbital Strike still hits in your Command Phase.</description>
        </rule>
      </rules>
