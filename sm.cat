      <rules>
        <rule id="9649736f-ef5f-5f4d-907a-e37030b5f230" name="Canticle of Hate" hidden="false">
          <description>6” Aura, this model and target unit treat Rapid Fire # weapons as Assault # weapons.</description>
        </rule>
        <rule id="4cc0589c-d6ba-5a2f-903a-186fc4015632" name="Zealot" hidden="false">
          <description>This model may reroll all failed To Hit rolls on the Phase it Charged or was Charged.</description>
        </rule>
        <rule id="8d110e02-e736-5a77-8697-b520d129b878" name="Devastating Charge" hidden="false">
          <description>This model gains A+1 on the Phase it counts as Charging if equipped with Bike.</description>
        </rule>
      </rules>
