    <selectionEntry id="4c6845d7-7211-5ecd-9bb1-2dee0c803589" name="Captain" publicationId="f58a93f8-a275-5dc0-9c65-876b1de3b547" page="6" hidden="false" collective="false" import="true" type="unit">
      <profiles>
        <profile id="bbf94c58-344f-5069-8dad-9508efad48a3" name="Captain" hidden="false" typeId="c4d93c9f-bd1a-5ef8-8b78-4f198aad6964" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="1f4c78ac-1f27-5042-bfb7-0d00f8f695a2">6</characteristic>
            <characteristic name="WS" typeId="d94fa72c-3ead-5b35-ae0e-3fdce3a41cf7">2+</characteristic>
            <characteristic name="BS" typeId="887899fe-1bdf-5a72-a3e1-f87bdd96622a">2+</characteristic>
            <characteristic name="S" typeId="135fb285-c97f-57fb-b178-be4a154ff49f">4</characteristic>
            <characteristic name="T" typeId="755e50b9-0a88-5118-b150-4f991fea0b0b">4</characteristic>
            <characteristic name="W" typeId="ab6f48e2-16a0-59de-9511-89fbff6d4548">5</characteristic>
            <characteristic name="I" typeId="1bf29bae-0689-56f9-b0e3-2a022091b15b">4</characteristic>
            <characteristic name="A" typeId="51d23fe8-6dd4-5bba-b2a9-8ef0f0d132ba">4</characteristic>
            <characteristic name="Ld" typeId="494a7951-7cd9-524d-bf22-444838fed165">10</characteristic>
            <characteristic name="Sv" typeId="3516322a-033e-5517-b8bd-1c7dfa38d6de">3+</characteristic>
          </characteristics>
        </profile>
        <profile id="a6e50c25-ebca-5faf-9806-2a100274e55e" name="Iron Halo" hidden="false" typeId="ac5ce483-3b55-59be-afc5-de14cfb350f6" typeName="Wargear">
          <characteristics>
            <characteristic name="Description" typeId="1c2f4080-02ec-5486-826a-4d2299dd0bb1">4+ Invulnerability Save</characteristic>
          </characteristics>
        </profile>
        <profile id="d778aae3-5af4-5199-a82d-55fe839b68da" name="Unit Composition" hidden="false" typeId="35b65644-1892-5b82-90c0-20981913471e" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="83d81002-a330-5968-9552-22dcb2ed8516">1 Captain</characteristic>
          </characteristics>
        </profile>
        <profile id="0078a3d4-4b2d-5404-b493-b01fba51517c" name="Frag Grenades" hidden="false" typeId="0b840343-a9ff-5f16-b0df-b617cac2c0fa" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="9c7850b8-81dd-53f9-80e1-1a39147745dd">8</characteristic>
            <characteristic name="S" typeId="1ec1daae-c783-53b1-87a9-2dc4176bdfea">3</characteristic>
            <characteristic name="AP" typeId="37819752-fbc6-5464-ad45-17490825eae1">-</characteristic>
            <characteristic name="Rules" typeId="989bc79d-9e4b-528b-b966-eff3ce994cc7">Grenade 1, 3” Blast</characteristic>
          </characteristics>
        </profile>
        <profile id="7780a3ad-8c3d-5a8a-ad6a-fb1a837065fb" name="Orbital Strike" hidden="false" typeId="0b840343-a9ff-5f16-b0df-b617cac2c0fa" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="9c7850b8-81dd-53f9-80e1-1a39147745dd">12-240</characteristic>
            <characteristic name="S" typeId="1ec1daae-c783-53b1-87a9-2dc4176bdfea">D/10 /8</characteristic>
            <characteristic name="AP" typeId="37819752-fbc6-5464-ad45-17490825eae1">1+/1+ /1+</characteristic>
            <characteristic name="Rules" typeId="989bc79d-9e4b-528b-b966-eff3ce994cc7">Heavy 1, 15” Blast, Destroyer, Ordnance, Monsterbane, Indirect Fire, Ignores Cover, The Hour is Nigh, T Minus 5, One Use Only</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="51ccafd2-4f8d-53c7-8374-4fae24ccced6" name="Battle Drills" hidden="false">
          <description>6” Aura, this model and target unit may Reroll 1s To Hit.</description>
        </rule>
        <rule id="d04ee5bd-47a9-539c-89a7-100422888a9d" name="The Hour is Nigh" hidden="false">
          <description>When the weapon is fired, place a marker on field at a valid target. In your next Command Phase, the barrage strikes! Scatter like normal, following the 15” Blast radius rules.</description>
        </rule>
        <rule id="e196e3cf-e11d-5508-883d-a37bf7fb7dc3" name="T Minus 5" hidden="false">
          <description>The weapon may not be fired Turn 1. If the weapon is marked on the field and the carrier is destroyed, the Orbital Strike still hits in your Command Phase.</description>
        </rule>
      </rules>
