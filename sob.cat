  <sharedSelectionEntries>
    <selectionEntry id="62eea17e-4b00-5acc-92cf-a9e93df371d5" name="Order &amp; Army Rules" publicationId="27117573-7101-550c-ba67-38bd23e2cda9" page="2" hidden="false" collective="false" import="true" type="upgrade">
      <constraints>
        <constraint id="54ee4872-4a8b-52a5-b181-94567e0f9489" field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="min"/>
        <constraint id="3ba58794-ad60-5b99-9d43-40c191c34eea" field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max"/>
      </constraints>
      <rules>
        <rule id="b0c17d30-9637-5164-92c8-d8039df9239c" name="Faith #" hidden="false">
          <description>A unit with Faith # may reroll # dice per phase (Saves, Feel No Pains, To Hit, To Wound/Penetrate, Ld Tests).</description>
        </rule>
        <rule id="0d68386c-2101-5081-8f19-2260024ceb35" name="Martyrdom #" hidden="false">
          <description>If slain, a friendly unit within 6" gains # Martyrdom Tokens (one-use Faith dice).</description>
        </rule>
        <rule id="b57cf9bf-7078-593c-af30-a65fee0ec672" name="Prayer to the Emperor" hidden="false">
          <description>If your Warlord has this rule, you may choose to lose the Initiative Roll to grant all Infantry models a 5+ Invulnerability Save for the battle.</description>
        </rule>
        <rule id="b30d5d45-3d58-55bf-a441-03a819bfcba0" name="Condemnor" hidden="false">
          <description>Gains Sniper (3+) against Psychic Mastery Level # models.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup id="b379377d-3539-5121-80a8-5124a4e284f9" name="Select Order" hidden="false" collective="false" import="true" defaultSelectionEntryId="20bb355c-a389-532b-8a63-da73a315377c">
          <constraints>
            <constraint id="ec2f0978-6f38-5bf1-a1db-ce6631d11330" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="min"/>
            <constraint id="2b20155c-c801-5c7a-b700-0fb31e65586b" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
          </constraints>
          <selectionEntries>
            <selectionEntry id="20bb355c-a389-532b-8a63-da73a315377c" name="Temple Order" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="2840832d-83f1-55e8-85da-51a8d50b8ccf" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="17a7bca7-d371-5d43-9800-a2ab334a7b6f" name="Order: Temple Order" hidden="false">
                  <description>Your army uses the datasheets exactly as presented in this Codex.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="6a4b28e7-f30f-514a-8c42-b1d7d9faf6e1" name="Order of our Martyred Lady" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="a1060c68-0bac-503d-9b87-354ee9cb817b" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="9aa92227-f413-5416-be0b-11d8673fe9e5" name="Order: Order of our Martyred Lady" hidden="false">
                  <description>• Honour the Martyrs: Characters and Independent Characters grant Martyrdom x2.
• Vengeful Strategies: Must Declare Charges if able and cannot Advance/shoot to prevent charging.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="99cc518a-1e34-5433-9a16-00c733d2e0a7" name="Order of the Argent Shroud" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="3c5b40f6-5a9c-5f04-83c1-69dd4efbab49" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="d0f9253e-09fc-5f36-9ce3-487b2b63757c" name="Order: Order of the Argent Shroud" hidden="false">
                  <description>• Faith is Our Shield: Characters/ICs reroll 1s for Saves in a Challenge.
• Selfless Heroism: Characters/ICs MUST issue or accept Challenges whenever possible.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="b7bc0e7c-02b8-54f9-9bbf-59a954c7749a" name="Order of the Bloody Rose" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="d9456d87-57ba-57eb-a26c-047cf7ab79d7" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="66317527-02de-53ea-be53-1e92b7321655" name="Order: Order of the Bloody Rose" hidden="false">
                  <description>• Tear Them Down: All models gain Shock Assault.
• Rigid Dogma: Cannot Claim or Contest Objective Markers in enemy Deployment Zones.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="3467c5de-9a3d-5b1e-bc5d-6b08cdc7726e" name="Order of the Ebon Chalice" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="babdfece-af45-541f-94be-b1da8370f95c" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="031ea499-18bb-5dbf-8eb5-37ad44ca9e8a" name="Order: Order of the Ebon Chalice" hidden="false">
                  <description>• Daughters of the Emperor: Models with Faith # gain Faith #+1.
• Vengeful Strategies: Must Declare Charges if able.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="63b9c407-a619-58d9-8f4c-5cc770388430" name="Order of the Sacred Rose" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="4a6e074d-32c5-5a93-a3e3-97cc3a45c72c" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="00ff2606-c484-5bd6-8e2d-fbd7821a149b" name="Order: Order of the Sacred Rose" hidden="false">
                  <description>• Devout Serenity: All models gain Stubborn (or Ld+1 if already Stubborn).
• Rigid Dogma: Cannot Claim or Contest Objective Markers in enemy Deployment Zones.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="1382d094-defe-51ee-9814-627a2e358833" name="Order of the Valorous Heart" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="24e9fd46-92b0-5be3-a3b8-477fa09f677a" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="1d6c7ba9-ddd8-5965-8440-3cbd3d1aeba9" name="Order: Order of the Valorous Heart" hidden="false">
                  <description>• Blind Faith: Models perform Overwatch on 5+ instead of 6+ (or 4+ if already 5+).
• Rigid Dogma: Cannot Claim or Contest Objective Markers in enemy Deployment Zones.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="2de87b7b-32b5-5d05-bd4d-f414650dd46e" name="Order Pronatus" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
