  <sharedSelectionEntries>
    <selectionEntry id="a1942715-e360-5c78-9819-76ef5d5bcf91" name="League &amp; Army Rules" publicationId="734e6fb2-2730-5f26-97e2-9ec65337b147" page="2" hidden="false" collective="false" import="true" type="upgrade">
      <constraints>
        <constraint id="7716eaae-178c-554d-80b7-5964fd137d40" field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="min"/>
        <constraint id="c2b768fa-9ccf-5d79-a9d4-61d357b4a993" field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max"/>
      </constraints>
      <rules>
        <rule id="ec3ebfaf-d084-586c-9757-a586fa340cb6" name="Dishonour" hidden="false">
          <description>Rolling double 6s for a Ld test inflicts -1 To Hit for the rest of the game.</description>
        </rule>
        <rule id="be405ebd-557f-54af-afbb-bc9087be5c5f" name="Judgement" hidden="false">
          <description>24" Range, One Use Only: Place a Judgement Token on target unit; friendly units reroll 1s To Wound against it, must Charge it if legal, and are Fearless in tests involving it.</description>
        </rule>
        <rule id="250c6926-3e5c-555e-b42f-94f12c6452d1" name="Steady Advance" hidden="false">
          <description>This unit Advances 3" instead of d6.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup id="a17f9763-675f-5f3e-992a-587349010fbf" name="Select League" hidden="false" collective="false" import="true" defaultSelectionEntryId="2069cabf-d6ee-5cda-8b15-1858bb0566e7">
          <constraints>
            <constraint id="12543bb5-1b97-5e06-9572-3449f9309cad" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="min"/>
            <constraint id="ae8f2534-11aa-5f6c-baa8-356418c2c5a5" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
          </constraints>
          <selectionEntries>
            <selectionEntry id="2069cabf-d6ee-5cda-8b15-1858bb0566e7" name="Average League" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="3bc2a0d3-0351-588f-8602-ecfadb74c73d" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="4abd60e1-e14d-565b-b04e-60016df315f9" name="League: Average League" hidden="false">
                  <description>This League uses the Codex exactly as it is presented.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="56c98d2b-83d8-5ba7-bbaa-368fcb4a6be6" name="Greater Thurian" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="57fe62c1-d477-54df-b8cb-d15f15f8b850" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="91cce6d2-3158-5c75-9b7c-b134d8bd0e8f" name="League: Greater Thurian" hidden="false">
                  <description>• Military Pride: Failing a Ld test inflicts Auto Wounds equal to the margin of failure.
• Ruthless Efficiency: All Infantry models gain Objective Secured.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="cf222654-0dd2-5d69-a0d3-febe69c9db2f" name="Ironheads" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="3ed5abd5-1a7e-5dfb-8a7d-8ef356923811" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="b9eb7c97-0e10-5eb6-9080-2c89df88de80" name="League: Ironheads" hidden="false">
                  <description>• Prospectors: Infantry models count as double for Contesting Objectives.
• Salvagers: Only one Objective Marker may be in your Deployment Zone (enemies cannot place any there).</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="7b656e1c-d6fd-5728-bc5a-fad518aecafc" name="Tran-Hyperian Alliance" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="464684af-8006-5205-9d40-a9c96cd4738f" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="37b7a4dc-c06c-5d6d-8335-ccc976cd9991" name="League: Tran-Hyperian Alliance" hidden="false">
                  <description>• Nomad Strategists: Redeploy 1 unit per 1000 points after Deployment.
• Roaming Nomads: Models count as half for Contesting Objective Markers.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="84ea809d-2354-5a48-a2ca-65ad807a7ed5" name="Kronus Hegemony" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="0d155e13-17ff-5b52-8bb4-a71ce3a891ad" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="1ce410e4-e201-539f-a4c1-7cc6afd5a4cd" name="League: Kronus Hegemony" hidden="false">
                  <description>• Aggressive Tactics: All models gain Furious Charge.
• Ill Tempered: Must declare a Charge if legal.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="869cf8bc-5d32-5558-95e0-f0b4e624b640" name="Ymyr Conglomerate" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="3afea714-fca1-5633-bd64-0e58b2008607" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="d5ce4534-a7f6-56a7-bb8c-2be9b00b669c" name="League: Ymyr Conglomerate" hidden="false">
                  <description>• Master Armourers: Reroll 1s for Armour Saves.
• Wealth Hoarders: Cannot claim or contest Objective Markers in the enemy Deployment Zone.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="439387ef-53f9-567c-9522-6f41cb03221c" name="Urani-Surtr Regulates" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="17582ecd-f192-5445-be66-b4965d05cc13" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="fe3440e1-8c20-582e-9453-8864513dcda5" name="League: Urani-Surtr Regulates" hidden="false">
                  <description>• Dour Survivalists: Gain Ld+1 and reroll failed Ld tests.
• Grim Pragmatism: Infantry may only Claim or Contest Objective Markers outside your Deployment Zone.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
    </selectionEntry>
    <selectionEntry id="c7842012-1a2e-5709-b1cb-12b51721359d" name="Kahl" publicationId="734e6fb2-2730-5f26-97e2-9ec65337b147" page="3" hidden="false" collective="false" import="true" type="unit">
      <profiles>
        <profile id="f73b1d7b-2ca1-55ad-b35f-dffbae09f9ea" name="Kahl" hidden="false" typeId="c4d93c9f-bd1a-5ef8-8b78-4f198aad6964" typeName="Unit">
