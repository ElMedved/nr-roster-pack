      <rules>
        <rule id="a75bec90-45e6-5f57-a6ae-57d740356f34" name="Legend of the League" hidden="false">
          <description>This model has a 5+ Invulnerability Save. Lone Emberg-Aegnir Bloc</description>
        </rule>
        <rule id="241e178f-9f5a-545d-a6e1-7173d5b02cfd" name="Survivor" hidden="false">
          <description>This model may not Claim or Contest Objective Markers.</description>
        </rule>
        <rule id="3eb89a66-3f98-5bc6-916c-af7ecf9bc0a0" name="Oath of Vengeance" hidden="false">
          <description>This model may reroll all To Hit and To Wound rolls against Monsters.</description>
        </rule>
        <rule id="909a68de-5bfb-5665-bddf-eb4f42b52d5c" name="Thrice Devoured" hidden="false">
          <description>Any enemy model with a Gulp ability within range of this model MUST do so. If this model is ever Gulped, it inflicts 1d3 Mortal Wounds and is immediately released.</description>
        </rule>
      </rules>
