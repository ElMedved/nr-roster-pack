            <characteristic name="BS" typeId="887899fe-1bdf-5a72-a3e1-f87bdd96622a">3+</characteristic>
            <characteristic name="S" typeId="135fb285-c97f-57fb-b178-be4a154ff49f">4</characteristic>
            <characteristic name="T" typeId="755e50b9-0a88-5118-b150-4f991fea0b0b">4</characteristic>
            <characteristic name="W" typeId="ab6f48e2-16a0-59de-9511-89fbff6d4548">5</characteristic>
            <characteristic name="I" typeId="1bf29bae-0689-56f9-b0e3-2a022091b15b">2</characteristic>
