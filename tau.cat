            <selectionEntry id="49ecca76-b4a6-5502-a9e6-c25f9dc41086" name="Bork'an" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="c1ca2a64-b904-5eb2-b909-0b4b5082f4fc" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="e05e62ac-1d75-5cf5-8811-ca6c04eda346" name="Sept: Bork'an" hidden="false">
                  <description>• Cautious Tactics: Units cannot willingly move within 12" of an enemy model.
• Premium Wargear: Reroll 1s for Armour Saves.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="92b6d25f-da60-50eb-8edb-be88bccfe06e" name="Dal'yth" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="651bbcd4-5ce2-53b1-acf1-a8e42bb6c170" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="bcca827d-54b1-51cd-8789-c72cf7492207" name="Sept: Dal'yth" hidden="false">
                  <description>Diplomatic Ties: Models with Ethereal rule gain +12" on Aura ranges and Revered Figure (lost on 1-2).</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="2c4a845b-781b-5793-a716-c6c1f13641a8" name="Farsight Enclaves" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="3dc62565-4aff-58e5-8976-3534061128f6" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="59296994-bd47-5ca0-a917-d1507e6ed22d" name="Sept: Farsight Enclaves" hidden="false">
                  <description>• Colonists: Infantry models count as 2 models for Contesting Objectives.
• Separatists: No Ethereal models allowed; all models suffer Ld-1. Unlocks Farsight Enclaves units.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="c272e79a-9861-5757-94dd-43799e93a57d" name="Ke'lshan" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="41f5441d-939d-588a-9d54-f5f9ca3c0e10" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="8418273b-0ab0-539f-9d6d-5f3be4ec28f6" name="Sept: Ke'lshan" hidden="false">
                  <description>Distrustful: Rapid Fire # weapons gain x2 attacks at long range and x1 at half range; Volley Fire allows x2 shots within half range. Unlocks Ke'lshan units.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="a64d4808-ee41-5878-a341-d41d38459e34" name="Sa'Cea" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="4e496fc0-25db-5b89-9814-d30ca31cac6f" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="661973b7-3601-5c9a-b92c-b7a1c1f5ec8e" name="Sept: Sa'Cea" hidden="false">
                  <description>• Unfamiliar Terrain: Only gain Cover Saves from Buildings, Fortifications, Going to Ground, or Pinning.
• Urban Specialists: Reroll 1s for Cover Saves from Buildings/Fortifications.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="1d750afd-02a6-5c72-acc7-a894badb824b" name="Vior'la" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="ed2a8cd0-ac0e-58e9-9bef-a7bd3ded9864" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="f3c802f8-30fb-574c-9302-2cb05c305d19" name="Sept: Vior'la" hidden="false">
                  <description>• Aggressive Tactics: All models gain Scout (or Infiltrate if already Scout).
• Aggression: Units not within 12" of an Ethereal must pass a Command Phase Ld test or move/charge toward closest enemy.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
