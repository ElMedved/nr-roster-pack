  <sharedSelectionEntries>
    <selectionEntry id="bc6a6510-9355-53c4-a399-cb1175756394" name="Sept &amp; Army Rules" publicationId="adc5d0a8-d584-544a-b4d5-19a9bc84f55a" page="2" hidden="false" collective="false" import="true" type="upgrade">
      <constraints>
        <constraint id="00bb609c-3666-5a81-986f-1a734ada4287" field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="min"/>
        <constraint id="f6b74a8e-b37a-5c1a-b0eb-bcfd667c3209" field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max"/>
      </constraints>
      <rules>
        <rule id="e6aa11b7-de38-5034-9ab9-6c927c9f588c" name="Marker Light" hidden="false">
          <description>Each Marker Light hit places a token. Spend tokens before shooting for: Targeting Matrix (+1 To Hit / -1 Scatter), Multi-Spectrum Scan (-1 enemy Cover Save), or Missile Strike (fire a friendly Seeker Missile).</description>
        </rule>
        <rule id="c3ce0df0-8a91-52a4-a43c-fe791921c4c7" name="Savior Protocols" hidden="false">
          <description>After failed Saves/FNP on a unit, a Drone in the unit may roll d6; on 4+ the Drone takes 1 Mortal Wound and cancels the attack.</description>
        </rule>
        <rule id="0dfd8f62-299a-5346-87a8-0d93dae83cf3" name="Primitive AI" hidden="false">
          <description>Drones cannot Claim/Contest Objectives and may join/leave units freely in the Movement Phase.</description>
        </rule>
        <rule id="eb217d29-c241-5fc7-a9cd-ff15e115c4ae" name="Revered Figure" hidden="false">
          <description>If slain, all Tau models within 24" roll d6: on 1 removed from play, on 6 unit gains Stubborn.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup id="4216a0c4-660a-5aca-b3ae-0d4b627544d9" name="Select Sept" hidden="false" collective="false" import="true" defaultSelectionEntryId="93e20ec1-ff48-5983-a0e9-c30a75d1281f">
          <constraints>
            <constraint id="6dc328d5-69b8-5b46-b934-b9860463ac4d" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="min"/>
