      <rules>
        <rule id="3b35b7d3-4e7a-55a1-b817-829930c17c98" name="Aura of Discipline" hidden="false">
          <description>6” Aura, unit may use Commissar’s Ld and gains Stubborn</description>
        </rule>
        <rule id="5094ad66-2c29-58a5-a67b-0c185a946434" name="Encouragement" hidden="false">
          <description>6” Aura, this model and target unit count as double the model count for Contesting Objectives. If they already counted as double, they gain Objective Secured instead.</description>
        </rule>
      </rules>
