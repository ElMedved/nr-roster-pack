        <rule id="2585ab37-8758-51dd-862a-8e0af95e78df" name="Earth Caste Pilot" hidden="false">
          <description>This model is immune to Mortal Wounds from the Nova Reactor and may reroll 1s and Scatter Dice To Hit.</description>
        </rule>
        <rule id="c07ae0ad-5d6e-5cbe-aec5-763169320330" name="Nova Reactor" hidden="false">
          <description>This model may suffer 1 Mortal Wound to treat a Disabled Weapon as not Disabled for the current Phase. It may do this as many times at it wants to per Phase.</description>
        </rule>
      </rules>
