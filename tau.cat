      <rules>
        <rule id="c1973a8b-4654-5c9d-88ab-7fddb6317e50" name="Deployable Turret" hidden="false">
          <description>This model is not placed on the tabletop during Deployment. It instead is placed during one of your Movement Phases. Once it is placed, it is its own unit until the end of the game. If the unit is destroyed before this model is Deployed it is destroyed.</description>
        </rule>
      </rules>
