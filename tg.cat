      <rules>
        <rule id="c4915aa8-0049-5bcc-9bf3-a4cf34510ef0" name="Limited Ordnance" hidden="false">
          <description>6” Aura, this model and target unit may reroll scatter dice for Ranged weapons. For each Template that fails to hit any enemy models, that unit suffers 1 Mortal Wound.</description>
        </rule>
