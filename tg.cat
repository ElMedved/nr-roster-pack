            <characteristic name="BS" typeId="9668fefb-fa68-5d6a-8889-1c276f51eb2f">4+</characteristic>
            <characteristic name="S" typeId="ce68c1a5-e41a-58df-8f92-7dd4330d1c37">6</characteristic>
            <characteristic name="FA" typeId="d2924870-473f-5655-b0cb-140eca07e261">12</characteristic>
            <characteristic name="SA" typeId="08d9ada2-c8a3-522f-9533-102b116894fb">10</characteristic>
            <characteristic name="RA" typeId="b4ddabf1-d0b7-55f8-9548-dafa9477db70">10</characteristic>
            <characteristic name="W" typeId="40dfbefa-11ba-5864-aa77-c3701d34379d">11</characteristic>
