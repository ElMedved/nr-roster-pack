      <rules>
        <rule id="78de5e32-5e13-549e-9c4c-2a510eee9ba6" name="Protesting Machine Spirit" hidden="false">
          <description>6” Aura, target friendly Vehicle suffers 1 Mortal Wound but ignores one Weapon Disabled, Crew Stun, Immobilize, or Weapon Destroyed result.</description>
        </rule>
