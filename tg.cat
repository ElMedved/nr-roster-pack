      <rules>
        <rule id="20c7d7b2-2540-5675-96d4-7bd927ede89e" name="Paranoid" hidden="false">
          <description>Each time this model or its unit fails a Ld test, remove one friendly model in this model’s unit from the game. If a series of tests are taken and only one is required to fail you must still complete each test to determine friendly models slain by Paranoid.</description>
        </rule>
      </rules>
