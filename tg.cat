        <profile id="f25170b5-518b-570b-af2b-be32a9d74845" name="Cyclops" hidden="false" typeId="c4d93c9f-bd1a-5ef8-8b78-4f198aad6964" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="1f4c78ac-1f27-5042-bfb7-0d00f8f695a2">12</characteristic>
