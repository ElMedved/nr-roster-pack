      <rules>
        <rule id="c177c85b-ce26-536b-a6da-a6cfe6d475a3" name="Inspiring the Rabble" hidden="false">
          <description>6” Aura, remove one target Infantry model from target friendly unit with Insanity from the game. The unit may ignore Insanity until your next Command Phase.</description>
        </rule>
      </rules>
