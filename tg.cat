      <rules>
        <rule id="191e5695-40f8-51e7-b22d-e3eb5e47ddcc" name="Grunt Herder" hidden="false">
          <description>6” Aura, remove one Infantry model from the game from a target friendly unit. That unit may declare Charges in the same turn it Advances.</description>
