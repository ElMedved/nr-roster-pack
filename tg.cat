        <rule id="f6496b8f-d6de-5492-8518-9372de011c55" name="The Hour is Nigh" hidden="false">
          <description>When the weapon is fired, place a marker on field at a valid target. In your next Command Phase, the missile strikes! Scatter like normal, following the 15” Blast radius rules.</description>
        </rule>
        <rule id="f5bed6d2-9625-5c4b-93a8-e0fab99d3803" name="T Minus 5" hidden="false">
          <description>The weapon may not be fired Turn 1.</description>
        </rule>
