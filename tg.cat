  <sharedSelectionEntries>
    <selectionEntry id="097009e5-6e5d-503c-9790-75a0505c109b" name="Warband &amp; Army Rules" publicationId="3170db88-3002-58d8-bb1f-25a3edfd2ba2" page="2" hidden="false" collective="false" import="true" type="upgrade">
      <constraints>
        <constraint id="322b6f28-e1bf-58aa-a772-cac982dc86fd" field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="min"/>
        <constraint id="73b4489c-ff71-5c5f-a6bb-a91d938e9fdb" field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max"/>
      </constraints>
      <rules>
        <rule id="9a17cac9-1c86-5779-b5ec-f46db311f58c" name="Insanity" hidden="false">
          <description>Failing a Ld test causes the unit to never Flee/Go to Ground; instead it must move/advance/shoot/charge toward the closest enemy model and suffers -1 To Hit for the rest of the game.</description>
        </rule>
        <rule id="00d44307-ff6c-5d96-b308-13b4e4ad4275" name="Poor Maintenance" hidden="false">
          <description>Roll d6 in Command Phase; on a 1, unit must choose to either Move OR Shoot this turn.</description>
        </rule>
        <rule id="e5506f18-caed-5239-a016-3ab01132d4f7" name="Limited Ammo" hidden="false">
          <description>This model may not make Overwatch attacks or Snap Shots.</description>
        </rule>
        <rule id="3b10bd4f-cbb6-5ce4-9821-5904a4f3ee31" name="Grinding Advance" hidden="false">
          <description>Counts as stationary when firing Ordnance weapons.</description>
        </rule>
        <rule id="8e0930cd-6ad1-5616-a1d4-edafea0f0300" name="Marks of Chaos" hidden="false">
          <description>Khorne (A+1, Furious Charge), Nurgle (5+ FNP), Slaanesh (I+1, Counterattack), Tzeentch (5+ Invuln or +1 Invuln to 4+), Undivided (1 unit may take a Pure Blessing).</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup id="06f0b423-b7f3-5565-8b07-21cbab414bd0" name="Select Warband" hidden="false" collective="false" import="true" defaultSelectionEntryId="9ee6a2cd-8f3c-5357-98da-3c6deb76fb13">
          <constraints>
            <constraint id="74349763-bb40-5752-b280-b4ff9410add5" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="min"/>
            <constraint id="127be33d-ea51-5449-93b5-59a8feff41b3" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
          </constraints>
          <selectionEntries>
            <selectionEntry id="9ee6a2cd-8f3c-5357-98da-3c6deb76fb13" name="Traitor PDF" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="3980eae7-9022-5dec-baf0-5659b54f4b03" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="1e804fc2-ff29-5b40-9342-21f04917a86a" name="Warband: Traitor PDF" hidden="false">
                  <description>This army plays exactly as it is presented in the Codex.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="81b5b9b7-8a44-5e0c-99d5-c8842d266d75" name="Blood Pact" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="2c7a7594-51e2-5cfb-9a99-649dec0d158b" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="556d152d-5951-58ec-a159-02e19c9852a0" name="Warband: Blood Pact" hidden="false">
                  <description>• Disciplined: All models gain Ld+1.
• Followers of Khorne: All models must have the Mark of Khorne.
• Renegades: All models count as half a model for Contesting Objectives.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="df59518c-0467-5518-8c48-315046183472" name="Moebian 6th" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="94063e0d-5c07-59af-988d-03ec72f268b8" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="21006925-bc03-5f92-91e1-a03d5011db82" name="Warband: Moebian 6th" hidden="false">
                  <description>• Followers of Nurgle: All models must have the Mark of Nurgle.
• Heavily Tainted: All Infantry models from Traitor Guard gain T+1, but suffer M-1.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="56e165fb-62c1-5847-9ffb-fd1df8a781a4" name="Vraksian Renegade Militia" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="3b1a8841-29b8-5dd2-9cc9-4c334fe460f4" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="1e6bb1ba-f325-558e-8a76-e4986ad3b3b5" name="Warband: Vraksian Renegade Militia" hidden="false">
                  <description>• Calculated Defenses: Cannot Claim or Contest Objectives in enemy Deployment Zone.
• Dug In: All models gain Stealth and Infantry gain Objective Secured while in your Deployment Zone.
• Followers of Undivided: Warlord must have Mark of Undivided.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
    </selectionEntry>
    <selectionEntry id="50310ca0-ba0c-53bd-8c3f-c79d5f9c8f68" name="Company Command Squad" publicationId="3170db88-3002-58d8-bb1f-25a3edfd2ba2" page="5" hidden="false" collective="false" import="true" type="unit">
      <profiles>
        <profile id="d2544c18-4b36-5ebd-a132-669ca5d442d1" name="Company Commander" hidden="false" typeId="c4d93c9f-bd1a-5ef8-8b78-4f198aad6964" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="1f4c78ac-1f27-5042-bfb7-0d00f8f695a2">6</characteristic>
            <characteristic name="WS" typeId="d94fa72c-3ead-5b35-ae0e-3fdce3a41cf7">3+</characteristic>
            <characteristic name="BS" typeId="887899fe-1bdf-5a72-a3e1-f87bdd96622a">3+</characteristic>
