            <characteristic name="T" typeId="755e50b9-0a88-5118-b150-4f991fea0b0b">3</characteristic>
            <characteristic name="W" typeId="ab6f48e2-16a0-59de-9511-89fbff6d4548">2</characteristic>
            <characteristic name="I" typeId="1bf29bae-0689-56f9-b0e3-2a022091b15b">-</characteristic>
            <characteristic name="A" typeId="51d23fe8-6dd4-5bba-b2a9-8ef0f0d132ba">-</characteristic>
            <characteristic name="Ld" typeId="494a7951-7cd9-524d-bf22-444838fed165">-</characteristic>
            <characteristic name="Sv" typeId="3516322a-033e-5517-b8bd-1c7dfa38d6de">4+</characteristic>
          </characteristics>
        </profile>
        <profile id="2f831c72-8b15-50dd-8363-570c89335933" name="Remote Control" hidden="false" typeId="ac5ce483-3b55-59be-afc5-de14cfb350f6" typeName="Wargear">
          <characteristics>
            <characteristic name="Description" typeId="1c2f4080-02ec-5486-826a-4d2299dd0bb1">Allows Cyclops to be Detonated on command or to be moved. If no Remote Controls remain on the field, all Cyclops may not move or Detonate unless it is the 4+ to explode. Cyclops models are allowed to be targeted by Friendly Fire.</characteristic>
          </characteristics>
        </profile>
        <profile id="b951e67f-65b5-52a8-97e9-92438d0fa666" name="Unit Composition" hidden="false" typeId="35b65644-1892-5b82-90c0-20981913471e" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="83d81002-a330-5968-9552-22dcb2ed8516">1-3 Traitors 0-9 Cyclops</characteristic>
          </characteristics>
        </profile>
        <profile id="05d2ddcc-56ec-5d92-b728-274d751e1930" name="Frag Grenades" hidden="false" typeId="0b840343-a9ff-5f16-b0df-b617cac2c0fa" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="9c7850b8-81dd-53f9-80e1-1a39147745dd">8</characteristic>
            <characteristic name="S" typeId="1ec1daae-c783-53b1-87a9-2dc4176bdfea">3</characteristic>
            <characteristic name="AP" typeId="37819752-fbc6-5464-ad45-17490825eae1">-</characteristic>
            <characteristic name="Rules" typeId="989bc79d-9e4b-528b-b966-eff3ce994cc7">Grenade 1, 3” Blast</characteristic>
          </characteristics>
        </profile>
        <profile id="d2ae3859-b6ef-5077-9cb5-c69e649384b5" name="Cyclops Demolition Charge" hidden="false" typeId="0b840343-a9ff-5f16-b0df-b617cac2c0fa" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="9c7850b8-81dd-53f9-80e1-1a39147745dd">-</characteristic>
            <characteristic name="S" typeId="1ec1daae-c783-53b1-87a9-2dc4176bdfea">10</characteristic>
            <characteristic name="AP" typeId="37819752-fbc6-5464-ad45-17490825eae1">1+</characteristic>
            <characteristic name="Rules" typeId="989bc79d-9e4b-528b-b966-eff3ce994cc7">Heavy 1, 5” Blast, Ordnance, Monsterbane, One User Only, Deadly Payload</characteristic>
          </characteristics>
        </profile>
        <profile id="3eaba1b3-b119-5a5e-b7aa-63bb921626de" name="Autogun" hidden="false" typeId="0b840343-a9ff-5f16-b0df-b617cac2c0fa" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="9c7850b8-81dd-53f9-80e1-1a39147745dd">24</characteristic>
            <characteristic name="S" typeId="1ec1daae-c783-53b1-87a9-2dc4176bdfea">3</characteristic>
            <characteristic name="AP" typeId="37819752-fbc6-5464-ad45-17490825eae1">-</characteristic>
            <characteristic name="Rules" typeId="989bc79d-9e4b-528b-b966-eff3ce994cc7">Rapid Fire 1</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="68dda7c3-9f9d-571e-8275-d631196ace15" name="Deadly Payload" hidden="false">
          <description>This model explodes if it ever comes into base contact with an enemy model or if the owner wishes it to explode so long as at least one Guardsman has a Remote Control. If the model is destroyed, on a 4+ the Cyclops Demolition Charge goes off. In any case the weapon is used, center the template over the model and do not scatter it. The Cyclops is removed afterwards.</description>
        </rule>
        <rule id="3f084fa4-f548-54a8-8a32-2d01091bda9b" name="Suicide Mission" hidden="false">
          <description>Each Cyclops is treated as an individual unit, but is deployed with the Guardsman as if they were one.</description>
        </rule>
      </rules>
