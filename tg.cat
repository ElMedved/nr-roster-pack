      <rules>
        <rule id="5dd1b631-0eb4-54c3-9e48-0d9b608ef74b" name="Enforced Artillery Tactics" hidden="false">
          <description>6” Aura, target friendly Tank suffers 3 Mortal Wounds and has its M# stat changed to M- for the remainder of the game. It no longer suffers from Insanity. Other Vehicles in the Squadron may Abandon this Vehicle as normal and split off a new unit.</description>
        </rule>
      </rules>
