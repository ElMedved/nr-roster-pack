            <characteristic name="A" typeId="488135b0-9b58-5406-adf9-2095b15a5b5b">3</characteristic>
            <characteristic name="Ld" typeId="605ce88b-1ada-590e-8bb0-a3c1e2779857">7</characteristic>
            <characteristic name="Sv" typeId="e57e3a75-3b6c-5bf0-911d-5a0c6340ede1">3+</characteristic>
          </characteristics>
        </profile>
        <profile id="0b420690-fe21-5680-8297-465bc3948a2b" name="Unit Composition" hidden="false" typeId="35b65644-1892-5b82-90c0-20981913471e" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="83d81002-a330-5968-9552-22dcb2ed8516">1-3 Deathstrike Missile Carriers</characteristic>
          </characteristics>
        </profile>
        <profile id="ff2a231a-a89b-567f-87cc-57bc3f44d06e" name="Deathstrike Missile" hidden="false" typeId="0b840343-a9ff-5f16-b0df-b617cac2c0fa" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="9c7850b8-81dd-53f9-80e1-1a39147745dd">12 to 240</characteristic>
            <characteristic name="S" typeId="1ec1daae-c783-53b1-87a9-2dc4176bdfea">D/10 /8</characteristic>
            <characteristic name="AP" typeId="37819752-fbc6-5464-ad45-17490825eae1">1+/1+ /1+</characteristic>
            <characteristic name="Rules" typeId="989bc79d-9e4b-528b-b966-eff3ce994cc7">Heavy 1, 15” Blast, Destroyer, Ordnance, Monsterbane, Indirect Fire, Ignores Cover, One Use Only, T Minus 5, The Hour is Nigh, Hull</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="1c74cc3e-e3f6-588d-a9f6-48299740d26e" name="The Hour is Nigh" hidden="false">
          <description>When the weapon is fired, place a marker on field at a valid target. In your next Command Phase, the missile strikes! Scatter like normal, following the 15” Blast radius rules.</description>
        </rule>
        <rule id="58ecde18-df20-589d-adea-78d000a1d75c" name="T Minus 5" hidden="false">
          <description>The weapon may not be fired Turn 1. The weapon cannot be destroyed or Disabled. If the weapon is marked on the field and the carrier is destroyed, the Deathstrike Missile still hits in your Command Phase.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="7c26ac21-6258-552b-856f-3be62284c8b9" name="Vehicle" hidden="false" targetId="05480053-e985-58e9-bdf3-e2beb318cd90" type="rule"/>
        <infoLink id="a6039923-0854-50b5-adff-68b5c77e94b1" name="Tank" hidden="false" targetId="4d1ae852-8157-53da-affb-b65a609adfee" type="rule"/>
