      <rules>
        <rule id="6a43b736-8bfa-5660-a1e0-7c9bbfef1d46" name="Termagaunt Gestation" hidden="false">
          <description>During your Command Phase, spawn 2d6 Termagaunts with the default options as a new unit within 6”. A roll of a double ends the use of this ability for this model for the game, but still summons the number rolled this turn.</description>
        </rule>
        <rule id="8c2a6585-7722-54c1-9266-f0e084c0aa0f" name="Synaptic Backlash" hidden="false">
          <description>When this model is slain, all Hormagaunts, Termagaunts, and Gargoyles within 12” take an Auto Hit S3 AP-. This is applied before the Dangerous Terrain Test from Synapse.</description>
        </rule>
        <rule id="276b3651-0984-52de-8504-b70bf2e3e136" name="Hive Node" hidden="false">
          <description>12” Aura, target unit may use the Hive Node’s Ld in place of their own.</description>
        </rule>
