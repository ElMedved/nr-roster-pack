          <characteristics>
            <characteristic name="Range" typeId="9c7850b8-81dd-53f9-80e1-1a39147745dd">Melee</characteristic>
            <characteristic name="S" typeId="1ec1daae-c783-53b1-87a9-2dc4176bdfea">User</characteristic>
            <characteristic name="AP" typeId="37819752-fbc6-5464-ad45-17490825eae1">-</characteristic>
            <characteristic name="Rules" typeId="989bc79d-9e4b-528b-b966-eff3ce994cc7">Poisoned (2+)</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="5143116a-1381-59fb-b434-409cffc6b2ab" name="Psychic Absorption" hidden="false">
          <description>Each time an enemy unit successfully Casts a Spell within 18”, this model Heals 1 Wound. This ability ignores the usual restriction of Healing 1 Wound per Turn.</description>
        </rule>
        <rule id="ff4a19f6-28c8-5673-80f4-6bdd5365e36a" name="Synaptic Backlash" hidden="false">
          <description>When this model is slain, each Tyranid model within 12” suffers a Mortal Wound on a 1-2 instead of just 1.</description>
        </rule>
        <rule id="488a6c55-960f-5ad3-82cf-05917d239fe4" name="Synaptic Relay" hidden="false">
          <description>Place a Token on a target friendly unit within 6”. It gains S+1 until the end of the game. In each of your Command Phases, roll a d6 for each model in the unit. For each 1 the unit suffers 1 Mortal Wound.</description>
        </rule>
        <rule id="e572e28a-6d99-5b79-8cd8-01739f563579" name="Earthshaker" hidden="false">
          <description>Units hit by this Spell Move, Advance, Charge, and Fall Back at half speed until your next Psychic Phase.</description>
        </rule>
      </rules>
