  <sharedSelectionEntries>
    <selectionEntry id="26e919e6-5bad-55c9-809d-62dfa2b3ff01" name="Hive Fleet &amp; Army Rules" publicationId="f71a2ee9-decb-531d-b9ee-967105ac2c24" page="2" hidden="false" collective="false" import="true" type="upgrade">
      <constraints>
        <constraint id="8c93ae7c-efcc-5384-9102-5172e1713074" field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="min"/>
        <constraint id="cd1bf08c-39a3-5faa-9430-cd99e8c2f5dd" field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max"/>
      </constraints>
      <rules>
        <rule id="d706038b-6e10-5b3c-936f-64116e681af7" name="Instinctive Behavior" hidden="false">
          <description>Failing a Ld test causes the unit to move, shoot, and charge toward the closest enemy model and suffer -1 To Hit for the rest of the game.</description>
        </rule>
        <rule id="06f50ebd-c2b4-568f-afb2-c9964bb06923" name="Synapse" hidden="false">
          <description>12" Aura: Target unit automatically recovers from Instinctive Behavior. If a Synapse unit is slain, Tyranid models within 12" take a Dangerous Terrain Test.</description>
        </rule>
        <rule id="5b40482e-4811-5ef0-a869-8acd71beb7e3" name="Shadow in the Warp" hidden="false">
          <description>18" Aura: Inflicts -3 To Cast penalty on one enemy Psychic Mastery unit.</description>
        </rule>
        <rule id="c6409ebf-3301-534d-9635-d284f5e788cd" name="Living Bombs" hidden="false">
          <description>Spore Mines move directly toward nearest enemy and detonate on contact; cannot claim objectives or award VP.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup id="2b64eba3-51c5-5987-9214-137aef547cd9" name="Select Hive Fleet" hidden="false" collective="false" import="true" defaultSelectionEntryId="9170f742-6541-59bf-8b01-78abcd599f32">
          <constraints>
            <constraint id="4a4d78b1-1b7f-5128-a5f2-8cae95542958" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="min"/>
            <constraint id="60b0d29a-5396-508d-8371-62a02f5bd935" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
          </constraints>
          <selectionEntries>
            <selectionEntry id="9170f742-6541-59bf-8b01-78abcd599f32" name="Average Hive Fleet" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="74a63f83-5cde-5c82-8e3c-4578bd493739" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="081fd5ec-8cda-5e18-866d-b31d194532e4" name="Hive Fleet: Average Hive Fleet" hidden="false">
                  <description>Uses the datasheets exactly as presented in the Tyranid Codex.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="b05e6448-a7a0-52a7-834d-1b44bdbb9d57" name="Hive Fleet Behemoth" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="1bd9f1b9-fe1b-5a5d-be52-789a2fb1006b" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="8e1b3909-568d-5bd9-9615-7cf23974d269" name="Hive Fleet: Hive Fleet Behemoth" hidden="false">
                  <description>• Unstoppable Hunger: All models gain Furious Charge and reroll failed Charge rolls.
• Brute Force: Models must declare Charges if able. Unlocks Behemoth units.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="0e522e3d-6b0d-5b1b-9187-c80c3b5a90d3" name="Hive Fleet Kraken" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="3065d7a2-a908-5a66-be9b-a9941f753511" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="525d1650-5022-5610-a229-045a36b81dc3" name="Hive Fleet: Hive Fleet Kraken" hidden="false">
                  <description>• Enemy Intelligence: All models gain Infiltrate.
• Built for Speed: All models suffer Sv+1 (worsens by 1).
• Reserved Tactics: Infantry count as half for Objectives. Unlocks Kraken units.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="1c630d7f-7131-5dd0-9600-425d5a560f3b" name="Hive Fleet Leviathan" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint id="871fb9db-6d2b-5cfb-9d0b-262765aad6ad" field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max"/>
              </constraints>
              <rules>
                <rule id="ad426310-cb0b-5feb-86d0-f8ed269d5946" name="Hive Fleet: Hive Fleet Leviathan" hidden="false">
                  <description>• Warp Blanket: Shadow in the Warp is -4 instead of -3 To Cast.
• Bio Plague: Monsters gain A+1 but suffer 1 Mortal Wound each Command Phase (no Heal allowed).
• Massive Biomass Loss: Infantry count as half for Objectives. Unlocks Leviathan units.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
    </selectionEntry>
