      <rules>
        <rule id="0b7d4a0e-639a-503d-b218-f044dae019b0" name="Brood Bombs" hidden="false">
          <description>upon death, this model explodes using its Meiotic Bomb profile. Before removing this model, spawn D3+1 Spore Mine models with default Wargear by Deepstriking them with the target area being this model. Instead of Direct Hits, use the tiny arrow to scatter in that direction equal to the 2d6”.</description>
        </rule>
      </rules>
