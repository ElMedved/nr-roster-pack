      <rules>
        <rule id="d50655c6-9a1f-5985-8378-5137c7f1d913" name="Tremor Sense" hidden="false">
          <description>This model does not collide with other models or Terrain when Deepstriking. It will move to 1” away from them as close to its Arrival Point.</description>
        </rule>
        <rule id="dd61daf9-cec0-545e-806a-5cf72d91b29d" name="Tunneler" hidden="false">
          <description>This model has a Transport Capacity of 30. All Embarked units must Disembark the same Movement Phase that this model arrives from Reserves.</description>
        </rule>
      </rules>
